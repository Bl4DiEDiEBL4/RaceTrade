@inherits LayoutComponentBase

@* Static by design. Anything interactive lives in its own component with its own
   render mode (see TraderStatus) - a layout does not get one. *@
<div class="app">
    <nav class="sidebar">
        <div class="brand">
            <img class="brand-logo brand-logo-dark" src="racetrade-logo.svg" alt="RaceTrade" />
            <img class="brand-logo brand-logo-light" src="racetrade-logo-light.svg" alt="RaceTrade" />
            <span class="brand-meta">
                <span class="brand-ver">v2.1.0</span>
                <span class="brand-community">linknet/#racetrade</span>
            </span>
        </div>

        <TraderStatus />

        <input id="mobile-menu-toggle" class="mobile-menu-toggle" type="checkbox" />
        <label class="mobile-menu-button" for="mobile-menu-toggle">
            <Icon Name="menu" Size="16" />
            <span>Menu</span>
        </label>

        <div class="sidebar-scroll">
            <div class="nav-title">MENU</div>
            <NavLink class="nav-item" href="" Match="NavLinkMatch.All"><Icon Name="dashboard" /><span>Dashboard</span></NavLink>
            <NavLink class="nav-item" href="sites"><Icon Name="sites" /><span>Sites</span></NavLink>
            <NavLink class="nav-item" href="servers"><Icon Name="servers" /><span>CBFTP servers</span></NavLink>
            <NavLink class="nav-item" href="prebots"><Icon Name="prebots" /><span>PreBots</span></NavLink>

            <div class="nav-title">TOOLS</div>
            <NavLink class="nav-item" href="pre"><Icon Name="flag" /><span>Pre</span></NavLink>
            <NavLink class="nav-item" href="test"><Icon Name="test" /><span>Test release</span></NavLink>
            <NavLink class="nav-item" href="search"><Icon Name="search" /><span>Search</span></NavLink>
            <NavLink class="nav-item" href="fxp"><Icon Name="fxp" /><span>FXP Client</span></NavLink>
            <NavLink class="nav-item" href="chat"><Icon Name="chat" /><span>Chat</span></NavLink>
            <NavLink class="nav-item" href="logs"><Icon Name="logs" /><span>Logs</span></NavLink>
            <NavLink class="nav-item" href="skips"><Icon Name="warn" /><span>Skips</span></NavLink>
            <NavLink class="nav-item" href="history"><Icon Name="changelog" /><span>History</span></NavLink>
            <NavLink class="nav-item" href="settings"><Icon Name="settings" /><span>Settings</span></NavLink>

            <div class="nav-title">INFO</div>
            <NavLink class="nav-item" href="help"><Icon Name="help" /><span>Help</span></NavLink>
            <NavLink class="nav-item" href="changelog"><Icon Name="changelog" /><span>Changelog</span></NavLink>
            <a class="nav-item nav-external"
               href="https://github.com/Bl4DiEDiEBL4/RaceTrade"
               target="_blank"
               rel="noopener noreferrer"
               title="RaceTrade on GitHub"
               aria-label="RaceTrade on GitHub">
                <Icon Name="github" /><span>GitHub</span>
            </a>
        </div>
    </nav>

    <section class="shell-content">
        <header class="app-header">
            <UpdateNotice />
            <div class="header-actions">
                <ThemeToggle />
                <form class="logout" action="/auth/logout" method="post">
                    <button type="submit"><Icon Name="signout" Size="14" /><span>Sign out</span></button>
                </form>
                <ShutdownButton />
            </div>
        </header>

        <main>
            @Body
        </main>
    </section>
</div>
