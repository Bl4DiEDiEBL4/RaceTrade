@page "/servers"
@inject FxpBackendStore Store
@inject SiteStore SiteStore

<PageTitle>FXP Backends - RaceTrade</PageTitle>

<div class="page-head">
    <h1><Icon Name="servers" Size="18" />FXP Backends</h1>
    <button class="btn primary" @onclick="AddRow"><Icon Name="plus" Size="13" /><span>Add server</span></button>
</div>

<div class="callout">
    <strong>Supported backends:</strong> add a <em>CBFTP</em> or <em>WeaveFXP</em> server here.
    RaceTrade uses the same FXP backend API for testing, importing sites and sending race jobs.
</div>

@if (_error is not null)
{
    <p class="hint err">@_error</p>
}

<div class="panel server-panel">
    @if (_config.FxpBackends.Count == 0)
    {
        <div class="empty">
            No FXP backends configured. Add one - without it there is nowhere to send
            race jobs.
        </div>
    }
    else
    {
        <table class="grid">
            <thead>
                <tr><th>ID</th><th>NAME</th><th>HOST</th><th>PORT</th><th>PASSWORD</th><th>PROFILE</th><th>STATUS</th><th></th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < _config.FxpBackends.Count; i++)
                {
                    var idx = i;
                    var s = _config.FxpBackends[idx];
                    var rowTestResult = _testResults.TryGetValue(idx, out var result) ? result : null;
                    <tr>
                        <td><input type="text" value="@s.Id" @oninput="e => s.Id = e.Value?.ToString()" placeholder="1" class="w-xs" /></td>
                        <td><input type="text" value="@s.Name" @oninput="e => s.Name = e.Value?.ToString()" placeholder="local" /></td>
                        <td><input type="text" value="@s.Host" @oninput="e => s.Host = e.Value?.ToString()" placeholder="127.0.0.1" /></td>
                        <td><input type="text" value="@s.Port" @oninput="e => s.Port = e.Value?.ToString()" placeholder="55477" class="w-xs" /></td>
                        <td>
                            <input type="password" value="@_passwords[idx]"
                                   @oninput="e => SetPassword(idx, e.Value?.ToString())"
                                   placeholder="@(HasStoredPassword(idx) ? "(unchanged)" : "")" />
                        </td>
                        <td><input type="text" value="@s.Profile" @oninput="e => s.Profile = e.Value?.ToString()" placeholder="default" /></td>
                        <td>
                            <button type="button"
                                    class="pill status-toggle @(s.Disabled ? "off" : "on")"
                                    title="@(s.Disabled ? "Enable this FXP backend" : "Disable this FXP backend")"
                                    @onclick="() => ToggleServerDisabled(idx)">
                                @(s.Disabled ? "disabled" : "enabled")
                            </button>
                        </td>
                        <td class="right server-row-actions">
                            <button class="btn" @onclick="() => TestServer(idx)" disabled="@(_testingServerIndex is not null)">
                                <Icon Name="test" Size="13" />
                                <span>@(_testingServerIndex == idx ? "Testing..." : "Test")</span>
                            </button>
                            <button class="btn danger" @onclick="() => RemoveRow(idx)"><Icon Name="trash" Size="13" /><span>Remove</span></button>
                        </td>
                    </tr>
                    @if (rowTestResult is not null)
                    {
                        <tr class="server-test-row">
                            <td colspan="8">
                                <div class="fxp-backend-test-result @((rowTestResult.Success ? "ok" : "err"))">
                                    <strong>@(rowTestResult.Success ? "FXP backend test passed" : "FXP backend test failed")</strong>
                                    <span>@rowTestResult.Message</span>
                                    @if (!string.IsNullOrWhiteSpace(rowTestResult.Endpoint))
                                    {
                                        <code>@rowTestResult.Endpoint</code>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(rowTestResult.ResponsePreview))
                                    {
                                        <pre>@rowTestResult.ResponsePreview</pre>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }

    <div class="form-actions">
        <button class="btn primary" @onclick="Save"><Icon Name="save" Size="13" /><span>Save</span></button>
        <button class="btn" @onclick="Reload"><Icon Name="refresh" Size="13" /><span>Reload</span></button>
    </div>
</div>

<div class="panel form import-panel">
    <h2><Icon Name="download" Size="14" />IMPORT SITES FROM FXP BACKEND</h2>
    <p class="fh">
        Fetches sites and sections from the selected FXP backend, then creates matching
        RaceTrade site configs. You still configure IRC host, bot nick and channels after import.
    </p>

    <div class="import-toolbar">
        <select @bind="_selectedServerId" disabled="@(!HasActiveServers || _fetching || _importing)">
            @foreach (var server in ActiveServers)
            {
                <option value="@server.Id">@DisplayServer(server)</option>
            }
        </select>
        <button class="btn" @onclick="FetchSites" disabled="@(!HasActiveServers || _fetching || _importing)">
            <Icon Name="refresh" Size="13" />
            <span>@(_fetching ? "Fetching..." : "Fetch sites")</span>
        </button>
        <label class="check-inline">
            <input type="checkbox" @bind="_overwriteExisting" disabled="@(_fetching || _importing)" />
            <span>Overwrite existing site files</span>
        </label>
    </div>

    @if (_syncError is not null)
    {
        <p class="hint err">@_syncError</p>
    }
    @if (_syncStatus is not null)
    {
        <p class="hint ok">@_syncStatus</p>
    }

    @if (_fetchedSites.Count > 0)
    {
        <div class="import-actions">
            <span class="fh">@SelectedCount site(s) selected from @_fetchedSites.Count fetched.</span>
            <button class="btn" @onclick="() => SelectFetched(true)" disabled="@(_importing)">Select all</button>
            <button class="btn" @onclick="() => SelectFetched(false)" disabled="@(_importing)">Select none</button>
            <button class="btn primary" @onclick="ImportSelected" disabled="@(SelectedCount == 0 || _importing)">
                <Icon Name="download" Size="13" />
                <span>@(_importing ? "Importing..." : "Import selected sites")</span>
            </button>
        </div>

        <table class="grid import-table">
            <thead>
                <tr><th></th><th>SITE</th><th>ADDRESS</th><th>SECTIONS</th><th>STATUS</th></tr>
            </thead>
            <tbody>
                @foreach (var row in _fetchedSites)
                {
                    <tr>
                        <td><input type="checkbox" @bind="row.Selected" disabled="@(_importing)" /></td>
                        <td class="site">@row.Site.Name</td>
                        <td>@row.Address</td>
                        <td>@row.SectionCount</td>
                        <td>
                            @if (row.Exists)
                            {
                                <span class="pill warn">exists</span>
                            }
                            else
                            {
                                <span class="pill on">new</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private sealed class ImportSiteRow
    {
        public required FxpBackendSite Site { get; init; }
        public bool Selected { get; set; } = true;
        public bool Exists { get; set; }
        public string Address => $"{Site.PrimaryAddress}:{Site.Port}";
        public int SectionCount => Site.Sections?.Count ?? 0;
    }

    private Config _config = new();
    private List<string> _passwords = new();
    private List<string> _storedPasswords = new();
    private string? _error;
    private string? _syncError;
    private string? _syncStatus;
    private string _selectedServerId = "";
    private bool _fetching;
    private bool _importing;
    private bool _overwriteExisting;
    private int? _testingServerIndex;
    private readonly Dictionary<int, FxpBackendTestResult> _testResults = new();
    private readonly List<ImportSiteRow> _fetchedSites = new();

    private int SelectedCount => _fetchedSites.Count(s => s.Selected);
    private bool HasActiveServers => _config.FxpBackends.Any(FxpBackendStore.IsActive);
    private IEnumerable<FxpBackend> ActiveServers => _config.FxpBackends.Where(FxpBackendStore.IsActive);

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        try
        {
            _error = null;
            _testResults.Clear();
            _testingServerIndex = null;
            _config = Store.Load();

            // Stored (encrypted) passwords are kept aside and never rendered; the input
            // starts empty and only overwrites the stored value when something is typed.
            _storedPasswords = _config.FxpBackends.Select(s => s.Password ?? "").ToList();
            _passwords = _config.FxpBackends.Select(_ => "").ToList();

            if (!_config.FxpBackends.Any(s => FxpBackendStore.IsActive(s) && string.Equals(s.Id, _selectedServerId, StringComparison.OrdinalIgnoreCase)))
                _selectedServerId = _config.FxpBackends.FirstOrDefault(FxpBackendStore.IsActive)?.Id ?? "";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void SetPassword(int i, string? value) => _passwords[i] = value ?? "";

    private bool HasStoredPassword(int i) =>
        i < _storedPasswords.Count && !string.IsNullOrEmpty(_storedPasswords[i]);

    private void AddRow()
    {
        _config.FxpBackends.Add(new FxpBackend
        {
            Id = (_config.FxpBackends.Count + 1).ToString(),
            Port = "55477"
        });
        _passwords.Add("");
        _storedPasswords.Add("");
        _selectedServerId = _config.FxpBackends.Last().Id ?? "";
        _testResults.Clear();
    }

    private void RemoveRow(int i)
    {
        _config.FxpBackends.RemoveAt(i);
        _passwords.RemoveAt(i);
        _storedPasswords.RemoveAt(i);
        if (!_config.FxpBackends.Any(s => FxpBackendStore.IsActive(s) && string.Equals(s.Id, _selectedServerId, StringComparison.OrdinalIgnoreCase)))
            _selectedServerId = _config.FxpBackends.FirstOrDefault(FxpBackendStore.IsActive)?.Id ?? "";
        _testResults.Clear();
    }

    private void ToggleServerDisabled(int i)
    {
        if (i < 0 || i >= _config.FxpBackends.Count)
            return;

        _config.FxpBackends[i].Disabled = !_config.FxpBackends[i].Disabled;
        Save();
    }

    private void Save()
    {
        try
        {
            _error = null;
            _testResults.Clear();
            _testingServerIndex = null;

            for (var i = 0; i < _config.FxpBackends.Count; i++)
            {
                _config.FxpBackends[i].Password = string.IsNullOrEmpty(_passwords[i])
                    ? _storedPasswords[i]   // untouched: keep what was already stored
                    : _passwords[i];        // newly typed: SaveAsync encrypts it
            }

            Store.Save(_config);
            Reload();
            RefreshFetchedExisting();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task TestServer(int idx)
    {
        if (idx < 0 || idx >= _config.FxpBackends.Count)
        {
            return;
        }

        try
        {
            _testingServerIndex = idx;
            _error = null;
            _testResults.Remove(idx);
            _testResults[idx] = await Store.TestAsync(CloneForTest(_config.FxpBackends[idx]));
        }
        catch (Exception ex)
        {
            _testResults[idx] = FxpBackendTestResult.Fail(ex.Message);
        }
        finally
        {
            _testingServerIndex = null;
        }
    }

    private async Task FetchSites()
    {
        var server = SelectedServer();
        if (server is null)
        {
            _syncError = "Select an FXP backend first.";
            return;
        }

        try
        {
            _fetching = true;
            _syncError = null;
            _syncStatus = $"Connecting to {server.Host}:{server.Port}...";
            _fetchedSites.Clear();

            var password = string.IsNullOrWhiteSpace(server.Password) ? "" : SecureConfig.Decrypt(server.Password);
            var result = await FxpBackendSync.FetchSitesFromFxpBackend(server.Host ?? "", server.Port ?? "", password);

            if (!result.IsSuccess)
            {
                _syncStatus = null;
                _syncError = $"Failed to fetch sites: {result.ErrorMessage}";
                return;
            }

            var existing = ExistingSiteNames();
            _fetchedSites.AddRange(result.Sites
                .OrderBy(s => s.Name, StringComparer.OrdinalIgnoreCase)
                .Select(s => new ImportSiteRow
                {
                    Site = s,
                    Exists = existing.Contains(s.Name),
                    Selected = true
                }));

            _syncStatus = _fetchedSites.Count == 0
                ? "No sites found on the selected FXP backend."
                : $"Found {_fetchedSites.Count} site(s). Select what you want to import.";
        }
        catch (Exception ex)
        {
            _syncStatus = null;
            _syncError = ex.Message;
        }
        finally
        {
            _fetching = false;
        }
    }

    private void SelectFetched(bool selected)
    {
        foreach (var row in _fetchedSites)
            row.Selected = selected;
    }

    private void ImportSelected()
    {
        var selected = _fetchedSites.Where(r => r.Selected).Select(r => r.Site).ToList();
        if (selected.Count == 0)
        {
            _syncError = "Select at least one site to import.";
            return;
        }

        try
        {
            _importing = true;
            _syncError = null;

            var result = SiteStore.ImportFromFxpBackendSites(selected, _overwriteExisting, SelectedServer()?.Id);
            _syncStatus = $"Import complete: {result.Imported} imported, {result.Skipped} skipped, {result.Errors} errors, {result.SectionsAdded} section(s) added.";

            if (result.Errors > 0)
                _syncError = string.Join(" ", result.Messages);

            RefreshFetchedExisting();
        }
        catch (Exception ex)
        {
            _syncStatus = null;
            _syncError = ex.Message;
        }
        finally
        {
            _importing = false;
        }
    }

    private FxpBackend? SelectedServer() =>
        _config.FxpBackends.FirstOrDefault(s => FxpBackendStore.IsActive(s) && string.Equals(s.Id, _selectedServerId, StringComparison.OrdinalIgnoreCase))
        ?? _config.FxpBackends.FirstOrDefault(FxpBackendStore.IsActive);

    private FxpBackend CloneForTest(FxpBackend server)
    {
        var idx = _config.FxpBackends.IndexOf(server);
        var password = idx >= 0 && idx < _passwords.Count && !string.IsNullOrEmpty(_passwords[idx])
            ? _passwords[idx]
            : idx >= 0 && idx < _storedPasswords.Count
                ? _storedPasswords[idx]
                : server.Password;

        return new FxpBackend
        {
            Id = server.Id,
            Name = server.Name,
            Host = server.Host,
            Port = server.Port,
            Password = password,
            Profile = server.Profile,
            Disabled = server.Disabled
        };
    }

    private HashSet<string> ExistingSiteNames() =>
        SiteStore.ListNames().ToHashSet(StringComparer.OrdinalIgnoreCase);

    private void RefreshFetchedExisting()
    {
        var existing = ExistingSiteNames();
        foreach (var row in _fetchedSites)
            row.Exists = existing.Contains(row.Site.Name);
    }

    private static string DisplayServer(FxpBackend server)
    {
        var name = string.IsNullOrWhiteSpace(server.Name) ? server.Id : server.Name;
        return $"{name} - {server.Host}:{server.Port}";
    }
}
