                                                var isChecked = ListContains(selected.Tvmaze, "blocked_genres", option);
                                                <label class="check-chip @(isChecked ? "checked" : "")">
                                                    <input type="checkbox"
                                                           checked="@isChecked"
                                                           @onchange='e => SetListItem(selected.Tvmaze, "blocked_genres", option, (bool)(e.Value ?? false))' />
                                                    <span>@option</span>
                                                </label>
                                            }
                                        </div>
                                    </div>

                                    <label>Allowed networks</label>
                                    <div>
                                        <input type="text" value='@GetListText(selected.Tvmaze, "allowed_networks")'
                                               @oninput='e => SetListText(selected.Tvmaze, "allowed_networks", e.Value?.ToString())' placeholder="HBO, Netflix" />
                                        <div class="lookup-actions">
                                            <button type="button" class="btn sm" @onclick='() => SetList(selected.Tvmaze, "allowed_networks", PopularNetworks)'>All</button>
                                            <button type="button" class="btn sm" @onclick='() => SetList(selected.Tvmaze, "allowed_networks", Array.Empty<string>())'>None</button>
                                        </div>
                                        <div class="check-chip-list">
                                            @foreach (var networkOption in OptionsWithSelected(PopularNetworks, selected.Tvmaze, "allowed_networks"))
                                            {
                                                var option = networkOption;
                                                var isChecked = ListContains(selected.Tvmaze, "allowed_networks", option);
                                                <label class="check-chip @(isChecked ? "checked" : "")">
                                                    <input type="checkbox"
                                                           checked="@isChecked"
                                                           @onchange='e => SetListItem(selected.Tvmaze, "allowed_networks", option, (bool)(e.Value ?? false))' />
                                                    <span>@option</span>
                                                </label>
                                            }
                                        </div>
                                        <div class="fh">Comma separated. Empty = allow all.</div>
                                    </div>

                                    <label>Show types</label>
                                    <div>
                                        <input type="text" value='@GetListText(selected.Tvmaze, "allowed_show_types")'
                                               @oninput='e => SetListText(selected.Tvmaze, "allowed_show_types", e.Value?.ToString())' placeholder="Scripted" />
                                        <div class="lookup-actions">
                                            <button type="button" class="btn sm" @onclick='() => SetList(selected.Tvmaze, "allowed_show_types", TvmazeShowTypes)'>All</button>
                                            <button type="button" class="btn sm" @onclick='() => SetList(selected.Tvmaze, "allowed_show_types", Array.Empty<string>())'>None</button>
                                        </div>
                                        <div class="check-chip-list compact">
                                            @foreach (var typeOption in OptionsWithSelected(TvmazeShowTypes, selected.Tvmaze, "allowed_show_types"))
                                            {
                                                var option = typeOption;
                                                var isChecked = ListContains(selected.Tvmaze, "allowed_show_types", option);
                                                <label class="check-chip @(isChecked ? "checked" : "")">
                                                    <input type="checkbox"
                                                           checked="@isChecked"
                                                           @onchange='e => SetListItem(selected.Tvmaze, "allowed_show_types", option, (bool)(e.Value ?? false))' />
                                                    <span>@option</span>
                                                </label>
                                            }
                                        </div>
                                        <div class="fh">e.g. Scripted, Reality, Documentary.</div>
                                    </div>

                                    <label>Options</label>
                                    <div class="chk-row">
                                        <label class="chk"><input type="checkbox" checked='@GetBool(selected.Tvmaze, "skip_ended_shows")'
                                            @onchange='e => SetBool(selected.Tvmaze, "skip_ended_shows", e)' /> Skip ended shows</label>
                                        <label class="chk"><input type="checkbox" checked='@GetBool(selected.Tvmaze, "fallback_on_error")'
                                            @onchange='e => SetBool(selected.Tvmaze, "fallback_on_error", e)' /> Race on lookup error</label>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    }
                </section>
            }
        </div>
    }
}

@if (_tab == "Affils")
{
    <p class="hint">
        Releases from these groups make this site download-only for that release
        (it still races, but is not an upload target).
    </p>
    <div class="row-actions">
        <input type="text" @bind="_newAffil" placeholder="GROUPNAME" @bind:event="oninput" />
        <button class="btn primary" @onclick="AddAffil"><Icon Name="plus" Size="13" /><span>Add</span></button>
    </div>
    <table class="grid">
