@if (_tab == "Requests")
{
    <div class="callout">
        <strong>Request auto-fill uses CBFTP raw commands.</strong> The list command is sent to
        the request site, each output line is parsed by the regex below, and RaceTrade fills
        matching releases from sites marked as source.
    </div>

    @* Status, not just a checkbox: auto-fill only runs while the racer runs, and that
       was invisible before — the box was ticked and nothing ever happened. *@
    <div class="form-grid wide">
        <label>Auto-fill enabled</label>
        <div>
            <input type="checkbox" @bind="S.RequestAutoFillEnabled" />
            <span class="fh inline">Enable auto-fill of requests.</span>

            <div class="fh">
                @if (!Engine.IsRunning)
                {
                    <text>
                        Polling only runs while the racer is running — start it from the
                        sidebar.
                    </text>
                }
                else if (Engine.RequestFillSites.Contains(S.Sitename ?? "", StringComparer.OrdinalIgnoreCase))
                {
                    <span class="ok-text">Currently polling this site every @(S.RequestPollSeconds > 0 ? S.RequestPollSeconds : 300)s.</span>
                }
                else
                {
                    <text>Not being polled yet. Save to apply.</text>
                }
            </div>
        </div>

        <label>List command</label>
        <div>
            <input type="text" @bind="S.RequestListCommand" placeholder="SITE REQUESTS" @bind:event="oninput" />
            <div class="fh">Command sent through CBFTP <code>/raw</code> to list open requests.</div>
        </div>

        <label>Request line regex</label>
        <div>
            <input type="text" @bind="S.RequestLinePattern" @bind:event="oninput" />
            <div class="fh">For regex, use named groups: <code>(?&lt;id&gt;)</code>, <code>(?&lt;name&gt;)</code>, optional <code>(?&lt;user&gt;)</code>.</div>
        </div>

        <label>Fill command template</label>
        <div>
            <input type="text" @bind="S.RequestFillTemplate" placeholder="SITE REQFILLED {id}" @bind:event="oninput" />
            <div class="fh">Supported placeholders: <code>{id}</code>, <code>{name}</code>.</div>
        </div>

        <label>Dst path template</label>
        <div>
            <input type="text" @bind="S.RequestDstPathTemplate" placeholder="/REQUESTS/REQ-{release}" @bind:event="oninput" />
            <div class="fh">Supported placeholders: <code>{id}</code>, <code>{name}</code>, <code>{user}</code>, <code>{release}</code>, <code>{sitename}</code>.</div>
        </div>

        <label>Complete pattern</label>
        <div>
            <input type="text" @bind="S.RequestCompletePattern" @bind:event="oninput" />
            <div class="fh">Optional regex. Matching request lines are treated as already filled and skipped.</div>
        </div>

        <label>Poll interval (s)</label>
        <div>
            <input type="number" @bind="S.RequestPollSeconds" placeholder="300" @bind:event="oninput" />
            <div class="fh">Old default is <code>300</code>; minimum polling interval is handled by the engine.</div>
        </div>

        <label>Can fill from source</label>
        <div>
            <input type="checkbox" @bind="S.RequestCanFillSource" />
            <span class="fh inline">Can be used for filling requests on another site.</span>
        </div>
    </div>
}

@if (_tab == "CBFTP Site")
{
    <div class="cbftp-site-tab">
        <div class="callout">
            <strong>This edits the site inside CBFTP itself.</strong> The other tabs edit
