@page "/sites/edit/{Name}"
@page "/sites/new"
@using Newtonsoft.Json.Linq
@inject SiteStore Store
@inject PreBotStore PreBots
@inject NavigationManager Nav
@inject EngineHost Engine

<PageTitle>@(_isNew ? "New site" : $"{_originalName} - RaceTrade")</PageTitle>

<div class="page-head">
    <h1><Icon Name="sites" Size="18" />@(_isNew ? "New site" : _originalName)</h1>
    <div class="head-actions">
        <button class="btn primary" @onclick="Save"><Icon Name="save" Size="13" /><span>Save</span></button>
        <a class="btn" href="sites"><Icon Name="close" Size="13" /><span>Cancel</span></a>
    </div>
</div>

@if (_error is not null)
{
    <p class="hint err">@_error</p>
}
@if (_status is not null)
{
    <p class="hint">@_status</p>
}

<div class="tabs">
    @foreach (var t in Tabs)
    {
        <button class="tab @(_tab == t ? "active" : "")" @onclick="() => _tab = t">@t</button>
    }
</div>

@* fill-tab only on Sections: that tab sizes itself to the viewport, the other tabs are
   ordinary scrolling forms and must keep the page scrollbar. *@
<div class="panel form @(_tab == "Sections" ? "fill-tab" : "")">

@if (_tab == "General")
{
    <div class="form-grid">
        <label>Site name</label>
        <div>
            <input type="text" @bind="S.Sitename" placeholder="MYSITE" @bind:event="oninput" />
            <div class="fh">Also the filename under <code>sites\</code>. Must match the site name used in cbftp.</div>
        </div>

        <label>Bot name</label>
        <div>
            <input type="text" @bind="S.BotName" placeholder="SiteBoT" @bind:event="oninput" />
            <div class="fh">Nick of the announce bot in the channel. Only lines from this nick are parsed.</div>
        </div>

        <label>Mode</label>
        <div>
            <select @bind="S.PreOrSite">
                <option value="Site">Site - own sitebot announces</option>
                <option value="PreBot">PreBot</option>
                @foreach (var prebot in _preBotNames)
                {
                    <option value="@GlobalPreBotMode(prebot)">Global PreBot (@prebot)</option>
                }
            </select>
            <div class="fh">
                With a <strong>Global PreBot</strong>, this site uses the selected PreBot feed from
                <code>pre_bots</code>. The PreBot parser lives on the PreBots page; this site still
                controls which IRC sections race and how they map to CBFTP.
            </div>
        </div>

        <label>Disabled</label>
        <div>
            <input type="checkbox" @bind="S.DisableSite" />
            <span class="fh inline">Skip this site entirely - no IRC connection, no racing.</span>
        </div>

        <label>Download only</label>
        <div>
            <input type="checkbox" @bind="S.DlOnlySite" />
            <span class="fh inline">Races, but is never an upload target.</span>
        </div>

        <label>Max pretime (s)</label>
        <div>
            <input type="number" @bind="_maxPreTime" placeholder="0" @bind:event="oninput" />
            <div class="fh">Skip releases older than this many seconds since pre. <code>0</code> = no limit. Can be overridden per section.</div>
        </div>

    </div>
}

@if (_tab == "ZNC")
{
    <div class="form-grid">
        <label>Host</label>
        <div>
            <input type="text" @bind="Sv.Host" placeholder="znc.myhost.net" @bind:event="oninput" />
            <div class="fh">Your ZNC bouncer, not the IRC server itself.</div>
        </div>

        <label>Port</label>
        <div>
            <input type="number" @bind="Sv.Port" placeholder="6697" @bind:event="oninput" />
            <div class="fh">ZNC listen port. Usually 6697 (SSL).</div>
        </div>

        <label>Username</label>
        <div>
            <input type="text" @bind="Sv.Username" placeholder="racer" @bind:event="oninput" />
            <div class="fh">The bare ZNC account name - <strong>without</strong> <code>/network</code>.</div>
        </div>

        <label>Network</label>
        <div>
            <input type="text" @bind="Sv.Network" placeholder="EFNet" @bind:event="oninput" />
            <div class="fh">
                The network name exactly as configured in ZNC. Combined with the username this
                becomes <code>user/network</code> at connect time - this is what puts each site
                on the right network. Leave empty only if this ZNC user has a single network.
            </div>
        </div>

        <label>Password</label>
        <div>
            <input type="password" @bind="_password" placeholder="@(_hasStoredPassword ? "******** (unchanged)" : "ZNC password")" @bind:event="oninput" />
            <div class="fh">Stored encrypted. Leave empty to keep the current password.</div>
        </div>
    </div>
}

@if (_tab == "Channels")
{
    <div class="callout">
        <strong>Only add channels that belong to this site's network.</strong> Every channel listed
        here is joined on the network configured under the ZNC tab - a channel from another
        network ends up created on the wrong one.
        Keys are stored encrypted; leave a key empty to keep the existing one.
    </div>

    @if (VisibleChannels.Count == 0)
    {
        <div class="empty">No channels yet.</div>
    }
    else
    {
        <table class="grid chan-table">
            <thead>
                <tr><th class="w-chan">CHANNEL</th><th>BLOWFISH KEY</th><th class="w-act"></th></tr>
            </thead>
            <tbody>
                @foreach (var c in VisibleChannels)
                {
                    var idx = _channels.FindIndex(x => x.Index == c.Index);
                    <tr>
                        <td><input type="text" value="@_channels[idx].Channel"
                                   @oninput="e => SetChannel(idx, e.Value?.ToString())" placeholder="#channel" /></td>
                        <td>
                            <input type="password" value="@_channels[idx].Key"
                                   @oninput="e => SetKey(idx, e.Value?.ToString())"
                                   placeholder="@(HasStoredKey(idx) ? "******** (unchanged)" : "no encryption")" />
                        </td>
                        <td class="right">
                            <button class="btn danger sm" title="Clear this channel"
                                    @onclick="() => ClearChannel(idx)">&times;</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="row-actions">
        <button class="btn primary" @onclick="AddChannelRow" disabled="@(_channels.All(c => !string.IsNullOrWhiteSpace(c.Channel)) && _visible.Count >= 20)">
            + Add channel
        </button>
        <span class="fh inline">@VisibleChannels.Count of 20 slots used</span>
    </div>
}

@if (_tab == "Announce")
{
    <div class="editor-with-aside announce-editor">
        <div class="editor-main">
            <div class="callout">
                <strong>How an announce is parsed.</strong> A line from the bot is first checked against
                <em>New regex</em> to see if it is a new-release announce at all. Then
                <em>Section regex</em> pulls out the section and <em>Release regex</em> the release name.
                Both need a capture group <code>(...)</code> - the first group is what gets used.
                Prefix/suffix are then stripped from the result, which is handy when your bot announces
                <code>[TV-HD]</code> but your sections are called <code>TV-HD</code>.
            </div>

            <h2>NORMAL ANNOUNCE</h2>
            <div class="form-grid wide">
                <label>New regex</label>
                <div>
                    <input type="text" @bind="S.NewRegexPattern" placeholder="^NEW:" @bind:event="oninput" />
                    <div class="fh">
                        Line must match this to be treated as a new release. Leave empty to
                        accept every line from the bot.
                    </div>
                </div>

                <label>Section regex</label>
                <div>
                    <input type="text" @bind="S.SectionRegexPattern" placeholder="^NEW:\s*\[([^\]]+)\]" @bind:event="oninput" />
                    <div class="fh">Captures the section. The example yields <code>TV-FR</code>.</div>
                </div>

                <label>Release regex</label>
                <div>
                    <input type="text" @bind="S.ReleaseRegexPattern" placeholder="^NEW:\s*\[[^\]]+\]\s+(\S+)" @bind:event="oninput" />
                    <div class="fh">
                        Captures the release name. Anchoring it to the NEW line too means the
                        New regex is not your only line of defence.
                    </div>
                </div>

                <label>Section prefix</label>
                <div>
                    <input type="text" @bind="S.SectionPrefix" placeholder="[" @bind:event="oninput" />
                    <div class="fh">Stripped from the front of the captured section, if present.</div>
                </div>

                <label>Section suffix</label>
                <div>
                    <input type="text" @bind="S.SectionSuffix" placeholder="]" @bind:event="oninput" />
                    <div class="fh">Stripped from the end of the captured section.</div>
                </div>

                <label>Release prefix</label>
                <div><input type="text" @bind="S.ReleasePrefix" @bind:event="oninput" /></div>

                <label>Release suffix</label>
                <div><input type="text" @bind="S.ReleaseSuffix" @bind:event="oninput" /></div>

                <label>Ignore words</label>
                <div>
                    <input type="text" @bind="S.IgnoreWords" placeholder="COMPLETE, NUKED, REQUEST" @bind:event="oninput" />
                    <div class="fh">Comma separated. Announce lines containing any of these are ignored before racing.</div>
                </div>
            </div>

            <h2>TEST NORMAL</h2>
            <div class="regex-test-row">
                <input type="text" @bind="_announceTestInput" placeholder="Paste a normal sitebot announce line here" @bind:event="oninput" />
                <button type="button" class="btn primary" @onclick="TestNormalAnnounceRegex"><Icon Name="test" Size="13" /><span>Test</span></button>
            </div>

            @if (_announceTestResult is not null)
            {
                <div class="@($"regex-result {(_announceTestResult.Success ? "ok" : "err")}")">
                    <strong>@_announceTestResult.Title</strong>
                    @foreach (var line in _announceTestResult.Lines)
                    {
                        <div class="@($"regex-result-row {line.Status}")">
                            <span>@line.Label</span>
                            <code>@(string.IsNullOrEmpty(line.Value) ? "-" : line.Value)</code>
                        </div>
                    }
                </div>
            }

            <h2>PRE ANNOUNCE</h2>
            <p class="fh">
                Only used when this site also announces pres, or when it is a PreBot. If left empty the
                normal patterns above are used for pre lines too.
            </p>
            <div class="form-grid wide">
                <label>Pre regex</label>
                <div>
                    <input type="text" @bind="S.PreRegexPattern" placeholder="PRE" @bind:event="oninput" />
                    <div class="fh">Marks a line as a pre announce rather than a new-release announce.</div>
                </div>

                <label>Pre section regex</label>
                <div><input type="text" @bind="S.PreSectionRegexPattern" placeholder="\[([^\]]+)\]" @bind:event="oninput" /></div>

                <label>Pre release regex</label>
                <div><input type="text" @bind="S.PreReleaseRegexPattern" placeholder="(\S+-\w+)$" @bind:event="oninput" /></div>

                <label>Pre section prefix</label>
                <div><input type="text" @bind="S.PreSectionPrefix" placeholder="[" @bind:event="oninput" /></div>

                <label>Pre section suffix</label>
                <div><input type="text" @bind="S.PreSectionSuffix" placeholder="]" @bind:event="oninput" /></div>
            </div>

            <h2>TEST PRE</h2>
            <div class="regex-test-row">
                <input type="text" @bind="_preAnnounceTestInput" placeholder="Paste a pre announce line here" @bind:event="oninput" />
                <button type="button" class="btn primary" @onclick="TestPreAnnounceRegex"><Icon Name="test" Size="13" /><span>Test</span></button>
            </div>

            @if (_preAnnounceTestResult is not null)
            {
                <div class="@($"regex-result {(_preAnnounceTestResult.Success ? "ok" : "err")}")">
                    <strong>@_preAnnounceTestResult.Title</strong>
                    @foreach (var line in _preAnnounceTestResult.Lines)
                    {
                        <div class="@($"regex-result-row {line.Status}")">
                            <span>@line.Label</span>
                            <code>@(string.IsNullOrEmpty(line.Value) ? "-" : line.Value)</code>
                        </div>
                    }
                </div>
            }
        </div>

        <aside class="regex-help-panel">
            <h2>ANNOUNCE EXAMPLES</h2>
            <p class="fh">Working sample sitebot setup. Change it only when the real announce line in your channel is different.</p>
            <div class="regex-example-list">
                <div>
                    <span>Normal line</span>
                    <code>&lt;SiteBot&gt; NEW: [TV-FR] Some.Release.S01E02.FRENCH.1080p.WEB-GRP by uploader1</code>
                </div>
                <div>
                    <span>New regex</span>
                    <code>^NEW:</code>
                </div>
                <div>
                    <span>Section regex</span>
                    <code>^NEW:\s*\[([^\]]+)\]</code>
                </div>
                <div>
                    <span>Release regex</span>
                    <code>^NEW:\s*\[[^\]]+\]\s+(\S+)</code>
                </div>
                <div>
                    <span>Section prefix / suffix</span>
                    <code>[ and ]</code>
                </div>
            </div>
            <p class="fh">
                The bot also posts NEW LEADER, RACE, HALFWAY and COMPLETE lines. Keep the
                patterns anchored to <code>^NEW:</code> so those status lines do not become
                duplicate detections.
            </p>
            <p class="fh">
                Ignore words from this Announce tab still apply. If the test says an ignore word matched,
                the announce will be skipped before racing.
            </p>
        </aside>
    </div>
}

@if (_tab == "Sections")
{
    <div class="sections-topbar">
        <h2>SECTION ROUTING</h2>
        <span class="fh">Pick an IRC section, then map it to CBFTP sections.</span>
        <button class="btn primary sm" @onclick="AddSection"><Icon Name="plus" Size="12" /><span>Add section</span></button>
    </div>

    @if (_cfg.Sections.Count == 0)
    {
        <div class="empty">No sections yet.</div>
    }
    else
    {
        var selected = SelectedSection;

        <div class="sections-shell">
            @* 40+ sections is normal, so the rail gets a filter box; without it finding
               one section means scrolling a list taller than the screen. *@
            <aside class="section-list">
                <div class="section-search">
                    <Icon Name="search" Size="13" />
                    <input type="search"
                           value="@_sectionFilter"
                           @oninput="e => _sectionFilter = e.Value?.ToString() ?? string.Empty"
                           placeholder="Filter sections" />
                    @if (!string.IsNullOrEmpty(_sectionFilter))
                    {
                        <button type="button" class="section-search-clear" title="Clear filter"
                                @onclick="() => _sectionFilter = string.Empty">&times;</button>
                    }
                </div>

                <div class="section-list-head">
                    <span>@FilteredSections.Count of @_cfg.Sections.Count</span>
                    <span>@_cfg.RaceSectionsEnabled.Count racing</span>
                </div>

                <div class="section-list-scroll">
                    @if (FilteredSections.Count == 0)
                    {
                        <div class="empty compact">No section matches.</div>
                    }

                    @foreach (var entry in FilteredSections)
                    {
                        var idx = entry.Index;
                        var sec = entry.Section;
                        var active = idx == SelectedSectionIndex;
                        var racing = IsRaceEnabled(sec.IrcName);
                        <button type="button"
                                class="section-row @(active ? "active" : "") @(racing ? "" : "muted")"
                                @onclick="() => SelectSection(idx)">
                            <span class="section-dot @(racing ? "on" : "off")"
                                  role="button"
                                  tabindex="0"
                                  title="@(racing ? "Racing - click to disable" : "Off - click to enable")"
                                  @onclick:stopPropagation="true"
                                  @onclick="() => ToggleRaceEnabled(sec)"
                                  @onkeydown="e => ToggleRaceEnabledFromKey(e, sec)"></span>
                            <span class="section-row-main">
                                <strong>@DisplaySectionName(sec)</strong>
                                @* "0DAY / 0DAY" on every row was pure noise: the second line
                                   only earns its place when the target differs from the name. *@
                                @if (!string.Equals(MappingSummary(sec), DisplaySectionName(sec), StringComparison.OrdinalIgnoreCase))
                                {
                                    <span>@MappingSummary(sec)</span>
                                }
                            </span>
                            <span class="section-badges">
                                @if (IsEnabled(sec.Imdb))
                                {
                                    <span class="mini-pill info" title="IMDB filter active">IMDB</span>
                                }
                                @if (IsEnabled(sec.Tvmaze))
                                {
                                    <span class="mini-pill info" title="TVMaze filter active">TV</span>
                                }
                            </span>
                        </button>
                    }
                </div>
            </aside>

            @if (selected is not null)
            {
                var mappingCount = selected.Tags?.Count ?? 0;
                var mappingRuleCount = selected.Tags?.Sum(t => t.Rules?.Count ?? 0) ?? 0;
                var sectionRuleCount = selected.Rules?.Count ?? 0;
                var sectionRacing = IsRaceEnabled(selected.IrcName);
                var lookupOpen = IsEnabled(selected.Imdb) || IsEnabled(selected.Tvmaze);

                <section class="section-editor @(lookupOpen ? "lookup-open" : "")">
                    @* The name is the heading AND the edit field: it used to be a <h2> and
                       an input below it showing the same text. The left edge of the card
                       carries the racing state so it is readable without reading. *@
                    <div class="section-hero @(sectionRacing ? "racing" : "off")">
                        <div class="hero-top">
                            <label class="hero-name">
                                <span class="eyebrow">IRC section</span>
                                <input type="text" value="@selected.IrcName"
                                       @oninput="e => SetSectionName(selected, e.Value?.ToString())"
                                       placeholder="TV-HD" />
                            </label>

                            <button class="btn danger icon-btn" title="Remove this section"
                                    @onclick="() => RemoveSection(selected)">
                                <Icon Name="trash" Size="14" />
                            </button>
                        </div>

                        <div class="hero-controls">
                            <label class="control-card toggle-card @(sectionRacing ? "on" : "")">
                                <input type="checkbox"
                                       checked="@sectionRacing"
                                       @onchange="e => SetRaceEnabled(selected.IrcName, (bool)(e.Value ?? false))" />
                                <span class="switch-track"></span>
                                <span class="control-text">
                                    <strong>@(sectionRacing ? "Racing enabled" : "Racing disabled")</strong>
                                    <em>
                                        @(sectionRacing
                                            ? "Announces in this IRC section can create CBFTP jobs."
                                            : "Announces in this IRC section are ignored.")
                                    </em>
                                </span>
                            </label>

                            <label class="control-card">
                                <span class="control-text">
                                    <strong>Pretime override</strong>
                                    <em>Seconds. Empty = use the site pretime.</em>
                                </span>
                                <input class="pretime-input" type="number"
                                       value="@(selected.Pretime?.ToString() ?? "")"
                                       @oninput="e => selected.Pretime = ParseNullableInt(e.Value?.ToString())"
                                       placeholder="inherit" />
                            </label>
                        </div>

                        @* Counters left, lookup toggles right. The lookup block used to be a
                           whole card at the bottom of the page for two checkboxes, which is
                           what pushed the tab past the viewport. *@
                        <div class="hero-footer">
                            <div class="section-stats" aria-label="Section summary">
                                <span><b>@mappingCount</b> mapping@(mappingCount == 1 ? "" : "s")</span>
                                <span><b>@sectionRuleCount</b> section rule@(sectionRuleCount == 1 ? "" : "s")</span>
                                <span><b>@mappingRuleCount</b> mapping rule@(mappingRuleCount == 1 ? "" : "s")</span>
                                @if (mappingCount == 0)
                                {
                                    <span class="warn">No mapping - this section cannot race</span>
                                }
                            </div>

                            <div class="lookup-inline">
                                <span>Lookup filters</span>
                                <label class="chk">
                                    <input type="checkbox" checked="@IsEnabled(selected.Imdb)"
                                           @onchange="e => ToggleFilter(selected, imdb: true, (bool)(e.Value ?? false))" />
                                    IMDB
                                </label>
                                <label class="chk">
                                    <input type="checkbox" checked="@IsEnabled(selected.Tvmaze)"
                                           @onchange="e => ToggleFilter(selected, imdb: false, (bool)(e.Value ?? false))" />
                                    TVMaze
                                </label>
                            </div>
                        </div>

                        @if (lookupOpen)
                        {
                            <div class="section-lookup-panel">
                                @if (IsEnabled(selected.Imdb))
                                {
                                    <div class="subcard nested lookup-card">
                                        <div class="card-title">IMDB FILTER - movies</div>
                                        <div class="form-grid">
                                            <label>Min rating</label>
                                            <div><input type="text" value='@Get(selected.Imdb, "min_rating")'
                                                        @oninput='e => Set(selected.Imdb, "min_rating", e.Value?.ToString())' placeholder="6.5" /></div>

                                            <label>Min votes</label>
                                            <div><input type="text" value='@Get(selected.Imdb, "min_votes")'
                                                        @oninput='e => Set(selected.Imdb, "min_votes", e.Value?.ToString())' placeholder="1000" /></div>

                                            <label>Restrictions</label>
                                            <div class="chk-row">
                                                <label class="chk"><input type="checkbox" checked='@GetBool(selected.Imdb, "only_english")'
                                                    @onchange='e => SetBool(selected.Imdb, "only_english", e)' /> English only</label>
                                                <label class="chk"><input type="checkbox" checked='@GetBool(selected.Imdb, "only_us_country")'
                                                    @onchange='e => SetBool(selected.Imdb, "only_us_country", e)' /> US only</label>
                                                <label class="chk"><input type="checkbox" checked='@GetBool(selected.Imdb, "no_documentary")'
                                                    @onchange='e => SetBool(selected.Imdb, "no_documentary", e)' /> No documentary</label>
                                                <label class="chk"><input type="checkbox" checked='@GetBool(selected.Imdb, "no_comedy")'
                                                    @onchange='e => SetBool(selected.Imdb, "no_comedy", e)' /> No comedy</label>
                                                <label class="chk"><input type="checkbox" checked='@GetBool(selected.Imdb, "no_music")'
                                                    @onchange='e => SetBool(selected.Imdb, "no_music", e)' /> No music</label>
                                                <label class="chk"><input type="checkbox" checked='@GetBool(selected.Imdb, "no_show")'
                                                    @onchange='e => SetBool(selected.Imdb, "no_show", e)' /> No TV shows</label>
                                            </div>

                                            <label>Allowed genres</label>
                                            <div>
                                                <input type="text" value='@GetListText(selected.Imdb, "allowed_genres")'
                                                       @oninput='e => SetListText(selected.Imdb, "allowed_genres", e.Value?.ToString())' placeholder="Action, Thriller" />
                                                <div class="lookup-actions">
                                                    <button type="button" class="btn sm" @onclick='() => SetList(selected.Imdb, "allowed_genres", ImdbGenres)'>All</button>
                                                    <button type="button" class="btn sm" @onclick='() => SetList(selected.Imdb, "allowed_genres", Array.Empty<string>())'>None</button>
                                                    <span class="fh inline">Empty = allow all.</span>
                                                </div>
                                                <div class="check-chip-list">
                                                    @foreach (var genreOption in OptionsWithSelected(ImdbGenres, selected.Imdb, "allowed_genres"))
                                                    {
                                                        var option = genreOption;
                                                        var isChecked = ListContains(selected.Imdb, "allowed_genres", option);
                                                        <label class="check-chip @(isChecked ? "checked" : "")">
                                                            <input type="checkbox"
                                                                   checked="@isChecked"
                                                                   @onchange='e => SetListItem(selected.Imdb, "allowed_genres", option, (bool)(e.Value ?? false))' />
                                                            <span>@option</span>
                                                        </label>
                                                    }
                                                </div>
                                            </div>

                                            <label>Blocked genres</label>
                                            <div>
                                                <input type="text" value='@GetListText(selected.Imdb, "blocked_genres")'
                                                       @oninput='e => SetListText(selected.Imdb, "blocked_genres", e.Value?.ToString())' placeholder="Documentary, Music" />
                                                <div class="lookup-actions">
                                                    <button type="button" class="btn sm" @onclick='() => SetList(selected.Imdb, "blocked_genres", ImdbGenres)'>All</button>
                                                    <button type="button" class="btn sm" @onclick='() => SetList(selected.Imdb, "blocked_genres", Array.Empty<string>())'>None</button>
                                                </div>
                                                <div class="check-chip-list">
                                                    @foreach (var genreOption in OptionsWithSelected(ImdbGenres, selected.Imdb, "blocked_genres"))
                                                    {
                                                        var option = genreOption;
                                                        var isChecked = ListContains(selected.Imdb, "blocked_genres", option);
                                                        <label class="check-chip @(isChecked ? "checked" : "")">
                                                            <input type="checkbox"
                                                                   checked="@isChecked"
                                                                   @onchange='e => SetListItem(selected.Imdb, "blocked_genres", option, (bool)(e.Value ?? false))' />
                                                            <span>@option</span>
                                                        </label>
                                                    }
                                                </div>
                                            </div>

                                            <label>On lookup error</label>
                                            <div>
                                                <label class="chk"><input type="checkbox" checked='@GetBool(selected.Imdb, "fallback_on_error")'
