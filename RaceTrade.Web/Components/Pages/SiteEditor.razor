@code {
    [Parameter] public string? Name { get; set; }

    private static readonly string[] Tabs =
        { "General", "ZNC", "Channels", "Announce", "Sections", "Affils", "Blacklist", "Requests", "CBFTP Site" };

    private static readonly string[] ImdbGenres =
    {
        "Action", "Adventure", "Animation", "Biography", "Comedy",
        "Crime", "Documentary", "Drama", "Family", "Fantasy",
        "Film-Noir", "History", "Horror", "Music", "Musical",
        "Mystery", "Romance", "Sci-Fi", "Sport", "Thriller",
        "War", "Western"
    };

    private static readonly string[] TvmazeGenres =
    {
        "Action", "Adventure", "Anime", "Children", "Comedy", "Crime",
        "Documentary", "Drama", "Fantasy", "Food", "Game Show", "History",
        "Horror", "Legal", "Medical", "Music", "Mystery", "Nature",
        "Reality", "Romance", "Science-Fiction", "Sports", "Supernatural",
        "Talk Show", "Thriller", "Travel", "War", "Western"
    };

    private static readonly string[] PopularNetworks =
    {
        "HBO", "Netflix", "Amazon", "Apple TV+", "Disney+", "Hulu",
        "Showtime", "AMC", "FX", "CBS", "NBC", "ABC", "FOX", "The CW",
        "Peacock", "Paramount+", "Max", "BBC One", "BBC Two", "Channel 4",
        "Sky Atlantic", "ITV", "Starz", "Epix", "USA Network", "TNT",
        "Syfy", "Comedy Central", "Adult Swim", "Cartoon Network"
    };

    private static readonly string[] TvmazeShowTypes =
    {
        "Scripted", "Animation", "Reality", "Talk Show", "Documentary",
        "Game Show", "News", "Sports", "Variety", "Award Show", "Panel Show"
    };

    private static bool RenderLegacyLookupBlock => false;

    private SiteConfig _cfg = SiteStore.NewSite();
    private SiteSettings S => _cfg.SiteSettings;
    private ServerSettings Sv => _cfg.Server;

    private string _tab = "General";
    private string _originalName = "";
    private bool _isNew;
    private string? _error;
    private string? _status;
    private bool _loadingRules;
    private bool _showRules;
    private string _rulesText = "";
    private IReadOnlyList<string> _preBotNames = Array.Empty<string>();

    private string _password = "";
    private bool _hasStoredPassword;
    private SiteConfig? _stored;

    private List<(int Index, string Channel, string Key)> _channels = new();
    private int _maxPreTime;
    private string _newAffil = "";
    private string _newBlacklist = "";
    private int _selectedSectionIndex = -1;
    private string _sectionFilter = "";
    private Section? _dragSectionRuleOwner;
    private Tag? _dragTagRuleOwner;
    private int _dragRuleIndex = -1;
    private string _announceTestInput = "";
    private string _preAnnounceTestInput = "";
    private RegexTestResult? _announceTestResult;
    private RegexTestResult? _preAnnounceTestResult;

    protected override void OnParametersSet()
    {
        _preBotNames = PreBots.ListNames();
        _isNew = string.IsNullOrEmpty(Name);

        if (_isNew)
        {
            _cfg = SiteStore.NewSite();
            _stored = null;
            _hasStoredPassword = false;
        }
        else
        {
            _cfg = Store.Load(Name!);
            _originalName = Name!;
            _stored = Store.Load(Name!);
            _hasStoredPassword = !string.IsNullOrEmpty(Sv.Password);
        }

        _cfg.Sections ??= new List<Section>();
        _cfg.Affils ??= new List<string>();
        _cfg.GlobalBlacklist ??= new List<string>();
        _cfg.RaceSectionsEnabled ??= new List<string>();
        NormalizeLegacyPreBotMode();
        foreach (var section in _cfg.Sections)
        {
            section.Tags ??= new List<Tag>();
            section.Rules ??= new List<string>();
            foreach (var tag in section.Tags)
            {
                tag.Rules ??= new List<string>();
            }
        }
        NormalizeSelectedSection();

        _maxPreTime = S.MaxPreTime ?? 0;

        // Secrets are never rendered: the boxes start empty and only overwrite the
        // stored value when something new is typed.
        _password = "";
        _channels = SiteStore.ReadChannels(S)
            .Select(c => (c.Index, c.Channel, ""))
            .ToList();
        _announceTestInput = "";
        _preAnnounceTestInput = "";
        _announceTestResult = null;
        _preAnnounceTestResult = null;
    }

    private static string GlobalPreBotMode(string name) => $"Global PreBot ({name})";

    private void NormalizeLegacyPreBotMode()
    {
        if (!string.Equals(S.PreOrSite, "Global PreBot", StringComparison.OrdinalIgnoreCase))
            return;

        S.PreOrSite = "Site";
        _status = "Legacy Global PreBot mode without a selected PreBot was reset to Site.";
    }

    private void TestNormalAnnounceRegex()
    {
        _announceTestResult = RegexTestHelper.TestNormalAnnounce(
            _announceTestInput,
            S.NewRegexPattern,
            S.IgnoreWords,
            S.SectionRegexPattern,
            S.ReleaseRegexPattern,
            S.SectionPrefix,
            S.SectionSuffix);
    }

    private void TestPreAnnounceRegex()
    {
        _preAnnounceTestResult = RegexTestHelper.TestPreAnnounce(
            _preAnnounceTestInput,
            S.PreRegexPattern,
            string.IsNullOrWhiteSpace(S.PreSectionRegexPattern) ? S.SectionRegexPattern : S.PreSectionRegexPattern,
            string.IsNullOrWhiteSpace(S.PreReleaseRegexPattern) ? S.ReleaseRegexPattern : S.PreReleaseRegexPattern,
            string.IsNullOrWhiteSpace(S.PreSectionPrefix) ? S.SectionPrefix : S.PreSectionPrefix,
            string.IsNullOrWhiteSpace(S.PreSectionSuffix) ? S.SectionSuffix : S.PreSectionSuffix);
    }

    private bool HasStoredKey(int i)
    {
        if (_stored is null) return false;
        var v = (string?)_stored.SiteSettings.GetType()
            .GetProperty($"BlowfishKey{_channels[i].Index}")?.GetValue(_stored.SiteSettings);
        return !string.IsNullOrEmpty(v);
    }

    private void SetChannel(int i, string? v) => _channels[i] = (_channels[i].Index, v ?? "", _channels[i].Key);
    private void SetKey(int i, string? v) => _channels[i] = (_channels[i].Index, _channels[i].Channel, v ?? "");

    // Only rows that hold a channel are shown; _visible additionally holds the empty
    // slots the user asked for via "+ Add channel", so the page stays short instead of
    // rendering twenty empty inputs.
    private readonly HashSet<int> _visible = new();

    private List<(int Index, string Channel, string Key)> VisibleChannels =>
        _channels.Where(c => !string.IsNullOrWhiteSpace(c.Channel) || _visible.Contains(c.Index)).ToList();

    private void AddChannelRow()
    {
        var free = _channels.FirstOrDefault(c => string.IsNullOrWhiteSpace(c.Channel) && !_visible.Contains(c.Index));
        if (free.Index > 0) _visible.Add(free.Index);
    }

    private void ClearChannel(int i)
    {
        _channels[i] = (_channels[i].Index, "", "");
        _visible.Remove(_channels[i].Index);
        _clearedKeys.Add(_channels[i].Index);
    }

    // Cleared rows must actually wipe the stored key, so they are exempt from the
    // "empty box = keep existing key" rule applied on save.
    private readonly HashSet<int> _clearedKeys = new();

    private static int? ParseNullableInt(string? s) =>
        int.TryParse(s, out var v) && v > 0 ? v : null;

    private bool IsRaceEnabled(string? irc) =>
        !string.IsNullOrWhiteSpace(irc) &&
        _cfg.RaceSectionsEnabled.Contains(irc, StringComparer.OrdinalIgnoreCase);

    private void SetRaceEnabled(string? irc, bool on)
    {
        if (string.IsNullOrWhiteSpace(irc)) return;

        _cfg.RaceSectionsEnabled.RemoveAll(x => string.Equals(x, irc, StringComparison.OrdinalIgnoreCase));
        if (on) _cfg.RaceSectionsEnabled.Add(irc);
    }

    private void ToggleRaceEnabled(Section sec)
    {
        if (string.IsNullOrWhiteSpace(sec.IrcName)) return;
        SetRaceEnabled(sec.IrcName, !IsRaceEnabled(sec.IrcName));
    }

    private void ToggleRaceEnabledFromKey(KeyboardEventArgs e, Section sec)
    {
        if (e.Key is "Enter" or " ")
            ToggleRaceEnabled(sec);
    }

    private int SelectedSectionIndex =>
        _cfg.Sections.Count == 0 ? -1 : Math.Clamp(_selectedSectionIndex, 0, _cfg.Sections.Count - 1);

    private Section? SelectedSection =>
        SelectedSectionIndex >= 0 ? _cfg.Sections[SelectedSectionIndex] : null;

    /// <summary>
    /// Rail contents. The original index travels with each row: selection is stored as an
    /// index into _cfg.Sections, so filtering must not renumber anything.
    /// </summary>
    private List<(int Index, Section Section)> FilteredSections
    {
        get
        {
            var all = _cfg.Sections.Select((s, i) => (Index: i, Section: s));
            var q = _sectionFilter.Trim();

            if (q.Length == 0) return all.ToList();

            return all
                .Where(e => DisplaySectionName(e.Section).Contains(q, StringComparison.OrdinalIgnoreCase)
                         || (e.Section.Tags ?? new List<Tag>())
                                .Any(t => (t.MapCbftpSection ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

    private void NormalizeSelectedSection()
    {
        if (_cfg.Sections.Count == 0) _selectedSectionIndex = -1;
        else if (_selectedSectionIndex < 0) _selectedSectionIndex = 0;
        else if (_selectedSectionIndex >= _cfg.Sections.Count) _selectedSectionIndex = _cfg.Sections.Count - 1;
    }

    private void SelectSection(int index)
    {
        _selectedSectionIndex = index;
        NormalizeSelectedSection();
    }

    private void SetSectionName(Section sec, string? value)
    {
        var oldName = sec.IrcName;
        var wasEnabled = IsRaceEnabled(oldName);
        var nextName = value ?? "";

        if (!string.Equals(oldName, nextName, StringComparison.OrdinalIgnoreCase))
            _cfg.RaceSectionsEnabled.RemoveAll(x => string.Equals(x, oldName, StringComparison.OrdinalIgnoreCase));

        sec.IrcName = nextName;

        if (wasEnabled && !string.IsNullOrWhiteSpace(nextName))
            SetRaceEnabled(nextName, true);
    }

    private void RemoveSection(Section sec)
    {
        _cfg.RaceSectionsEnabled.RemoveAll(x => string.Equals(x, sec.IrcName, StringComparison.OrdinalIgnoreCase));
        _cfg.Sections.Remove(sec);
        NormalizeSelectedSection();
    }

    private static string DisplaySectionName(Section sec) =>
        string.IsNullOrWhiteSpace(sec.IrcName) ? "Untitled section" : sec.IrcName.Trim();

    private static string MappingSummary(Section sec)
    {
        var mapped = (sec.Tags ?? new List<Tag>())
            .Select(t => t.MapCbftpSection)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(3)
            .ToList();

        if (mapped.Count == 0) return "No CBFTP mappings";

        var suffix = (sec.Tags?.Count ?? 0) > mapped.Count ? $" +{(sec.Tags?.Count ?? 0) - mapped.Count}" : "";
        return string.Join(", ", mapped) + suffix;
    }

    // ---- IMDB / TVMaze filter helpers -------------------------------------------------
    // Both are stored as free-form JObjects on the section (the engine reads them by key),
    // so the editor reads and writes individual keys rather than binding to a typed model.

    private static bool IsEnabled(JObject? o) => o?["enabled"]?.Value<bool>() == true;

    private static void ToggleFilter(Section sec, bool imdb, bool on)
    {
        var current = imdb ? sec.Imdb : sec.Tvmaze;

        if (on)
        {
            current ??= new JObject();
            current["enabled"] = true;
            // Sensible default: an unreachable lookup service should not silently stop
            // the site from racing.
            current["fallback_on_error"] ??= true;
            if (!imdb)
            {
                current["skip_ended_shows"] ??= true;
                current["cache_duration_days"] ??= 7;
            }
        }
        else if (current != null)
        {
            current["enabled"] = false;
        }

        if (imdb) sec.Imdb = current; else sec.Tvmaze = current;
    }

    private static string Get(JObject? o, string key) => o?[key]?.ToString() ?? "";

    private static void Set(JObject? o, string key, string? value)
    {
        if (o is null) return;

        if (string.IsNullOrWhiteSpace(value)) o.Remove(key);
        else o[key] = value.Trim();
    }

    private static bool GetBool(JObject? o, string key) => o?[key]?.Value<bool>() == true;

    private static void SetBool(JObject? o, string key, ChangeEventArgs e)
    {
        if (o is null) return;
        o[key] = (bool)(e.Value ?? false);
    }

    private static List<string> GetStringList(JObject? o, string key)
    {
        var token = o?[key];
        if (token is null) return new List<string>();

        if (token.Type == JTokenType.Array)
        {
            return token.Values<string>()
                .Where(v => !string.IsNullOrWhiteSpace(v))
                .Select(v => v!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        return SplitListText(token.ToString()).ToList();
    }

    private static IEnumerable<string> SplitListText(string? value) =>
        (value ?? "")
            .Split(new[] { ',', '|' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(v => !string.IsNullOrWhiteSpace(v));

    private static string GetListText(JObject? o, string key) =>
        string.Join(", ", GetStringList(o, key));

    private static void SetListText(JObject? o, string key, string? value) =>
        SetList(o, key, SplitListText(value));

    private static void SetList(JObject? o, string key, IEnumerable<string> values)
    {
        if (o is null) return;

        var clean = values
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Select(v => v.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (clean.Count == 0) o.Remove(key);
        else o[key] = JArray.FromObject(clean);
    }

    private static bool ListContains(JObject? o, string key, string value) =>
        GetStringList(o, key).Contains(value, StringComparer.OrdinalIgnoreCase);

    private static void SetListItem(JObject? o, string key, string value, bool enabled)
    {
        if (o is null || string.IsNullOrWhiteSpace(value)) return;

        var list = GetStringList(o, key);
        var existingIndex = list.FindIndex(v => string.Equals(v, value, StringComparison.OrdinalIgnoreCase));

        if (enabled && existingIndex < 0)
            list.Add(value.Trim());
        else if (!enabled && existingIndex >= 0)
            list.RemoveAt(existingIndex);

        SetList(o, key, list);
    }

    private static string[] OptionsWithSelected(IEnumerable<string> options, JObject? o, string key) =>
        options
            .Concat(GetStringList(o, key))
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private void AddSection()
    {
        _cfg.Sections.Add(new Section { Tags = new List<Tag>(), Rules = new List<string>() });
        _selectedSectionIndex = _cfg.Sections.Count - 1;
    }

    private void AddTag(Section sec)
    {
        sec.Tags ??= new List<Tag>();
        sec.Tags.Add(new Tag { Rules = new List<string>() });
    }

    private static void RemoveTag(Section sec, Tag tag) => sec.Tags?.Remove(tag);

    private static void AddSectionRule(Section sec)
    {
        sec.Rules ??= new List<string>();
        sec.Rules.Add("");
    }

    private static void SetSectionRule(Section sec, int index, string? value)
    {
        if (sec.Rules is null || index < 0 || index >= sec.Rules.Count) return;
        sec.Rules[index] = value ?? "";
    }

    private static void RemoveSectionRule(Section sec, int index)
    {
        if (sec.Rules is null || index < 0 || index >= sec.Rules.Count) return;
        sec.Rules.RemoveAt(index);
    }

    private void BeginSectionRuleDrag(Section sec, int index)
    {
        _dragSectionRuleOwner = sec;
        _dragTagRuleOwner = null;
        _dragRuleIndex = index;
    }

    private void DropSectionRule(Section sec, int targetIndex)
    {
        if (!ReferenceEquals(_dragSectionRuleOwner, sec)) return;
        MoveRule(sec.Rules, _dragRuleIndex, targetIndex);
        ClearRuleDrag();
    }

    private static void AddTagRule(Tag tag)
    {
        tag.Rules ??= new List<string>();
        tag.Rules.Add("");
    }

    private static void SetTagRule(Tag tag, int index, string? value)
    {
        if (tag.Rules is null || index < 0 || index >= tag.Rules.Count) return;
        tag.Rules[index] = value ?? "";
    }

    private static void RemoveTagRule(Tag tag, int index)
    {
        if (tag.Rules is null || index < 0 || index >= tag.Rules.Count) return;
        tag.Rules.RemoveAt(index);
    }

    private void BeginTagRuleDrag(Tag tag, int index)
    {
        _dragTagRuleOwner = tag;
        _dragSectionRuleOwner = null;
        _dragRuleIndex = index;
    }

    private void DropTagRule(Tag tag, int targetIndex)
    {
        if (!ReferenceEquals(_dragTagRuleOwner, tag)) return;
        MoveRule(tag.Rules, _dragRuleIndex, targetIndex);
        ClearRuleDrag();
    }

    private void ClearRuleDrag()
    {
        _dragSectionRuleOwner = null;
        _dragTagRuleOwner = null;
        _dragRuleIndex = -1;
    }

    private static void MoveRule(List<string>? rules, int fromIndex, int targetIndex)
    {
        if (rules is null ||
            fromIndex < 0 ||
            targetIndex < 0 ||
            fromIndex >= rules.Count ||
            targetIndex >= rules.Count ||
            fromIndex == targetIndex)
        {
            return;
        }

        var value = rules[fromIndex];
        rules.RemoveAt(fromIndex);
        rules.Insert(targetIndex, value);
    }

    private void AddAffil()
    {
        var v = _newAffil.Trim().ToUpperInvariant();
        if (v.Length > 0 && !_cfg.Affils.Contains(v, StringComparer.OrdinalIgnoreCase))
            _cfg.Affils.Add(v);
        _newAffil = "";
    }

    private void AddBlacklist()
    {
        var v = _newBlacklist.Trim();
        if (v.Length > 0 && !_cfg.GlobalBlacklist.Contains(v, StringComparer.OrdinalIgnoreCase))
            _cfg.GlobalBlacklist.Add(v);
        _newBlacklist = "";
    }

    private async Task ShowSiteRules()
    {
        try
        {
            _loadingRules = true;
            _error = null;
            var siteName = S.Sitename?.Trim();
            if (string.IsNullOrWhiteSpace(siteName))
            {
                _error = "Enter a site name before loading CBFTP site rules.";
                return;
            }

            var rules = await CbftpRacer.GetSiteRulesTextAsync(siteName);
            _rulesText = string.IsNullOrWhiteSpace(rules) ? "No rules returned from CBFTP." : rules;
            _showRules = true;
            _status = $"Loaded CBFTP site rules for {siteName}.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loadingRules = false;
        }
    }

    private void CloseRules() => _showRules = false;

    private void Save()
    {
        try
        {
            _error = null;

            S.MaxPreTime = _maxPreTime > 0 ? _maxPreTime : null;

            if (!string.IsNullOrEmpty(_password))
                Sv.Password = _password;

            // Empty key box = keep whatever was stored, rather than wiping it - except
            // for rows the user explicitly cleared.
            var merged = _channels.Select(c =>
            {
                if (!string.IsNullOrEmpty(c.Key) || _stored is null || _clearedKeys.Contains(c.Index))
                    return c;

                var kept = _stored.SiteSettings?.GetType()
                    .GetProperty($"BlowfishKey{c.Index}")?.GetValue(_stored.SiteSettings) as string;

                return (c.Index, c.Channel, kept ?? "");
            }).ToList();

            SiteStore.WriteChannels(S, merged);

            Store.Save(_cfg, _isNew ? null : _originalName);

            // Pick up request auto-fill changes immediately. The runner snapshots its
            // site list when it starts, so without this, ticking "Auto-fill enabled"
            // did nothing until the racer was stopped and started again.
            Engine.RefreshRequestAutoFill();

            Nav.NavigateTo("sites");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
