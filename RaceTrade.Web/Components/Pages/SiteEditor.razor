                    @* Mappings and section rules side by side: they are read together when
                       working out where a release will land, and stacking them pushed the
                       rules below the fold on a 1080p screen. *@
                    <div class="section-columns">
                    <div class="section-block">
                        <div class="section-block-head">
                            <div>
                                <h2>CBFTP mappings <span class="count-badge">@mappingCount</span></h2>
                                <p class="fh">Use more than one mapping when one IRC section needs different CBFTP targets.</p>
                            </div>
                            <button class="btn" @onclick="() => AddTag(selected)"><Icon Name="plus" Size="13" /><span>Add mapping</span></button>
                        </div>

                        @if ((selected.Tags?.Count ?? 0) == 0)
                        {
                            <div class="empty compact">No mappings yet.</div>
                        }
                        else
                        {
                            <div class="mapping-cards">
                                @for (var t = 0; t < (selected.Tags?.Count ?? 0); t++)
                                {
                                    var tagIndex = t;
                                    var tag = selected.Tags![tagIndex];
                                    var isFallback = string.IsNullOrWhiteSpace(tag.TriggerRegex);
                                    <div class="mapping-card">
                                        <div class="mapping-card-head">
                                            <span class="mapping-index">@(tagIndex + 1)</span>
                                            <span class="mapping-title">
                                                @(string.IsNullOrWhiteSpace(tag.MapCbftpSection) ? "unnamed target" : tag.MapCbftpSection)
                                            </span>
                                            <span class="mini-pill @(isFallback ? "" : "info")">
                                                @(isFallback ? "fallback" : "conditional")
                                            </span>
                                            <span class="spacer"></span>
                                            <button class="btn danger sm mapping-remove" title="Remove mapping" @onclick="() => RemoveTag(selected, tag)">&times;</button>
                                        </div>

                                        <div class="mapping-card-grid">
                                            <label>
                                                <span>CBFTP section</span>
                                                <input type="text" value="@tag.MapCbftpSection"
                                                       @oninput="e => tag.MapCbftpSection = e.Value?.ToString()" placeholder="TV" />
                                            </label>
                                            <label>
                                                <span>Trigger regex <em>on release name - empty = catch-all</em></span>
                                                <input type="text" class="mono" value="@tag.TriggerRegex"
                                                       @oninput="e => tag.TriggerRegex = e.Value?.ToString()"
                                                       placeholder="2160p|UHD|HEVC" />
                                            </label>
                                        </div>

                                        <div class="rules-box mapping-rules-box">
                                            <div class="rules-head">
                                                <div>
                                                    <strong>Mapping rules <span class="count-badge">@(tag.Rules?.Count ?? 0)</span></strong>
                                                    <span>DROP runs before ALLOW. These apply only to this mapping.</span>
                                                </div>
                                                <button class="btn sm" @onclick="() => AddTagRule(tag)">
                                                    <Icon Name="plus" Size="12" /><span>Add rule</span>
                                                </button>
                                            </div>

                                            @if ((tag.Rules?.Count ?? 0) == 0)
                                            {
                                                <div class="empty rule-empty">No mapping rules.</div>
                                            }
                                            else
                                            {
                                                <div class="rule-rows">
                                                    @for (var r = 0; r < (tag.Rules?.Count ?? 0); r++)
                                                    {
                                                        var ruleIndex = r;
                                                        @* dragenter AND dragover must both preventDefault or the browser
                                                           refuses the drop; dragover alone is not enough once the pointer
                                                           is over the <input>, which is a drop target of its own. *@
                                                        <div class="rule-row"
                                                             @ondragenter:preventDefault="true"
                                                             @ondragover:preventDefault="true"
                                                             @ondrop:preventDefault="true"
                                                             @ondrop="() => DropTagRule(tag, ruleIndex)">
                                                            @* pointerdown, not dragstart: the source index is recorded
                                                               before the browser even begins the drag. And no dragend
                                                               handler - dragend races the drop over the SignalR circuit
                                                               and cleared the state before the drop could use it. *@
                                                            <span class="drag-grip"
                                                                  title="Drag to reorder"
                                                                  draggable="true"
                                                                  @onpointerdown="() => BeginTagRuleDrag(tag, ruleIndex)">::</span>
                                                            @* draggable=false: without it the input starts its own text
                                                               drag and swallows the one that matters. *@
                                                            <input type="text"
                                                                   draggable="false"
                                                                   value="@tag.Rules![ruleIndex]"
                                                                   @oninput="e => SetTagRule(tag, ruleIndex, e.Value?.ToString())"
                                                                   placeholder="[release] contains 720p DROP" />
                                                            <span class="rule-move">
                                                                <button class="btn sm" title="Move up"
                                                                        disabled="@(ruleIndex == 0)"
                                                                        @onclick="() => MoveRule(tag.Rules, ruleIndex, ruleIndex - 1)">&#9650;</button>
                                                                <button class="btn sm" title="Move down"
                                                                        disabled="@(ruleIndex == tag.Rules!.Count - 1)"
                                                                        @onclick="() => MoveRule(tag.Rules, ruleIndex, ruleIndex + 1)">&#9660;</button>
                                                            </span>
                                                            <button class="btn danger sm" title="Remove rule" @onclick="() => RemoveTagRule(tag, ruleIndex)">&times;</button>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @* Matches the wording in Help > "Section routing and mappings".
                           Everything here is what RaceHelper.GetMappedCbftpSection actually
                           does: unanchored Regex.IsMatch against the RELEASE NAME, case
                           sensitive unless written as /pattern/i, mappings walked in order. *@
                        <details class="trigger-help">
                            <summary>How the trigger regex works</summary>
                            <div class="regex-example-list">
                                <div>
                                    <span>Tested against</span>
                                    <code>The release name only - not the announce line, not the section.</code>
                                </div>
                                <div>
                                    <span>Match type</span>
                                    <code>Anywhere in the name. "1080p" matches "Some.Show.1080p.WEB-GRP".</code>
                                </div>
                                <div>
                                    <span>Case</span>
                                    <code>Case sensitive. Write /1080p/i to ignore case.</code>
                                </div>
                                <div>
                                    <span>Empty</span>
                                    <code>Catch-all. Keep it as the LAST mapping.</code>
                                </div>
                                <div>
                                    <span>Order</span>
                                    <code>Top to bottom; first mapping that matches and is not dropped by a rule wins.</code>
                                </div>
                            </div>
                            <div class="regex-example-list">
                                <div>
                                    <span>1. CBFTP TV-2160P</span>
                                    <code>2160p|UHD|HEVC</code>
                                </div>
                                <div>
                                    <span>2. CBFTP TV-1080P</span>
                                    <code>/1080p|x264|h264/i</code>
                                </div>
                                <div>
                                    <span>3. CBFTP TV</span>
                                    <code>(empty - everything else)</code>
                                </div>
                            </div>
                            <p class="fh">
                                An invalid pattern is logged as an error and that mapping is skipped,
                                so the release can silently end up in the next mapping.
                            </p>
                        </details>
                    </div>

                    <div class="section-block">
                        <div class="section-block-head">
                            <div>
                                <h2>Section rules <span class="count-badge">@sectionRuleCount</span></h2>
                                <p class="fh">Global filters for this IRC section. Section DROP takes priority over ALLOW.</p>
                            </div>
                            <button class="btn" @onclick="() => AddSectionRule(selected)">
                                <Icon Name="plus" Size="13" /><span>Add rule</span>
                            </button>
                        </div>

                        <div class="rules-box section-rules-box">
                            @if ((selected.Rules?.Count ?? 0) == 0)
                            {
                                <div class="empty rule-empty">No section rules.</div>
                            }
                            else
                            {
                                <div class="rule-rows">
                                    @for (var r = 0; r < (selected.Rules?.Count ?? 0); r++)
                                    {
                                        var ruleIndex = r;
                                        <div class="rule-row"
                                             @ondragenter:preventDefault="true"
                                             @ondragover:preventDefault="true"
                                             @ondrop:preventDefault="true"
                                             @ondrop="() => DropSectionRule(selected, ruleIndex)">
                                            <span class="drag-grip"
                                                  title="Drag to reorder"
                                                  draggable="true"
                                                  @onpointerdown="() => BeginSectionRuleDrag(selected, ruleIndex)">::</span>
                                            <input type="text"
                                                   draggable="false"
                                                   value="@selected.Rules![ruleIndex]"
                                                   @oninput="e => SetSectionRule(selected, ruleIndex, e.Value?.ToString())"
                                                   placeholder="[release] matches (?i)\bFRENCH\b DROP" />
                                            <span class="rule-move">
                                                <button class="btn sm" title="Move up"
                                                        disabled="@(ruleIndex == 0)"
                                                        @onclick="() => MoveRule(selected.Rules, ruleIndex, ruleIndex - 1)">&#9650;</button>
                                                <button class="btn sm" title="Move down"
                                                        disabled="@(ruleIndex == selected.Rules!.Count - 1)"
                                                        @onclick="() => MoveRule(selected.Rules, ruleIndex, ruleIndex + 1)">&#9660;</button>
                                            </span>
                                            <button class="btn danger sm" title="Remove rule" @onclick="() => RemoveSectionRule(selected, ruleIndex)">&times;</button>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="fh rule-help">
                                Format: <code>[release] contains INTERNAL DROP</code>,
                                <code>[group] isin BadGroup1,BadGroup2 DROP</code>, or
                                <code>[release] contains 1080p ALLOW</code>.
                            </div>
                        </div>
                    </div>
                    </div>

