@page "/fxp"
@inject FxpClientService Fxp

<PageTitle>FXP Client - RaceTrade</PageTitle>

<div class="fxp-page">
    <div class="page-head fxp-head">
        <h1><Icon Name="fxp" Size="18" />FXP Client</h1>
    </div>

    <div class="panel fxp-shell">
        <div class="toolbar fxp-toolbar">
            <label>CBFTP</label>
            <select value="@_serverId" @onchange="SelectServer" disabled="@Busy">
                @foreach (var server in _servers)
                {
                    <option value="@server.Id">@DisplayServer(server)</option>
                }
            </select>
            <button class="btn" @onclick="ReloadServersAndSites" disabled="@Busy">
                <Icon Name="refresh" Size="13" />
                <span>Load sites</span>
            </button>
            <button class="btn" @onclick="LoadSites" disabled="@(!_servers.Any() || Busy)">
                <Icon Name="refresh" Size="13" />
                <span>Refresh sites</span>
            </button>
            <span class="spacer"></span>
            <button class="btn primary" @onclick="() => Transfer(true)" disabled="@(!CanTransferLeftToRight || Busy)">
                <Icon Name="send" Size="13" />
                <span>Left to right</span>
            </button>
            <button class="btn primary" @onclick="() => Transfer(false)" disabled="@(!CanTransferRightToLeft || Busy)">
                <Icon Name="send" Size="13" />
                <span>Right to left</span>
            </button>
        </div>

        <div class="fxp-panes">
            @Pane("left", "Left Site", _leftSite, SelectLeftSite, _leftPath, v => _leftPath = v, _leftItems, _selectedLeft, BrowseLeft, UpLeft, DeleteLeft)
            @Pane("right", "Right Site", _rightSite, SelectRightSite, _rightPath, v => _rightPath = v, _rightItems, _selectedRight, BrowseRight, UpRight, DeleteRight)
        </div>

        @* Live job list. cbftp accepting the POST only means the job was created; whether it
           actually moves bytes is a separate question, and this is where it gets answered. *@
        @if (_jobs.Count > 0)
        {
            <div class="fxp-log fxp-active-log">
                <div class="card-title">ACTIVE TRANSFERS</div>
                <div class="fxp-jobs">
                    @foreach (var j in _jobs)
                    {
                        <div class="job @JobClass(j)">
                            <div class="job-head">
                                <span class="job-badge">@JobLabel(j)</span>
                                <span class="job-name">@j.Name</span>
                                <span class="spacer"></span>
                                <span class="job-meta">@JobDetail(j)</span>
                            </div>

                            @* Indeterminate when cbftp reports no file counts: a bar parked at
                               0% reads as "stuck", which is exactly the wrong impression. *@
                            <div class="job-bar @(j.Percent is null && !j.IsFinished ? "indet" : "")">
                                <div class="job-fill" style="width:@(j.Percent ?? 100)%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="fxp-log fxp-transfer-log">
            <div class="card-title">FXP LOG</div>
            <div class="log-box">
                @if (_log.Count == 0)
                {
                    <div class="dim">No FXP activity yet.</div>
                }
                else
                {
                    @foreach (var line in _log)
                    {
                        <div>@line</div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@if (_contextMenu is not null)
{
    <div class="context-backdrop" @onclick="CloseContextMenu"></div>
    <div class="fxp-context-menu" style="@ContextMenuStyle" @onclick:stopPropagation="true">
        <button type="button" @onclick="ContextOpen" disabled="@(!_contextMenu.Item.IsDirectory || Busy)">Open</button>
        <button type="button" @onclick="ContextTransfer" disabled="@(!CanContextTransfer || Busy)">
            @(_contextMenu.Side == "left" ? "FXP to right" : "FXP to left")
        </button>
        <button type="button" @onclick="ContextDelete" disabled="@(!ContextHasSelection || Busy)">Delete selected</button>
        <button type="button" @onclick="ContextRefresh" disabled="@Busy">Refresh</button>
    </div>
}

@code {
    private sealed record FxpContextMenu(string Side, FxpFileItem Item, double X, double Y);

    private List<CbftpServer> _servers = new();
    private List<string> _sites = new();
    private string _serverId = "";
    private string _leftSite = "";
    private string _rightSite = "";
    private string _leftPath = "/";
    private string _rightPath = "/";
    private IReadOnlyList<FxpFileItem> _leftItems = Array.Empty<FxpFileItem>();
    private IReadOnlyList<FxpFileItem> _rightItems = Array.Empty<FxpFileItem>();
    private readonly HashSet<string> _selectedLeft = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _selectedRight = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<string> _log = new();

    // Jobs we queued this session, newest first, updated by MonitorJobsAsync.
    private readonly List<FxpJobProgress> _jobs = new();
    private FxpContextMenu? _contextMenu;
    private string _leftSort = "name";
    private string _rightSort = "name";
    private bool _leftSortDesc;
    private bool _rightSortDesc;
    private bool Busy { get; set; }
    private bool CanTransferLeftToRight =>
        SelectedLeftItems.Any() && !string.IsNullOrWhiteSpace(_leftSite) && !string.IsNullOrWhiteSpace(_rightSite);

    private bool CanTransferRightToLeft =>
        SelectedRightItems.Any() && !string.IsNullOrWhiteSpace(_leftSite) && !string.IsNullOrWhiteSpace(_rightSite);

    private IEnumerable<FxpFileItem> SelectedLeftItems => _leftItems.Where(i => _selectedLeft.Contains(i.FullPath));
    private IEnumerable<FxpFileItem> SelectedRightItems => _rightItems.Where(i => _selectedRight.Contains(i.FullPath));
    private string ContextMenuStyle => _contextMenu is null ? "" : $"left: {_contextMenu.X}px; top: {_contextMenu.Y}px;";

    protected override async Task OnInitializedAsync()
    {
        _servers = Fxp.LoadServers().ToList();
        _serverId = _servers.FirstOrDefault()?.Id ?? "";
        if (!string.IsNullOrWhiteSpace(_serverId))
            await LoadSites();
    }

    private RenderFragment Pane(
        string side,
        string title,
        string site,
        Func<string, Task> selectSite,
        string path,
        Action<string> setPath,
        IReadOnlyList<FxpFileItem> items,
        HashSet<string> selected,
        Func<Task> browse,
        Func<Task> up,
        Func<Task> delete) => @<div class="fxp-pane">
        @{
            var sortedItems = SortItems(side, items);
        }
        <div class="fxp-pane-head">
            <h2>@title</h2>
            <select value="@site" @onchange="e => selectSite(e.Value?.ToString() ?? string.Empty)" disabled="@(!_sites.Any() || Busy)">
                <option value="">Select site</option>
                @foreach (var s in _sites)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="path-row">
            <input type="text" value="@path" @oninput="e => setPath(e.Value?.ToString() ?? string.Empty)" />
            <button class="btn" @onclick="up" disabled="@Busy">Up</button>
            <button class="btn" @onclick="browse" disabled="@Busy"><Icon Name="refresh" Size="13" /><span>Refresh</span></button>
        </div>
        <div class="fxp-table-wrap">
            <table class="grid fxp-table">
                <thead>
                    <tr>
                        <th></th>
                        <th><button type="button" class='@SortHeaderClass(side, "name")' @onclick='@(() => SetSort(side, "name"))'>NAME <span>@SortGlyph(side, "name")</span></button></th>
                        <th><button type="button" class='@SortHeaderClass(side, "size")' @onclick='@(() => SetSort(side, "size"))'>SIZE <span>@SortGlyph(side, "size")</span></button></th>
                        <th><button type="button" class='@SortHeaderClass(side, "modified")' @onclick='@(() => SetSort(side, "modified"))'>MODIFIED <span>@SortGlyph(side, "modified")</span></button></th>
                    </tr>
                </thead>
                <tbody>
                    @* Parent-directory row, the way every FTP client does it: always the
                       first row, no checkbox, single click goes up. Hidden at the root,
                       where there is nothing above to go to. *@
                    @if (!IsRootPath(path))
                    {
                        <tr class="dir parent-row" @onclick="up">
                            <td></td>
                            @* The flex lives on a span, not on the td: display:flex on a
                               table cell takes it out of the table layout and the row
                               stops lining up with the columns below it. *@
                            <td class="site" colspan="3">
                                <span class="parent-cell">
                                    <Icon Name="back" Size="13" Class="parent-arrow" />
                                    <span class="parent-dots">..</span>
                                    <span class="parent-label">Parent Directory</span>
                                </span>
                            </td>
                        </tr>
                    }

                    @if (sortedItems.Count == 0)
                    {
                        <tr><td colspan="4" class="dim empty-listing">No listing loaded.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in sortedItems)
                        {
                            <tr class="@(item.IsSymlink ? "link" : item.IsDirectory ? "dir" : "")"
                                @ondblclick="() => OpenItem(side, item)"
                                @oncontextmenu="e => OpenContextMenu(side, item, selected, e)"
                                @oncontextmenu:preventDefault>
                                <td><input type="checkbox" checked="@selected.Contains(item.FullPath)" @onchange="e => Toggle(selected, item.FullPath, e.Value)" /></td>
                                <td class="site">@item.DisplayName</td>
                                <td>@item.TypeText</td>
                                <td class="dim">@item.ModifiedText</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="form-actions">
            <button class="btn danger" @onclick="delete" disabled="@(selected.Count == 0 || Busy)">
                <Icon Name="trash" Size="13" />
                <span>Delete selected</span>
            </button>
        </div>
    </div>;

    /// <summary>True for "/" or an empty path — there is no parent to show.</summary>
    private static bool IsRootPath(string path) =>
        string.IsNullOrWhiteSpace(path) || path.Trim() == "/";

    private async Task LoadSites()
    {
        var server = SelectedServer();
        if (server is null)
        {
            AddLine("Add a CBFTP server first.", isError: true);
            return;
        }

        await RunAsync(async () =>
        {
            AddLine($"Loading sites from {DisplayServer(server)}...");
            _sites = (await Fxp.FetchSitesAsync(server)).ToList();
            _leftSite = KeepOrEmpty(_leftSite);
            _rightSite = KeepOrEmpty(_rightSite);

            if (string.IsNullOrWhiteSpace(_leftSite))
                ClearPane(left: true);
            if (string.IsNullOrWhiteSpace(_rightSite))
                ClearPane(left: false);

            AddLine(_sites.Count == 0
                ? "No sites returned by CBFTP."
                : $"Loaded {_sites.Count} site(s). Pick a site in a pane to browse it.");
        });
    }

    private async Task ReloadServersAndSites()
    {
        _servers = Fxp.LoadServers().ToList();
        if (!_servers.Any())
        {
            _serverId = "";
            _sites.Clear();
            ClearPane(left: true);
            ClearPane(left: false);
            AddLine("Add a CBFTP server first.", isError: true);
            return;
        }

        if (!_servers.Any(s => string.Equals(s.Id, _serverId, StringComparison.OrdinalIgnoreCase)))
            _serverId = _servers.First().Id;

        await LoadSites();
    }

    private async Task SelectServer(ChangeEventArgs e)
    {
        _serverId = e.Value?.ToString() ?? "";
        _sites.Clear();
        _leftSite = "";
        _rightSite = "";
        _leftPath = "/";
        _rightPath = "/";
        _leftItems = Array.Empty<FxpFileItem>();
        _rightItems = Array.Empty<FxpFileItem>();
        _selectedLeft.Clear();
        _selectedRight.Clear();
        CloseContextMenu();

        if (!string.IsNullOrWhiteSpace(_serverId))
            await LoadSites();
    }

    private async Task SelectLeftSite(string site)
    {
        _leftSite = site;
        _leftPath = "/";
        _leftItems = Array.Empty<FxpFileItem>();
        _selectedLeft.Clear();
        CloseContextMenu();

        if (!string.IsNullOrWhiteSpace(_leftSite))
            await BrowseLeft();
    }

    private async Task SelectRightSite(string site)
    {
        _rightSite = site;
        _rightPath = "/";
        _rightItems = Array.Empty<FxpFileItem>();
        _selectedRight.Clear();
        CloseContextMenu();

        if (!string.IsNullOrWhiteSpace(_rightSite))
            await BrowseRight();
    }

    private async Task BrowseLeft() => await Browse(true);
    private async Task BrowseRight() => await Browse(false);

    private async Task Browse(bool left)
    {
        var server = SelectedServer();
        var site = left ? _leftSite : _rightSite;
        var path = left ? _leftPath : _rightPath;
        if (server is null || string.IsNullOrWhiteSpace(site))
        {
            AddLine("Select a CBFTP server and site first.", isError: true);
            return;
        }

        await RunAsync(async () =>
        {
            var items = await Fxp.BrowseAsync(server, site, path);
            if (left)
            {
                _leftItems = items;
                _selectedLeft.Clear();
                _leftPath = FxpClientService.NormalizePath(_leftPath);
            }
            else
            {
                _rightItems = items;
                _selectedRight.Clear();
                _rightPath = FxpClientService.NormalizePath(_rightPath);
            }

            AddLine($"Listed {items.Count} item(s) from {site}:{FxpClientService.NormalizePath(path)}.");
        });
    }

    private async Task UpLeft()
    {
        _leftPath = FxpClientService.ParentPath(_leftPath);
        await BrowseLeft();
    }

    private async Task UpRight()
    {
        _rightPath = FxpClientService.ParentPath(_rightPath);
        await BrowseRight();
    }

    private async Task OpenItem(string side, FxpFileItem item)
    {
        if (!item.IsDirectory)
            return;

        if (side == "left")
        {
            _leftPath = item.IsSymlink && !string.IsNullOrWhiteSpace(item.LinkTarget)
                ? FxpClientService.NormalizePath(item.LinkTarget)
                : item.FullPath;
            await BrowseLeft();
        }
        else
        {
            _rightPath = item.IsSymlink && !string.IsNullOrWhiteSpace(item.LinkTarget)
                ? FxpClientService.NormalizePath(item.LinkTarget)
                : item.FullPath;
            await BrowseRight();
        }
    }

    private async Task Transfer(bool leftToRight)
    {
        var server = SelectedServer();
        if (server is null)
            return;

        IReadOnlyList<string> queued = Array.Empty<string>();

        await RunAsync(async () =>
        {
            var result = leftToRight
                ? await Fxp.QueueTransferAsync(server, _leftSite, _leftPath, _rightSite, _rightPath, SelectedLeftItems)
                : await Fxp.QueueTransferAsync(server, _rightSite, _rightPath, _leftSite, _leftPath, SelectedRightItems);

            AddLog(result);
            queued = result.Queued ?? Array.Empty<string>();
        });

        // Started after RunAsync so the buttons are usable again while it runs; the old
        // WinForms client did the same with a fire-and-forget MonitorTransferProgressAsync.
        if (queued.Count > 0)
            _ = MonitorJobsAsync(queued);
    }

    /// <summary>
    /// Polls cbftp until every queued job reaches DONE/FAILED/TIMEOUT, or five minutes
    /// pass. Both panes are refreshed at the end so the moved files actually show up.
    /// </summary>
    private async Task MonitorJobsAsync(IReadOnlyList<string> names)
    {
        var pending = names.ToList();

        // cbftp needs a moment before the job is queryable.
        await Task.Delay(2000);

        for (var i = 0; i < 60 && pending.Count > 0; i++)
        {
            foreach (var name in pending.ToList())
            {
                var progress = await Fxp.GetJobProgressAsync(name);

                if (progress is null)
                {
                    // Unknown to cbftp. Right after queueing that is normal; after a few
                    // rounds it means the job never materialised, which is worth saying.
                    if (i >= 3)
                    {
                        UpsertJob(new FxpJobProgress(name, "UNKNOWN", 0, 0, 0, 0, TimeSpan.Zero));
                        AddLine($"cbftp does not know job '{name}' — it was accepted but never created.");
                        pending.Remove(name);
                    }
                    continue;
                }

                UpsertJob(progress);

                if (progress.IsFinished)
                {
                    pending.Remove(name);
                    AddLine(progress.IsFailed
                        ? $"Failed: {name} ({progress.Status})"
                        : $"Complete: {name} — {FxpClientService.FormatSize(progress.BytesTransferred)}");
                }
            }

            await InvokeAsync(StateHasChanged);

            if (pending.Count > 0)
                await Task.Delay(5000);
        }

        if (pending.Count > 0)
            AddLine($"Still running after 5 minutes: {string.Join(", ", pending)}");

        try
        {
            await BrowseLeft();
            await BrowseRight();
        }
        catch
        {
            // A refresh failure must not swallow the transfer result above.
        }

        await InvokeAsync(StateHasChanged);
    }

    private void UpsertJob(FxpJobProgress progress)
    {
        var index = _jobs.FindIndex(j => string.Equals(j.Name, progress.Name, StringComparison.OrdinalIgnoreCase));

        if (index >= 0)
            _jobs[index] = progress;
        else
            _jobs.Insert(0, progress);
    }

    private static string JobLabel(FxpJobProgress j) => j.Status.ToUpperInvariant() switch
    {
        "DONE" => "Done",
        "FAILED" => "Failed",
        "TIMEOUT" => "Timeout",
        "RUNNING" => "Running",
        "UNKNOWN" => "Not found",
        _ => j.Status
    };

    private static string JobClass(FxpJobProgress j) =>
        j.IsFailed || j.IsUnknown ? "job-bad"
        : j.IsDone ? "job-ok"
        : "job-run";

    private static string JobDetail(FxpJobProgress j)
    {
        if (j.IsUnknown)
            return "no such job in cbftp";

        var parts = new List<string>();

        if (j.Percent is { } pct && !j.IsDone)
            parts.Add($"{pct}%");

        if (j.FilesTotal > 0)
            parts.Add($"{j.FilesTransferred}/{j.FilesTotal} files");

        if (j.BytesTransferred > 0)
            parts.Add(FxpClientService.FormatSize(j.BytesTransferred));

        if (j.HasMeaningfulSpeed)
            parts.Add($"{j.AverageSpeed:F1} MB/s");

        if (j.Elapsed.TotalSeconds >= 1)
            parts.Add(j.Elapsed.TotalMinutes >= 1 ? $"{j.Elapsed:mm\\:ss}" : $"{j.Elapsed.TotalSeconds:F0}s");

        return parts.Count > 0 ? string.Join(" · ", parts) : "waiting...";
    }

    private async Task DeleteLeft() => await Delete(true);
    private async Task DeleteRight() => await Delete(false);

    private bool CanContextTransfer =>
        _contextMenu is not null &&
        ((_contextMenu.Side == "left" && CanTransferLeftToRight) ||
         (_contextMenu.Side == "right" && CanTransferRightToLeft));

    private bool ContextHasSelection =>
        _contextMenu is not null &&
        (_contextMenu.Side == "left" ? _selectedLeft.Count > 0 : _selectedRight.Count > 0);

    private void OpenContextMenu(string side, FxpFileItem item, HashSet<string> selected, MouseEventArgs e)
    {
        if (!selected.Contains(item.FullPath))
        {
            selected.Clear();
            selected.Add(item.FullPath);
        }

        _contextMenu = new FxpContextMenu(side, item, e.ClientX, e.ClientY);
    }

    private void CloseContextMenu() => _contextMenu = null;

    private async Task ContextOpen()
    {
        if (_contextMenu is null)
            return;

        var context = _contextMenu;
        CloseContextMenu();
        await OpenItem(context.Side, context.Item);
    }

    private async Task ContextTransfer()
    {
        if (_contextMenu is null)
            return;

        var leftToRight = _contextMenu.Side == "left";
        CloseContextMenu();
        await Transfer(leftToRight);
    }

    private async Task ContextDelete()
    {
        if (_contextMenu is null)
            return;

        var left = _contextMenu.Side == "left";
        CloseContextMenu();
        await Delete(left);
    }

    private async Task ContextRefresh()
    {
        if (_contextMenu is null)
            return;

        var left = _contextMenu.Side == "left";
        CloseContextMenu();
        await Browse(left);
    }

    private async Task Delete(bool left)
    {
        var server = SelectedServer();
        if (server is null)
            return;

        await RunAsync(async () =>
        {
            var result = left
                ? await Fxp.DeleteAsync(server, _leftSite, _leftPath, SelectedLeftItems)
                : await Fxp.DeleteAsync(server, _rightSite, _rightPath, SelectedRightItems);

            AddLog(result);
            await Browse(left);
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            Busy = true;
            await action();
        }
        catch (Exception ex)
        {
            AddLine(ex.Message, isError: true);
        }
        finally
        {
            Busy = false;
        }
    }

    private void AddLog(FxpOperationResult result)
    {
        AddLine(result.Message, isError: !result.Success);
        foreach (var line in result.Logs.Reverse())
            _log.Insert(1, "  " + line);

        Trim();
    }

    private void AddLine(string text, bool isError = false)
    {
        if (string.IsNullOrWhiteSpace(text)) return;

        _log.Insert(0, $"[{DateTime.Now:HH:mm:ss}] {(isError ? "ERROR: " : "")}{text}");
        Trim();
    }

    private void Trim()
    {
        if (_log.Count > 200)
            _log.RemoveRange(200, _log.Count - 200);
    }

    private CbftpServer? SelectedServer() =>
        _servers.FirstOrDefault(s => string.Equals(s.Id, _serverId, StringComparison.OrdinalIgnoreCase));

    private static string DisplayServer(CbftpServer server) =>
        $"{server.Name ?? server.Id} - {server.Host}:{server.Port}";

    private string KeepOrEmpty(string current) =>
        _sites.Contains(current, StringComparer.OrdinalIgnoreCase) ? current : "";

    private void ClearPane(bool left)
    {
        if (left)
        {
            _leftSite = "";
            _leftPath = "/";
            _leftItems = Array.Empty<FxpFileItem>();
            _selectedLeft.Clear();
        }
        else
        {
            _rightSite = "";
            _rightPath = "/";
            _rightItems = Array.Empty<FxpFileItem>();
            _selectedRight.Clear();
        }
    }

    private static void Toggle(HashSet<string> set, string key, object? value)
    {
        var on = value is bool b && b;
        if (on) set.Add(key);
        else set.Remove(key);
    }

    private IReadOnlyList<FxpFileItem> SortItems(string side, IReadOnlyList<FxpFileItem> items)
    {
        var column = side == "left" ? _leftSort : _rightSort;
        var descending = side == "left" ? _leftSortDesc : _rightSortDesc;

        IOrderedEnumerable<FxpFileItem> ordered = items.OrderBy(i => !i.IsDirectory);

        ordered = column switch
        {
            "size" => descending
                ? ordered.ThenByDescending(i => i.Size)
                : ordered.ThenBy(i => i.Size),
            "modified" => descending
                ? ordered.ThenByDescending(i => i.Modified ?? DateTime.MinValue)
                : ordered.ThenBy(i => i.Modified ?? DateTime.MinValue),
            _ => descending
                ? ordered.ThenByDescending(i => i.DisplayName, StringComparer.OrdinalIgnoreCase)
                : ordered.ThenBy(i => i.DisplayName, StringComparer.OrdinalIgnoreCase)
        };

        return ordered
            .ThenBy(i => i.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void SetSort(string side, string column)
    {
        if (side == "left")
        {
            if (string.Equals(_leftSort, column, StringComparison.OrdinalIgnoreCase))
                _leftSortDesc = !_leftSortDesc;
            else
            {
                _leftSort = column;
                _leftSortDesc = false;
            }
        }
        else
        {
            if (string.Equals(_rightSort, column, StringComparison.OrdinalIgnoreCase))
                _rightSortDesc = !_rightSortDesc;
            else
            {
                _rightSort = column;
                _rightSortDesc = false;
            }
        }

        CloseContextMenu();
    }

    private string SortHeaderClass(string side, string column) =>
        string.Equals(side == "left" ? _leftSort : _rightSort, column, StringComparison.OrdinalIgnoreCase)
            ? "sort-header active"
            : "sort-header";

    private string SortGlyph(string side, string column)
    {
        var active = string.Equals(side == "left" ? _leftSort : _rightSort, column, StringComparison.OrdinalIgnoreCase);
        if (!active) return "";
        return (side == "left" ? _leftSortDesc : _rightSortDesc) ? "v" : "^";
    }
}
