@page "/"
@implements IDisposable
@inject UiLogSink Sink
@inject RaceHistoryStore History

<PageTitle>Dashboard - RaceTrade</PageTitle>

<div class="dashboard-page">
    <div class="page-head dashboard-head">
        <h1><Icon Name="dashboard" Size="18" />Dashboard</h1>
    </div>

@* Stat tiles first, then the action cards that mirror the WinForms dashboard
   (CBFTP SERVERS / SITES / PREBOTS / LOGS / TOOLS). *@
<div class="card-grid dashboard-stats">
    <div class="card">
        <div class="card-title">RACES SEEN</div>
        <div class="stat"><span class="stat-value">@_races</span><span class="stat-label">detected</span></div>
    </div>
    <div class="card">
        <div class="card-title">RELEASES</div>
        <div class="stat"><span class="stat-value ok">@_releases</span><span class="stat-label">unique</span></div>
    </div>
    <div class="card">
        <div class="card-title">WARNINGS</div>
        <div class="stat"><span class="stat-value warn">@_warnings</span><span class="stat-label">recent</span></div>
    </div>
    <div class="card">
        <div class="card-title">ERRORS</div>
        <div class="stat"><span class="stat-value err">@_errors</span><span class="stat-label">recent</span></div>
    </div>
    <div class="card">
        <div class="card-title">SITES</div>
        <div class="stat"><span class="stat-value ok">@_siteCount</span><span class="stat-label">configured</span></div>
    </div>
</div>

<h2 class="dashboard-section-title">SHORTCUTS</h2>
<div class="card-grid dashboard-shortcuts">
    <div class="card">
        <div class="card-title">CBFTP SERVERS</div>
        <div class="card-actions">
            <a class="btn primary" href="servers"><Icon Name="servers" Size="13" /><span>Manage servers</span></a>
        </div>
    </div>
    <div class="card">
        <div class="card-title">SITES</div>
        <div class="card-actions">
            <a class="btn primary" href="sites/new"><Icon Name="plus" Size="13" /><span>Add site</span></a>
            <a class="btn" href="sites"><Icon Name="folder" Size="13" /><span>Manage</span></a>
            <a class="btn" href="cbftp-site"><Icon Name="servers" Size="13" /><span>CBFTP site</span></a>
        </div>
    </div>
    <div class="card">
        <div class="card-title">PRE</div>
        <div class="card-actions">
            <a class="btn" href="pre"><Icon Name="flag" Size="13" /><span>Pre manager</span></a>
            <a class="btn" href="prebots"><Icon Name="prebots" Size="13" /><span>Manage prebots</span></a>
        </div>
    </div>
    <div class="card dashboard-tools-card">
        <div class="card-title">TOOLS</div>
        <div class="card-actions">
            <a class="btn" href="test"><Icon Name="test" Size="13" /><span>Test release</span></a>
            <a class="btn" href="fxp"><Icon Name="fxp" Size="13" /><span>FXP Client</span></a>
            <a class="btn" href="logs"><Icon Name="logs" Size="13" /><span>Logs</span></a>
            <a class="btn" href="chat"><Icon Name="chat" Size="13" /><span>Chat</span></a>
        </div>
    </div>
</div>

<h2 class="dashboard-section-title">LATEST ACTIVITY</h2>
<div class="panel dashboard-activity">
    <div class="dashboard-scroll">
        @if (_recent.Count == 0)
        {
            <div class="empty">
                No engine activity yet. Press <strong>Start</strong> in the sidebar once the
                engine is wired up.
            </div>
        }
        else
        {
            <table class="grid logs">
                <tbody>
                    @foreach (var e in _recent)
                    {
                        <tr class="lvl-@e.Level.ToString().ToLowerInvariant()">
                            <td class="ts">@e.Timestamp.ToString("HH:mm:ss")</td>
                            <td class="ch">@e.Channel</td>
                            <td class="site">@e.Site</td>
                            @* Same LogEvent stream as the Logs page, so it needs the same
                           markup rendering - otherwise the colour codes show up as
                           stray digits in front of every site name. *@
                        <td class="msg">@((MarkupString)IrcMarkup.ToHtml(e.Message))</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<h2 class="dashboard-section-title">RELEASE HISTORY</h2>
<div class="panel dashboard-history">
    <div class="toolbar">
        <span class="hint">@_historyStats.UniqueReleases release(s), @_historyStats.Events race event(s) stored</span>
        <span class="spacer"></span>
        <a class="btn" href="history"><Icon Name="logs" Size="13" /><span>Full history</span></a>
    </div>

    <div class="dashboard-scroll dashboard-history-scroll">
        @if (_releaseHistory.Count == 0)
        {
            <div class="empty">No releases seen yet.</div>
        }
        else
        {
            <table class="grid history">
                <thead>
                    <tr>
                        <th>LAST SEEN</th>
                        <th>STATUS</th>
                        <th>SITE</th>
                        <th>SECTION</th>
                        <th>RELEASE</th>
                        <th>DETAIL</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in _releaseHistory)
                    {
                        <tr>
                            <td class="ts">@e.LastSeen.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><span class="@StatusClass(e.Status)">@e.Status</span></td>
                            <td class="site">@e.Site</td>
                            <td>@e.Section</td>
                            <td class="release-name">@e.Release</td>
                            <td class="dim">@HistoryDetail(e)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
</div>

@code {
    private IReadOnlyList<LogEvent> _recent = Array.Empty<LogEvent>();
    private IReadOnlyList<RaceHistoryStore.RaceReleaseSummary> _releaseHistory = Array.Empty<RaceHistoryStore.RaceReleaseSummary>();
    private RaceHistoryStore.RaceHistoryStats _historyStats = new(0, 0, 0);
    private int _errors, _warnings, _races, _releases, _siteCount;

    protected override void OnInitialized()
    {
        Sink.Changed += OnSinkChanged;
        History.Changed += OnHistoryChanged;
        _siteCount = CountSites();
        Refresh();
    }

    private void OnSinkChanged() => InvokeAsync(() => { Refresh(); StateHasChanged(); });
    private void OnHistoryChanged() => InvokeAsync(() => { Refresh(); StateHasChanged(); });

    private void Refresh()
    {
        var all = Sink.Snapshot(1000);
        _errors = all.Count(e => e.Level == LogLevel.Error);
        _warnings = all.Count(e => e.Level == LogLevel.Warning);
        _historyStats = History.GetStats();
        _races = _historyStats.Detected;
        _releases = _historyStats.UniqueReleases;
        _releaseHistory = History.LatestReleases(10);
        _recent = all.Take(20).ToList();
    }

    private static int CountSites()
    {
        try
        {
            if (!Directory.Exists("sites")) return 0;
            return Directory.GetFiles("sites", "*.json")
                .Select(Path.GetFileNameWithoutExtension)
                .Count(n => n is not ("new_site" or "template" or "example"));
        }
        catch { return 0; }
    }

    private static string StatusClass(string status) => $"pill race-{status.ToLowerInvariant()}";

    private static string HistoryDetail(RaceHistoryStore.RaceReleaseSummary e)
    {
        if (!string.IsNullOrWhiteSpace(e.Reason)) return e.Reason;
        if (!string.IsNullOrWhiteSpace(e.TargetSite)) return $"Target: {e.TargetSite}";
        return e.EventCount > 1 ? $"{e.EventCount} event(s)" : "";
    }

    public void Dispose()
    {
        Sink.Changed -= OnSinkChanged;
        History.Changed -= OnHistoryChanged;
    }
}
