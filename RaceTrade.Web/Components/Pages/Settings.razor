@page "/settings"
@inject WebSecurityOptions Security
@inject Microsoft.Extensions.Hosting.IHostApplicationLifetime Lifetime
@inject EngineHost Engine
@inject ChatHost ChatSvc
@inject RaceHistoryStore History
@inject UiLogSink Sink

<PageTitle>Settings - RaceTrade</PageTitle>

<div class="page-head">
    <h1><Icon Name="settings" Size="18" />Settings</h1>
</div>

<div class="card-grid">
    <div class="card">
        <div class="card-title">WEB ACCESS</div>
        <table class="grid">
            <tbody>
                <tr>
                    <td>Listening on</td>
                    <td>@Security.BindAddress:@Security.Port</td>
                </tr>
                <tr>
                    <td>Reachable from</td>
                    <td>
                        @if (Security.IsLoopbackOnly)
                        {
                            <span class="pill on">This machine only</span>
                        }
                        else
                        {
                            <span class="pill off">Other machines</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td>Login</td>
                    <td>
                        @if (Security.HasPassword)
                        {
                            <span class="pill on">Password set</span>
                        }
                        else
                        {
                            <span class="pill off">Not set</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>

        @if (!Security.HasPassword && Security.IsLoopbackOnly)
        {
            <p class="hint">
                No password needed while this is loopback-only. Set one with
                <code>RaceTrade --set-password</code> before changing
                <code>Web:BindAddress</code> - the app refuses to start exposed without it.
            </p>
        }
    </div>

    <div class="card">
        <div class="card-title">ENGINE</div>

        @* Stacked rows, not the two-column form grid: inside a narrow card that grid
           squeezes the help text into a one-word-per-line column. *@
        <label class="opt">
            <input type="checkbox" @bind="_debug" @bind:after="ApplyEngine" />
            <span>
                <span class="opt-name">Debug logging</span>
                <span class="fh">Verbose diagnostics. Costs time on the race path - leave off normally.</span>
            </span>
        </label>

        <label class="opt">
            <input type="checkbox" @bind="_insecureSsl" @bind:after="ApplyEngine" />
            <span>
                <span class="opt-name">Allow insecure SSL</span>
                <span class="fh">Accept self-signed cbftp certificates.</span>
            </span>
        </label>
    </div>

    <div class="card">
        <div class="card-title">DATA FOLDER</div>
        <p class="path">@DataRoot</p>
        <p class="fh">
            All sites, cbftp servers, prebots, sections and databases are read from here.
            Copy your existing folders <strong>into</strong> this directory - not next to
            the exe - then restart.
        </p>
        <table class="grid tight">
            <tbody>
                @foreach (var (name, count) in _dataCounts)
                {
                    <tr>
                        <td>@name</td>
                        <td class="right @(count == 0 ? "dim" : "")">@count file(s)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card">
        <div class="card-title">HISTORY / RESET</div>
        <table class="grid tight">
            <tbody>
                <tr><td>Releases seen</td><td class="right">@_historyStats.Detected</td></tr>
                <tr><td>Unique releases</td><td class="right">@_historyStats.UniqueReleases</td></tr>
                <tr><td>Race events</td><td class="right">@_historyStats.Events</td></tr>
            </tbody>
        </table>

        <div class="card-actions">
            @if (!_confirmClearHistory)
            {
                <button class="btn danger" @onclick="() => _confirmClearHistory = true">
                    <Icon Name="trash" Size="13" /><span>Clear release history</span>
                </button>
            }
            else
            {
                <span class="fh inline">Really clear history?</span>
                <button class="btn danger" @onclick="ClearRaceHistory">Yes</button>
                <button class="btn" @onclick="() => _confirmClearHistory = false">Cancel</button>
            }

            <button class="btn" @onclick="ClearLiveLogs">
                <Icon Name="trash" Size="13" /><span>Clear live logs</span>
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_historyMessage))
        {
            <p class="fh">@_historyMessage</p>
        }
    </div>
</div>

<h2><Icon Name="settings" Size="14" />WEBUI ACCESS</h2>
<div class="panel form">
    <div class="callout">
        Change the WebUI port, bind address or data folder here instead of editing
        <code>appsettings.json</code> by hand. These values are read on startup, so save
        them and restart RaceTrade. Command-line switches such as <code>--port</code>,
        <code>--bind</code> and <code>--data</code> still win for that launch.
    </div>

    <div class="form-grid wide">
        <label>Bind address</label>
        <div>
            <input type="text" @bind="_bindAddress" @bind:event="oninput" placeholder="127.0.0.1" />
            <div class="fh">
                Use <code>127.0.0.1</code> for local-only. Use <code>0.0.0.0</code> only for LAN/server access and only after setting a password.
            </div>
        </div>

        <label>Port</label>
        <div>
            <input type="number" min="1" max="65535" @bind="_webPort" />
            <div class="fh">
                Use a different port when you want multiple RaceTrade copies running at the same time.
            </div>
        </div>

        <label>Data folder</label>
        <div>
            <input type="text" @bind="_dataRootSetting" @bind:event="oninput" />
            <div class="fh">
                Absolute paths work. Relative paths are resolved next to the executable. Current data folder is <code>@DataRoot</code>.
            </div>
        </div>

        <label>Settings file</label>
        <div>
            <p class="path">@AppSettingsPath</p>
            <div class="fh">This file sits next to the executable and is read before the engine starts.</div>
        </div>
    </div>

    <div class="form-actions">
        <button class="btn primary" @onclick="SaveWebAccess"><Icon Name="save" Size="13" /><span>Save web settings</span></button>
        <button class="btn danger" disabled="@(!_webNeedsRestart)" @onclick="QuitToApply"><Icon Name="power" Size="13" /><span>Quit to apply</span></button>
        @if (!string.IsNullOrWhiteSpace(_webMessage))
        {
            <span class="@($"fh inline {(_webMessageIsError ? "err-text" : "")}")">@_webMessage</span>
        }
    </div>
</div>

<h2><Icon Name="shield" Size="14" />REMOTE / SSL</h2>
<div class="panel form">
    <div class="callout">
        Recommended public setup: keep RaceTrade listening on <code>127.0.0.1</code>
        and put a reverse proxy with HTTPS in front of it. Caddy is the easiest option
        because it can request and renew Let's Encrypt certificates automatically.
    </div>

    <div class="fh"><strong>Caddy example</strong></div>
<pre class="code">racetrade.example.com {
    reverse_proxy 127.0.0.1:8420
}</pre>

    <div class="fh"><strong>LAN-only example</strong></div>
<pre class="code">RaceTrade.exe --set-password
RaceTrade.exe --bind 0.0.0.0 --port 8420</pre>

    <div class="fh">
        Do not expose RaceTrade without a password. For internet access, prefer a VPN,
        Tailscale/WireGuard, SSH tunnel, or a reverse proxy with HTTPS instead of opening
        the RaceTrade port directly.
    </div>
</div>

<h2><Icon Name="power" Size="14" />HOW THIS RUNS</h2>
<div class="panel form">
    <div class="callout">
        There is no separate engine process. <strong>One binary</strong> contains the racing
        engine and this web UI - the engine runs inside it, and the UI is just a local web
        server you happen to view in a browser. Nothing is installed, nothing phones home.
    </div>

    <table class="grid tight">
        <tbody>
            <tr><td>Executable</td><td class="path">@ExePath</td></tr>
            <tr><td>Data folder</td><td class="path">@DataRoot</td></tr>
            <tr><td>Listening on</td><td>@Security.BindAddress:@Security.Port</td></tr>
        </tbody>
    </table>

    <div class="fh" style="margin-top:12px">
        <strong>Command-line switches</strong>
    </div>
    <table class="grid tight">
        <tbody>
            <tr><td><code>--data &lt;path&gt;</code></td><td>Use a different data folder.</td></tr>
            <tr><td><code>--port 8421</code></td><td>Run another RaceTrade copy on a different WebUI port.</td></tr>
            <tr><td><code>--bind 127.0.0.1</code></td><td>Choose the WebUI bind address.</td></tr>
            <tr><td><code>--no-browser</code></td><td>Do not open a browser on start. Use this on a server.</td></tr>
            <tr><td><code>--console</code></td><td>Keep the console window (Windows). Handy for reading startup errors.</td></tr>
            <tr><td><code>--set-password</code></td><td>Generate a password hash for remote access.</td></tr>
            <tr><td><code>--migrate-legacy-secrets</code></td><td>Convert old WinForms <code>ENC:</code> secrets to v2 <code>ENC2:</code>.</td></tr>
        </tbody>
    </table>

    <div class="fh" style="margin-top:12px">
        <strong>Linux / headless</strong> - same binary, no desktop needed. Run it as a
        service and point your browser at it from any machine:
    </div>
<pre class="code">./RaceTrade --no-browser

# as a systemd service
sudo tee /etc/systemd/system/racetrade.service &lt;&lt;'EOF'
[Unit]
Description=RaceTrade
After=network-online.target

[Service]
ExecStart=/opt/racetrade/RaceTrade --no-browser
WorkingDirectory=/opt/racetrade
Restart=always
User=racetrade

[Install]
WantedBy=multi-user.target
EOF
sudo systemctl enable --now racetrade</pre>

    <div class="fh">
        To reach it from another machine, use the WebUI access settings above or start
        with <code>--bind 0.0.0.0</code>. RaceTrade refuses to start exposed until a
        password is set with <code>--set-password</code>.
    </div>
</div>

<h2><Icon Name="film" Size="14" />MOVIE / TV LOOKUP</h2>
<div class="panel form">
    <div class="callout">
        API credentials for the IMDB and TVMaze filters you can enable per section.
        TVMaze needs no key. For movies you can use Tiffara (no key) or TMDb (key required).
        Stored in <code>settings/settings.json</code>.
    </div>

    <div class="form-grid wide">
        <label>Movie provider</label>
        <div>
            <select @bind="_movieProvider">
                <option value="tiffara">Tiffara - no API key needed</option>
                <option value="tmdb">TMDb - requires a key</option>
            </select>
        </div>

        <label>TMDb API key</label>
        <div>
            <input type="password" @bind="_tmdbKey" placeholder="@(_hasTmdbKey ? "******** (unchanged)" : "v3 API key")" @bind:event="oninput" />
            <div class="fh">Free from themoviedb.org. Only needed when the provider is TMDb.</div>
        </div>

        <label>TMDb bearer token</label>
        <div>
            <input type="password" @bind="_tmdbBearer" placeholder="@(_hasTmdbBearer ? "******** (unchanged)" : "optional v4 token")" @bind:event="oninput" />
            <div class="fh">Optional alternative to the API key.</div>
        </div>
    </div>

    <div class="form-actions">
        <button class="btn primary" @onclick="SaveLookup"><Icon Name="save" Size="13" /><span>Save</span></button>
        @if (_saved)
        {
            <span class="fh inline">Saved.</span>
        }
    </div>
</div>

@code {
    private const string SettingsFile = "settings/settings.json";

    private bool _debug = EngineSettings.DebugEnabled;
    private bool _insecureSsl = EngineSettings.AllowInsecureSsl;

    private string _movieProvider = "tiffara";
    private string _tmdbKey = "";
    private string _tmdbBearer = "";
    private bool _hasTmdbKey, _hasTmdbBearer, _saved;
    private RaceHistoryStore.RaceHistoryStats _historyStats = new(0, 0, 0);
    private bool _confirmClearHistory;
    private string _historyMessage = "";
    private string _bindAddress = "";
    private int _webPort;
    private string _dataRootSetting = "";
    private string _webMessage = "";
    private bool _webMessageIsError;
    private bool _webNeedsRestart;

    // The engine reads everything by relative path, and the process working directory is
    // the data folder - so this is exactly where it looks.
    private static string DataRoot => Directory.GetCurrentDirectory();

    // Environment.ProcessPath is the real exe, even under PublishSingleFile where
    // AppContext.BaseDirectory points at the temporary extraction folder.
    private static string ExePath => Environment.ProcessPath ?? AppContext.BaseDirectory;
    private static string AppDirectory => ResolveVisibleAppDirectory();
    private static string AppSettingsPath => Path.Combine(AppDirectory, "appsettings.json");

    private List<(string Name, int Count)> _dataCounts = new();

    protected override void OnInitialized()
    {
        LoadWebAccess();
        LoadLookup();
        CountData();
        RefreshHistoryStats();
    }

    private void CountData()
    {
        _dataCounts = new[] { "sites", "cbftp", "pre_bots", "sections", "settings", "db", "history" }
            .Select(d => (d, Directory.Exists(d) ? Directory.GetFiles(d).Length : 0))
            .ToList();
    }

    private void RefreshHistoryStats() => _historyStats = History.GetStats();

    private void ClearRaceHistory()
    {
        History.Clear();
        _confirmClearHistory = false;
        _historyMessage = "Release history cleared.";
        RefreshHistoryStats();
    }

    private void ClearLiveLogs()
    {
        Sink.Clear();
        _historyMessage = "Live log buffer cleared. Persistent release history was not changed.";
    }

    private void ApplyEngine()
    {
        // Applied immediately: these are plain process-wide switches, no restart needed.
        EngineSettings.DebugEnabled = _debug;
        EngineSettings.AllowInsecureSsl = _insecureSsl;
    }

    private void LoadWebAccess()
    {
        _bindAddress = Security.BindAddress;
        _webPort = Security.Port;
        _dataRootSetting = DataRoot;

        try
        {
            if (!File.Exists(AppSettingsPath)) return;

            var o = Newtonsoft.Json.Linq.JObject.Parse(File.ReadAllText(AppSettingsPath));
            var web = o["Web"] as Newtonsoft.Json.Linq.JObject;
            var data = o["Data"] as Newtonsoft.Json.Linq.JObject;

            _bindAddress = web?["BindAddress"]?.ToString() ?? _bindAddress;
            _webPort = int.TryParse(web?["Port"]?.ToString(), out var port) ? port : _webPort;
            _dataRootSetting = data?["Root"]?.ToString() ?? _dataRootSetting;
        }
        catch
        {
            // A bad appsettings file should not break the Settings page.
        }
    }

    private void SaveWebAccess()
    {
        _webMessage = "";
        _webMessageIsError = false;

        var bind = string.IsNullOrWhiteSpace(_bindAddress) ? "127.0.0.1" : _bindAddress.Trim();
        var dataRoot = string.IsNullOrWhiteSpace(_dataRootSetting) ? "data" : _dataRootSetting.Trim();

        if (_webPort is < 1 or > 65535)
        {
            WebError("Port must be between 1 and 65535.");
            return;
        }

        if (!IsValidBindAddress(bind))
        {
            WebError("Bind address must be localhost, 127.0.0.1, 0.0.0.0, ::1 or a valid IP address.");
            return;
        }

        if (!IsLoopback(bind) && !Security.HasPassword)
        {
            WebError("Set a password first with RaceTrade.exe --set-password before exposing the WebUI.");
            return;
        }

        try
        {
            Directory.CreateDirectory(AppDirectory);

            var o = File.Exists(AppSettingsPath)
                ? Newtonsoft.Json.Linq.JObject.Parse(File.ReadAllText(AppSettingsPath))
                : new Newtonsoft.Json.Linq.JObject();

            var web = o["Web"] as Newtonsoft.Json.Linq.JObject ?? new Newtonsoft.Json.Linq.JObject();
            var data = o["Data"] as Newtonsoft.Json.Linq.JObject ?? new Newtonsoft.Json.Linq.JObject();

            web["BindAddress"] = bind;
            web["Port"] = _webPort;
            data["Root"] = dataRoot;

            o["Web"] = web;
            o["Data"] = data;

            AtomicFile.WriteAllText(AppSettingsPath, o.ToString(Newtonsoft.Json.Formatting.Indented));

            _bindAddress = bind;
            _dataRootSetting = dataRoot;
            _webNeedsRestart = true;
            _webMessage = "Saved. Quit and start RaceTrade again to apply these startup settings.";
            LogManager.Success("Saved WebUI startup settings.");
        }
        catch (Exception ex)
        {
            WebError($"Failed to save WebUI settings: {ex.Message}");
            LogManager.Error($"Failed to save WebUI settings: {ex.Message}");
        }
    }

    private async Task QuitToApply()
    {
        try { await ChatSvc.StopAsync(); } catch { }
        try { await Engine.StopAsync(); } catch { }
        Lifetime.StopApplication();
    }

    private void WebError(string message)
    {
        _webMessage = message;
        _webMessageIsError = true;
        _webNeedsRestart = false;
    }

    private void LoadLookup()
    {
        try
        {
            if (!File.Exists(SettingsFile)) return;

            var o = Newtonsoft.Json.Linq.JObject.Parse(File.ReadAllText(SettingsFile));

            _movieProvider = o["movie_api_provider"]?.ToString()
                             ?? o["imdb_api_provider"]?.ToString()
                             ?? "tiffara";

            // Keys are not echoed back to the browser; empty box means "keep".
            _hasTmdbKey = !string.IsNullOrEmpty(o["tmdb_api_key"]?.ToString() ?? o["tmdb_key"]?.ToString());
            _hasTmdbBearer = !string.IsNullOrEmpty(o["tmdb_bearer_token"]?.ToString());
        }
        catch
        {
            // A malformed settings file shouldn't break the page; defaults apply.
        }
    }

    private void SaveLookup()
    {
        try
        {
            Directory.CreateDirectory("settings");

            var o = File.Exists(SettingsFile)
                ? Newtonsoft.Json.Linq.JObject.Parse(File.ReadAllText(SettingsFile))
                : new Newtonsoft.Json.Linq.JObject();

            o["movie_api_provider"] = _movieProvider;

            if (!string.IsNullOrEmpty(_tmdbKey)) o["tmdb_api_key"] = _tmdbKey;
            if (!string.IsNullOrEmpty(_tmdbBearer)) o["tmdb_bearer_token"] = _tmdbBearer;

            AtomicFile.WriteAllText(SettingsFile, o.ToString(Newtonsoft.Json.Formatting.Indented));

            _tmdbKey = _tmdbBearer = "";
            _saved = true;
            LoadLookup();
            LogManager.Success("Saved lookup settings.");
        }
        catch (Exception ex)
        {
            LogManager.Error($"Failed to save lookup settings: {ex.Message}");
        }
    }

    private static string ResolveVisibleAppDirectory()
    {
        var exe = Environment.ProcessPath;

        if (!string.IsNullOrEmpty(exe))
        {
            var name = Path.GetFileNameWithoutExtension(exe);
            if (!string.Equals(name, "dotnet", StringComparison.OrdinalIgnoreCase))
            {
                var dir = Path.GetDirectoryName(exe);
                if (!string.IsNullOrEmpty(dir)) return dir;
            }
        }

        return AppContext.BaseDirectory;
    }

    private static bool IsValidBindAddress(string value) =>
        value.Equals("localhost", StringComparison.OrdinalIgnoreCase) ||
        System.Net.IPAddress.TryParse(value, out _);

    private static bool IsLoopback(string value) =>
        value.Equals("localhost", StringComparison.OrdinalIgnoreCase) ||
        value.Equals("127.0.0.1", StringComparison.OrdinalIgnoreCase) ||
        value.Equals("::1", StringComparison.OrdinalIgnoreCase);
}
