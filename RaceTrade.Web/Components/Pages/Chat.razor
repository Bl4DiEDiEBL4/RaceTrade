@page "/chat"
@implements IDisposable
@inject WebIrcOutput Irc
@inject ChatHost ChatSvc

<PageTitle>Chat - RaceTrade</PageTitle>

<div class="chat-page">
    @* Chat runs on its own IRC connections (ChatHost), not the trader's. Starting chat here
       does not start racing, and stopping the racer does not drop chat. *@
    <div class="page-head">
        <h1><Icon Name="chat" Size="18" />Chat</h1>
        <div class="head-actions">
            <select class="chat-site-picker" @bind="_connectSite" disabled="@_busy">
                <option value="">-- pick site --</option>
                @foreach (var site in _siteOptions)
                {
                    <option value="@site">@site</option>
                }
            </select>

            <button class="btn primary"
                    @onclick="Start"
                    disabled="@(_busy || string.IsNullOrWhiteSpace(_connectSite) || SelectedConnectSiteConnected)">
                <Icon Name="play" Size="13" />
                <span>@(SelectedConnectSiteConnected ? "Connected" : "Connect chat")</span>
            </button>

            @if (ChatSvc.IsRunning)
            {
                <span class="chat-state on"><span class="state-dot"></span>@ChatSvc.ConnectedSites.Count site(s) connected</span>
                <button class="btn danger" @onclick="Stop" disabled="@_busy"><Icon Name="stop" Size="13" /><span>Disconnect chat</span></button>
            }
            else
            {
                <span class="chat-state off"><span class="state-dot"></span>Offline</span>
            }
        </div>
    </div>

    @if (_channels.Count == 0)
    {
        <div class="panel chat-empty-panel">
            <div class="empty">
                @if (!string.IsNullOrWhiteSpace(_notice))
                {
                    <div class="@($"chat-notice {(_noticeIsError ? "err" : "")}")">@_notice</div>
                }
                else if (ChatSvc.IsRunning)
                {
                    <text>Connecting... channels appear as the IRC clients join them.</text>
                }
                else
                {
                    <text>
                        Not connected. Press <strong>Connect chat</strong> above - this only opens
                        the selected site's IRC connection, it does not start the trader.
                    </text>
                }
            </div>
        </div>
    }
    else
    {
        <div class="panel chat-panel">
            @* Two rows: sites on top, then the channels belonging to the selected site.
               One flat list mixed both together and became unreadable past a few sites. *@
            <div class="site-tabs">
                @foreach (var site in Sites)
                {
                    <button type="button"
                            class="site-tab @(SameSite(site, _site) ? "active" : "")"
                            @onclick="() => SelectSite(site)">
                        <Icon Name="sites" Size="13" />
                        <span>@site</span>
                    </button>
                }
            </div>

            <div class="toolbar chat-toolbar">
                <div class="channel-tabs">
                    @foreach (var (site, chan) in SiteChannels)
                    {
                        var value = $"{site}|{chan}";
                        @* Not a <button> wrapping a <button>: nested buttons are invalid HTML
                           and the inner click never fires reliably. A div with a role does. *@
                        <div class="@ChannelTabClass(value, chan)"
                             role="button"
                             tabindex="0"
                             @onclick="() => SelectChannel(site, chan)">
                            @if (IsPrivateMessage(chan))
                            {
                                <span class="channel-pm">PM</span>
                                <span class="channel-name">@PrivateNick(chan)</span>
                            }
                            else
                            {
                                <span class="channel-name">@chan</span>
                            }
                            <span class="tab-close"
                                  title="Close this tab"
                                  @onclick="() => CloseTab(site, chan)"
                                  @onclick:stopPropagation="true">&times;</span>
                        </div>
                    }
                </div>
                <span class="spacer"></span>
                <button class="btn" @onclick="OpenKeyDialog" disabled="@(!ChatSvc.IsRunning || string.IsNullOrEmpty(_selected))">
                    <Icon Name="lock" Size="13" /><span>@(CurrentIsPm ? "PM key" : "Channel key")</span>
                </button>
                @if (CurrentIsPm)
                {
                    <span class="hint">private message</span>
                }
            </div>

            <div class="chat-body">
                @* column-reverse keeps the newest line pinned to the bottom without any JS,
                   and makes a nearly-empty channel hug the bottom instead of stretching its
                   first few rows across the whole panel. Row order stays normal: the table
                   is a single flex item. *@
                <div class="chat-scroll">
                    <table class="grid logs chat-lines">
                        <tbody>
                            @foreach (var l in _lines)
                            {
                                <tr class="lvl-@l.Level.ToString().ToLowerInvariant()">
                                    <td class="ts">@l.At.ToString("HH:mm:ss")</td>
                                    <td class="msg irc-line">@((MarkupString)l.Html)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <aside class="@($"userlist {(CurrentIsPm ? "pm-side" : "")}")">
                    @if (CurrentIsPm)
                    {
                        <div class="pm-meta">
                            <span class="pm-kicker">Private message</span>
                            <strong>@PrivateNick(CurrentChannel)</strong>
                            <span>
                                A FiSH key is negotiated automatically (DH1080) when the tab
                                opens. Set one by hand only if the other side does not answer.
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="userlist-head">@_users.Count users</div>
                        @foreach (var u in _users)
                        {
                            var nick = PlainNick(u);
                            <div class="@UserClass(u)"
                                 title="Double-click to open a private message, right-click for more"
                                 @ondblclick="() => OpenPm(nick)"
                                 @oncontextmenu="e => OpenUserMenu(nick, e)"
                                 @oncontextmenu:preventDefault="true">@u</div>
                        }
                    }
                </aside>
            </div>

            <div class="chat-send">
                <input @bind="_draft" @bind:event="oninput" @onkeydown="OnKeyDown"
                       placeholder="Message @CurrentTargetLabel - Enter to send"
                       disabled="@(!ChatSvc.IsRunning)" />
                <button class="btn primary" @onclick="Send" disabled="@(!ChatSvc.IsRunning)"><Icon Name="send" Size="13" /><span>Send</span></button>
            </div>
        </div>
    }
</div>

@if (_menuNick is not null)
{
    @* Backdrop catches the click that dismisses the menu, including a second
       right-click somewhere else. *@
    <div class="menu-backdrop"
         @onclick="CloseUserMenu"
         @oncontextmenu="CloseUserMenu"
         @oncontextmenu:preventDefault="true"></div>

    <div class="ctx-menu" style="@MenuStyle">
        <div class="ctx-head">@_menuNick</div>
        <button type="button" @onclick="() => OpenPm(_menuNick!)">
            <Icon Name="chat" Size="13" /><span>Send private message</span>
        </button>
        <button type="button" @onclick="() => OpenPmKey(_menuNick!)">
            <Icon Name="lock" Size="13" /><span>Blowfish key for this user</span>
        </button>
        <button type="button" @onclick="() => Mention(_menuNick!)">
            <Icon Name="send" Size="13" /><span>Mention in channel</span>
        </button>
    </div>
}

@if (_showKeyDialog)
{
    <div class="modal-backdrop" @onclick="CloseKeyDialog">
        <div class="modal-card key-modal" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2><Icon Name="lock" Size="15" />Blowfish key for @KeyDialogTarget</h2>
                <button class="btn" @onclick="CloseKeyDialog"><Icon Name="close" Size="13" /><span>Close</span></button>
            </div>
            <div class="key-modal-body">
                <div class="form-grid wide">
                    <label>UTF-8 key</label>
                    <div>
                        <input type="@(_showKey ? "text" : "password")"
                               @bind="_channelKey"
                               @bind:event="oninput"
                               @onkeydown="OnKeyDialogKeyDown"
                               autocomplete="off"
                               placeholder="channel Blowfish key" />
                        <div class="fh">
                            Existing keys from the site channel list, chat-only keys, or saved PM keys are loaded here.
                            Saving writes an encrypted <code>chat_keys</code> entry to this site config.
                        </div>
                    </div>
                </div>

                <div class="key-options">
                    <label class="check-inline">
                        <input type="checkbox" @bind="_showKey" />
                        <span>Show key</span>
                    </label>
                    <label class="check-inline">
                        <input type="checkbox" @bind="_persistKey" />
                        <span>Save to site config</span>
                    </label>
                </div>

                @if (!string.IsNullOrWhiteSpace(_keyMessage))
                {
                    <div class="@($"fh {(_keyMessageIsError ? "err-text" : "")}")">@_keyMessage</div>
                }

                <div class="form-actions">
                    <button class="btn primary" @onclick="SaveChannelKey">
                        <Icon Name="save" Size="13" /><span>Save key</span>
                    </button>
                    <button class="btn" @onclick="CloseKeyDialog">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<(string Site, string Channel)> _channels = Array.Empty<(string, string)>();
    private IReadOnlyList<WebIrcOutput.ChatLine> _lines = Array.Empty<WebIrcOutput.ChatLine>();
    private IReadOnlyList<string> _users = Array.Empty<string>();
    private string _selected = "";
    private string _site = "";
    private IReadOnlyList<string> _siteOptions = Array.Empty<string>();
    private string _connectSite = "";
    private string _draft = "";
    private string _notice = "";
    private bool _noticeIsError;
    private bool _busy;

    // user context menu
    private string? _menuNick;
    private double _menuX, _menuY;
    private bool _showKeyDialog;
    private bool _persistKey = true;
    private bool _showKey;
    private string _channelKey = "";
    private string _keyMessage = "";
    private bool _keyMessageIsError;

    private string CurrentSite => _selected.Split('|', 2) is { Length: 2 } p ? p[0] : "";
    private string CurrentChannel => _selected.Split('|', 2) is { Length: 2 } p ? p[1] : "";
    private bool CurrentIsPm => IsPrivateMessage(CurrentChannel);
    private string CurrentTargetLabel => CurrentIsPm ? $"PM {PrivateNick(CurrentChannel)}" : CurrentChannel;
    private string KeyDialogTarget => CurrentIsPm ? $"{CurrentSite} - PM {PrivateNick(CurrentChannel)}" : $"{CurrentSite} - {CurrentChannel}";
    private bool SelectedConnectSiteConnected =>
        !string.IsNullOrWhiteSpace(_connectSite) &&
        ChatSvc.ConnectedSites.Contains(_connectSite, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<string> Sites =>
        _channels.Select(c => c.Site).Distinct(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<(string Site, string Channel)> SiteChannels =>
        _channels.Where(c => SameSite(c.Site, _site));

    private static bool SameSite(string a, string b) =>
        string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    private string MenuStyle =>
        $"left:{_menuX.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;" +
        $"top:{_menuY.ToString(System.Globalization.CultureInfo.InvariantCulture)}px";

    protected override void OnInitialized()
    {
        Irc.Changed += OnChanged;
        ChatSvc.Changed += OnChanged;
        Refresh();
    }

    private void OnChanged() => InvokeAsync(() => { Refresh(); StateHasChanged(); });

    private async Task Start()
    {
        if (string.IsNullOrWhiteSpace(_connectSite))
            return;

        _busy = true;
        try
        {
            var result = await ChatSvc.StartAsync(_connectSite);
            _notice = result.Message;
            _noticeIsError = !result.Accepted;
        }
        finally
        {
            _busy = false;
            RefreshSiteOptions();
            Refresh();
        }
    }

    private async Task Stop()
    {
        _busy = true;
        try
        {
            await ChatSvc.StopAsync();
            _notice = "Chat disconnected.";
            _noticeIsError = false;
        }
        finally
        {
            _busy = false;
            Refresh();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Send();
    }

    private async Task OnKeyDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveChannelKey();
    }

    private async Task Send()
    {
        var text = _draft;
        if (string.IsNullOrWhiteSpace(text)) return;

        var parts = _selected.Split('|', 2);
        if (parts.Length != 2) return;

        _draft = "";                     // cleared first: sending is async and may fail
        await ChatSvc.SendAsync(parts[0], parts[1], text);
    }

    private void OpenKeyDialog()
    {
        if (string.IsNullOrEmpty(CurrentSite) || string.IsNullOrEmpty(CurrentChannel))
            return;

        _channelKey = ChatSvc.GetChannelKey(CurrentSite, CurrentChannel);
        _persistKey = true;
        _showKey = false;
        _keyMessageIsError = false;
        _keyMessage = string.IsNullOrEmpty(_channelKey)
            ? $"No key is currently configured for this {(CurrentIsPm ? "private message" : "channel")}."
            : "Existing key loaded.";
        _showKeyDialog = true;
    }

    private void CloseKeyDialog()
    {
        _showKeyDialog = false;
        _channelKey = "";
        _keyMessage = "";
        _keyMessageIsError = false;
    }

    private Task SaveChannelKey()
    {
        if (string.IsNullOrWhiteSpace(_channelKey))
        {
            _keyMessage = "Fill in a key first.";
            _keyMessageIsError = true;
            return Task.CompletedTask;
        }

        ChatSvc.SetChannelKey(CurrentSite, CurrentChannel, _channelKey, _persistKey);
        CloseKeyDialog();
        return Task.CompletedTask;
    }

    private void SelectChannel(string site, string channel)
    {
        _site = site;
        _selected = $"{site}|{channel}";
        Refresh();
    }

    private void SelectSite(string site)
    {
        _site = site;

        // Jump to that site's first channel; staying on another site's channel while its
        // tab row is shown would be confusing.
        var first = _channels.FirstOrDefault(c => SameSite(c.Site, site));
        _selected = first.Channel is null ? "" : $"{first.Site}|{first.Channel}";

        Refresh();
    }

    // ---- user context menu / PM ----------------------------------------------------

    private void OpenUserMenu(string nick, MouseEventArgs e)
    {
        _menuNick = nick;

        // Client coordinates: the menu is position:fixed, so it uses the viewport frame.
        _menuX = e.ClientX;
        _menuY = e.ClientY;
    }

    private void CloseUserMenu() => _menuNick = null;

    /// <summary>
    /// Opens (or switches to) a private-message tab for a nick on the current site and
    /// negotiates a FiSH key automatically — no manual key entry, same as the old app.
    /// </summary>
    private async Task OpenPm(string nick)
    {
        var site = CurrentSite;
        if (string.IsNullOrEmpty(site) || string.IsNullOrWhiteSpace(nick)) return;

        var pm = $"PM:{nick}";
        Irc.EnsureChannel(site, pm);

        CloseUserMenu();
        SelectChannel(site, pm);

        // Fire and await: the exchange itself is one NOTICE, the reply arrives later on
        // the IRC thread and updates the tab on its own.
        await ChatSvc.EnsurePmKeyAsync(site, nick);
    }

    private async Task OpenPmKey(string nick)
    {
        await OpenPm(nick);
        OpenKeyDialog();
    }

    /// <summary>
    /// Closes a tab. This is a VIEW action only — we stay joined to the channel, so a new
    /// line re-creates the tab. Parting for real belongs in the site config, not in a
    /// throwaway UI click.
    /// </summary>
    private void CloseTab(string site, string channel)
    {
        Irc.CloseChannel(site, channel);

        if (_selected == $"{site}|{channel}")
            _selected = "";

        Refresh();
    }

    private void Mention(string nick)
    {
        _draft = string.IsNullOrWhiteSpace(_draft) ? $"{nick}: " : $"{_draft.TrimEnd()} {nick} ";
        CloseUserMenu();
    }

    private static string PlainNick(string user)
    {
        if (string.IsNullOrWhiteSpace(user)) return "";

        var s = user.Trim();
        while (s.Length > 0 && "~&@%+".IndexOf(s[0]) >= 0)
            s = s[1..];

        return s;
    }

    private static string UserClass(string user) => RankPrefix(user) switch
    {
        '~' => "user rank-owner",
        '&' => "user rank-admin",
        '@' => "user rank-op",
        '%' => "user rank-halfop",
        '+' => "user rank-voice",
        _ => "user"
    };

    private static char RankPrefix(string user) =>
        string.IsNullOrWhiteSpace(user) ? '\0' : user.Trim()[0];

    private string ChannelTabClass(string value, string channel)
    {
        var classes = $"channel-tab {(value == _selected ? "active" : "")}";
        return IsPrivateMessage(channel) ? $"{classes} pm-tab" : classes;
    }

    private static bool IsPrivateMessage(string channel) =>
        channel.StartsWith("PM:", StringComparison.OrdinalIgnoreCase);

    private static string PrivateNick(string channel) =>
        IsPrivateMessage(channel) ? channel[3..] : channel;

    private void Refresh()
    {
        RefreshSiteOptions();
        _channels = Irc.Channels;

        if (_channels.Count == 0)
        {
            _selected = "";
            _site = "";
            _lines = Array.Empty<WebIrcOutput.ChatLine>();
            _users = Array.Empty<string>();
            return;
        }

        // Recover if the selected site disappeared (site disabled, chat stopped).
        if (string.IsNullOrEmpty(_site) || !_channels.Any(c => SameSite(c.Site, _site)))
            _site = _channels[0].Site;

        // Same for the channel, but keep it within the selected site.
        if (string.IsNullOrEmpty(_selected) || !_channels.Any(c => $"{c.Site}|{c.Channel}" == _selected))
        {
            var first = _channels.First(c => SameSite(c.Site, _site));
            _selected = $"{first.Site}|{first.Channel}";
        }

        if (string.IsNullOrEmpty(_selected)) return;

        var parts = _selected.Split('|', 2);
        if (parts.Length != 2) return;

        _lines = Irc.Lines(parts[0], parts[1]);
        _users = Irc.Users(parts[0], parts[1]);
    }

    private void RefreshSiteOptions()
    {
        _siteOptions = ChatSvc.AvailableSites();

        if (_siteOptions.Count == 0)
        {
            _connectSite = "";
            return;
        }

        if (string.IsNullOrWhiteSpace(_connectSite) ||
            !_siteOptions.Contains(_connectSite, StringComparer.OrdinalIgnoreCase))
        {
            _connectSite = _siteOptions
                .FirstOrDefault(site => !ChatSvc.ConnectedSites.Contains(site, StringComparer.OrdinalIgnoreCase))
                ?? _siteOptions[0];
        }
    }

    public void Dispose()
    {
        Irc.Changed -= OnChanged;
        ChatSvc.Changed -= OnChanged;
    }
}
