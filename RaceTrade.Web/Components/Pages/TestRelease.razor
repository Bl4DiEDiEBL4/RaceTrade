@page "/test"
@inject SiteStore Sites
@using Newtonsoft.Json.Linq

<PageTitle>Test release - RaceTrade</PageTitle>

<div class="page-head">
    <h1><Icon Name="test" Size="18" />Test release</h1>
</div>

<div class="panel form">
    <div class="form-grid wide">
        <label>Announcing site</label>
        <select value="@_site" @onchange="SelectSite">
            <option value="">-- pick a site --</option>
            <option value="*">* (any site / prebot)</option>
            @foreach (var s in _siteNames)
            {
                <option value="@s">@s</option>
            }
        </select>

        <label>IRC section</label>
        <select value="@_section" @onchange="SelectSection" disabled="@(!_sectionNames.Any())">
            @if (_sectionNames.Count == 0)
            {
                <option value="">-- pick a site first --</option>
            }
            else
            {
                <option value="">-- pick an IRC section --</option>
                @foreach (var ircSection in _sectionNames)
                {
                    <option value="@ircSection">@ircSection</option>
                }
            }
        </select>

        <label>Release name</label>
        <input type="text" @bind="_release" placeholder="Some.Release.2026.1080p.WEB-GRP" @bind:event="oninput" />
    </div>

    <div class="form-actions">
        <button class="btn primary" @onclick="Run" disabled="@_running">
            @(_running ? "Testing..." : "Run test")
        </button>
        <button class="btn danger" @onclick="ClearResults" disabled="@_running">
            Clear
        </button>
    </div>
</div>

@if (_results.Count > 0)
{
    <h2>RESULT</h2>
    <div class="panel">
        <table class="grid logs">
            <tbody>
                @foreach (var r in _results)
                {
                    <tr class="lvl-@r.Level">
                        <td class="msg">@r.Text</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private sealed record Line(string Text, string Level);

    private List<string> _siteNames = new();
    private List<string> _sectionNames = new();
    private List<Line> _results = new();
    private string _site = "*";
    private string _section = "";
    private string _release = "";
    private bool _running;

    protected override void OnInitialized()
    {
        _siteNames = Sites.ListNames().ToList();
        LoadSectionNames();
    }

    private void Add(string text, string level = "info") => _results.Add(new Line(text, level));

    private void ClearResults()
    {
        _results.Clear();
    }

    private void SelectSite(ChangeEventArgs e)
    {
        _site = e.Value?.ToString() ?? "";
        LoadSectionNames();
    }

    private void SelectSection(ChangeEventArgs e)
    {
        _section = e.Value?.ToString() ?? "";
    }

    private void LoadSectionNames()
    {
        var sections = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        IEnumerable<string> names = _site switch
        {
            "" => Array.Empty<string>(),
            "*" => _siteNames,
            _ => new[] { _site }
        };

        foreach (var name in names)
        {
            var cfg = Sites.Load(name);

            foreach (var section in cfg.Sections ?? new List<Section>())
            {
                if (!string.IsNullOrWhiteSpace(section.IrcName))
                    sections.Add(section.IrcName.Trim());
            }

            foreach (var section in cfg.RaceSectionsEnabled ?? new List<string>())
            {
                if (!string.IsNullOrWhiteSpace(section))
                    sections.Add(section.Trim());
            }
        }

        _sectionNames = sections
            .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (!string.IsNullOrWhiteSpace(_section) &&
            !_sectionNames.Contains(_section, StringComparer.OrdinalIgnoreCase))
        {
            _section = "";
        }
    }

    private async Task Run()
    {
        _results.Clear();

        if (string.IsNullOrWhiteSpace(_site) || string.IsNullOrWhiteSpace(_section) ||
            string.IsNullOrWhiteSpace(_release))
        {
            Add("Pick a site and fill in both the section and the release name.", "warning");
            return;
        }

        _running = true;
        try
        {
            // Same pipeline the racer uses, so the outcome here matches a real announce.
            RaceHelper.LoadAllSiteConfigs();

            var configSite = _site == "*" ? ResolveConfigSiteForSection(_section) : _site;
            if (string.IsNullOrWhiteSpace(configSite))
            {
                Add($"No site config contains IRC section '{_section}'.", "error");
                return;
            }

            var cfg = Sites.Load(configSite);
            var json = JObject.Parse(Newtonsoft.Json.JsonConvert.SerializeObject(cfg));

            Add($"Site: {_site}   Section: {_section}   Release: {_release}");

            // 1. section -> cbftp mapping
            var cbftpSection = RaceHelper.GetMappedCbftpSection(
                _section, _release, json,
                cfg.SiteSettings?.SectionPrefix,
                cfg.SiteSettings?.SectionSuffix);

            if (string.IsNullOrEmpty(cbftpSection) || cbftpSection.StartsWith("[ERROR]"))
            {
                Add($"No CBFTP mapping for IRC section '{_section}'. Add it under the site's Sections tab.", "error");
                return;
            }

            Add($"Mapped to CBFTP section: {cbftpSection}", "success");

            // 2. which sites would race it
            var raceSections = cfg.RaceSectionsEnabled?.ToDictionary(s => s, _ => string.Empty)
                               ?? new Dictionary<string, string>();

            var result = await RaceHelper.FilterAllowedSites(
                raceSections,
                new Dictionary<string, string>(),
                cfg.GlobalBlacklist ?? new List<string>(),
                cbftpSection,
                _release,
                _release,
                cfg.SiteSettings?.SectionPrefix,
                cfg.SiteSettings?.SectionSuffix,
                _site,
                _section);

            switch (result.Status)
            {
                case FilterStatus.Success:
                    var dl = result.DlOnlySites ?? new List<string>();
                    Add($"{result.AllowedSites.Count} site(s) would race:", "success");
                    foreach (var s in result.AllowedSites)
                    {
                        var isDl = dl.Contains(s, StringComparer.OrdinalIgnoreCase);
                        Add(isDl ? $"   {s}   [DL-only: affil]" : $"   {s}", isDl ? "warning" : "info");
                    }
                    break;

                case FilterStatus.InsufficientSites:
                    Add(result.Message, "warning");
                    foreach (var s in result.AllowedSites ?? new List<string>())
                        Add($"   {s}");
                    break;

                default:
                    Add(result.Message, "warning");
                    break;
            }

            // The per-site reasons. Previously a release rejected by twelve different site
            // rules rendered as one line ("All sites were filtered out"), which told you
            // nothing about which rule to change.
            if (result.Skips.Count > 0)
            {
                Add("", "info");
                Add($"Skipped ({result.Skips.Count}):", "warning");

                foreach (var s in result.Skips)
                {
                    var where = string.IsNullOrEmpty(s.Site) ? "" : $"{s.Site}: ";
                    Add($"   {where}{s.Reason} — {s.Detail}", "warning");
                }
            }
        }
        catch (Exception ex)
        {
            Add($"Test failed: {ex.Message}", "error");
        }
        finally
        {
            _running = false;
        }
    }

    private string ResolveConfigSiteForSection(string section)
    {
        foreach (var name in _siteNames)
        {
            var cfg = Sites.Load(name);
            var hasSection = (cfg.Sections ?? new List<Section>())
                .Any(s => string.Equals(s.IrcName, section, StringComparison.OrdinalIgnoreCase))
                || (cfg.RaceSectionsEnabled ?? new List<string>())
                    .Any(s => string.Equals(s, section, StringComparison.OrdinalIgnoreCase));

            if (hasSection)
                return name;
        }

        return "";
    }
}
