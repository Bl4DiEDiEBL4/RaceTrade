@page "/test"
@inject SiteStore Sites
@using Newtonsoft.Json.Linq

<PageTitle>Test release - RaceTrade</PageTitle>

<div class="page-head">
    <h1><Icon Name="test" Size="18" />Test release</h1>
</div>

<div class="panel form">
    <div class="form-grid wide">
        <label>Announcing site</label>
        <select value="@_site" @onchange="SelectSite">
            <option value="">-- pick a site --</option>
            <option value="*">* (any site / prespam bot)</option>
            @foreach (var s in _siteNames)
            {
                <option value="@s">@s</option>
            }
        </select>

        <label>IRC section</label>
        <select value="@_section" @onchange="SelectSection" disabled="@(!_sectionNames.Any())">
            @if (_sectionNames.Count == 0)
            {
                <option value="">-- pick a site first --</option>
            }
            else
            {
                <option value="">-- pick an IRC section --</option>
                @foreach (var ircSection in _sectionNames)
                {
                    <option value="@ircSection">@ircSection</option>
                }
            }
        </select>

        <label>Release name</label>
        <input type="text" @bind="_release" placeholder="Some.Release.2026.1080p.WEB-GRP" @bind:event="oninput" />
    </div>

    <div class="form-actions">
        <button class="btn primary" @onclick="Run" disabled="@_running">
            @(_running ? "Testing..." : "Run test")
        </button>
        <button class="btn danger" @onclick="ClearResults" disabled="@_running">
            Clear
        </button>
    </div>
</div>

@if (_results.Count > 0)
{
    <h2>RESULT</h2>
    <div class="panel">
        <table class="grid logs">
            <tbody>
                @foreach (var r in _results)
                {
                    <tr class="lvl-@r.Level">
                        <td class="msg">@r.Text</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_siteRows.Count > 0)
{
    <h2>PER SITE: @_siteRows.Count(r => r.Races) would race, @_siteRows.Count(r => !r.Races) blocked</h2>
    <div class="panel">
        <table class="grid test-sites">
            <thead>
                <tr>
                    <th>SITE</th>
                    <th>RESULT</th>
                    <th>FXP SECTION</th>
                    <th>STAGE</th>
                    <th>WHY</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _siteRows)
                {
                    <tr class="@(row.Races ? "test-race" : "test-blocked")">
                        <td class="site"><SiteList Value="@row.Site" /></td>
                        <td><span class="pill @row.PillClass">@row.Outcome</span></td>
                        <td class="section">@row.Section</td>
                        <td class="dim">@row.Stage</td>
                        <td class="msg"><div class="msg-body">@row.Detail</div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private sealed record Line(string Text, string Level);

    // One row per site the racer looked at: allowed (race / dl-only) or blocked, and why.
    private sealed record SiteRow(string Site, bool Races, string Outcome, string PillClass, string Section, string Stage, string Detail);

    private List<string> _siteNames = new();
    private List<string> _sectionNames = new();
    private List<Line> _results = new();
    private List<SiteRow> _siteRows = new();
    private string _site = "*";
    private string _section = "";
    private string _release = "";
    private bool _running;

    protected override void OnInitialized()
    {
        _siteNames = Sites.ListNames().ToList();
        LoadSectionNames();
    }

    private void Add(string text, string level = "info") => _results.Add(new Line(text, level));

    private static Dictionary<string, string> BuildRaceSectionDictionary(IEnumerable<string>? sections)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var section in sections ?? Enumerable.Empty<string>())
        {
            var name = section?.Trim();
            if (string.IsNullOrWhiteSpace(name))
                continue;

            result[name] = string.Empty;
        }

        return result;
    }

    private void ClearResults()
    {
        _results.Clear();
        _siteRows.Clear();
    }

    // "SectionDisabled" -> "Section disabled"
    private static string Humanize(string reason)
    {
        if (string.IsNullOrEmpty(reason)) return "";
        var spaced = System.Text.RegularExpressions.Regex.Replace(reason, "(?<=[a-z0-9])([A-Z])", " $1");
        return char.ToUpperInvariant(spaced[0]) + spaced.Substring(1).ToLowerInvariant();
    }

    private void BuildSiteRows(FilterResult result, string fxpBackendSection)
    {
        _siteRows.Clear();

        var allowed = result.AllowedSites ?? new List<string>();
        var dlOnly = result.DlOnlySites ?? new List<string>();
        var sections = result.SiteSections ?? new Dictionary<string, string>();

        foreach (var site in allowed.OrderBy(s => s, StringComparer.OrdinalIgnoreCase))
        {
            var isDl = dlOnly.Contains(site, StringComparer.OrdinalIgnoreCase);
            var section = sections.TryGetValue(site, out var own) && !string.IsNullOrWhiteSpace(own)
                ? own
                : fxpBackendSection;
            var sectionNote = string.Equals(section, fxpBackendSection, StringComparison.OrdinalIgnoreCase)
                ? ""
                : " (this site's own mapping)";

            _siteRows.Add(new SiteRow(
                site,
                true,
                isDl ? "DL ONLY" : "RACE",
                isDl ? "dl" : "race-completed",
                section,
                isDl ? "Affil" : "Passed all filters",
                isDl ? "Release group is in this site's affils: downloads only, no upload" : "Mapping, section, skiplist, filters, rules and blacklist all passed" + sectionNote));
        }

        // Per-site rejections. Announce-stage ones (no site) are already in the log above.
        foreach (var skip in result.Skips.Where(s => !string.IsNullOrEmpty(s.Site))
                     .OrderBy(s => s.Reason.ToString())
                     .ThenBy(s => s.Site, StringComparer.OrdinalIgnoreCase))
        {
            _siteRows.Add(new SiteRow(
                skip.Site,
                false,
                "BLOCKED",
                "race-filtered",
                string.IsNullOrWhiteSpace(skip.Section) ? "" : skip.Section,
                Humanize(skip.Reason.ToString()),
                skip.Detail ?? ""));
        }
    }

    private void SelectSite(ChangeEventArgs e)
    {
        _site = e.Value?.ToString() ?? "";
        LoadSectionNames();
    }

    private void SelectSection(ChangeEventArgs e)
    {
        _section = e.Value?.ToString() ?? "";
    }

    private void LoadSectionNames()
    {
        var sections = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        IEnumerable<string> names = _site switch
        {
            "" => Array.Empty<string>(),
            "*" => _siteNames,
            _ => new[] { _site }
        };

        foreach (var name in names)
        {
            var cfg = Sites.Load(name);

            foreach (var section in cfg.Sections ?? new List<Section>())
            {
                if (!string.IsNullOrWhiteSpace(section.IrcName))
                    sections.Add(section.IrcName.Trim());
            }

            foreach (var section in cfg.RaceSectionsEnabled ?? new List<string>())
            {
                if (!string.IsNullOrWhiteSpace(section))
                    sections.Add(section.Trim());
            }
        }

        _sectionNames = sections
            .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (!string.IsNullOrWhiteSpace(_section) &&
            !_sectionNames.Contains(_section, StringComparer.OrdinalIgnoreCase))
        {
            _section = "";
        }
    }

    private async Task Run()
    {
        _results.Clear();
        _siteRows.Clear();

        if (string.IsNullOrWhiteSpace(_site) || string.IsNullOrWhiteSpace(_section) ||
            string.IsNullOrWhiteSpace(_release))
        {
            Add("Pick a site and fill in both the section and the release name.", "warning");
            return;
        }

        _running = true;
        try
        {
            // Same pipeline the racer uses, so the outcome here matches a real announce.
            RaceHelper.LoadAllSiteConfigs();

            var configSite = _site == "*" ? ResolveConfigSiteForSection(_section) : _site;
            if (string.IsNullOrWhiteSpace(configSite))
            {
                Add($"No site config contains IRC section '{_section}'.", "error");
                return;
            }

            var cfg = Sites.Load(configSite);
            var json = JObject.Parse(Newtonsoft.Json.JsonConvert.SerializeObject(cfg));

            Add($"Site: {_site}   Section: {_section}   Release: {_release}");
            var isGlobalPreBotMode = IsConfiguredGlobalPreBotMode(cfg.SiteSettings?.PreOrSite);
            var effectiveSection = _section;
            var classifier = ReleaseClassifier.Classify(_release, _section, cfg.SiteSettings?.SectionDetectionMode);
            if (!string.Equals(classifier.FinalSection, _section, StringComparison.OrdinalIgnoreCase))
            {
                effectiveSection = classifier.FinalSection;
                Add($"Classifier changed section: {_section} -> {effectiveSection}", "success");
                foreach (var step in classifier.Steps)
                    Add($"   pass {step.Pass}: {step.FromSection} -> {step.ToSection} ({step.RuleName})", "info");
            }
            else
            {
                Add($"Detected section: {effectiveSection}", "info");
            }

            // 1. section -> FXP backend mapping
            var fxpBackendSection = RaceHelper.GetMappedFxpBackendSection(
                effectiveSection, _release, json,
                cfg.SiteSettings?.SectionPrefix,
                cfg.SiteSettings?.SectionSuffix);

            if (string.IsNullOrEmpty(fxpBackendSection) || fxpBackendSection.StartsWith("[ERROR]"))
            {
                Add($"No FXP backend mapping for IRC section '{effectiveSection}'. Add it under the site's Sections tab.", "error");
                return;
            }

            Add($"Final FXP backend section: {fxpBackendSection}", "success");

            // 2. which sites would race it
            var raceSections = BuildRaceSectionDictionary(cfg.RaceSectionsEnabled);

            var result = await RaceHelper.FilterAllowedSites(
                raceSections,
                new Dictionary<string, string>(),
                cfg.GlobalBlacklist ?? new List<string>(),
                fxpBackendSection,
                _release,
                _release,
                cfg.SiteSettings?.SectionPrefix,
                cfg.SiteSettings?.SectionSuffix,
                _site,
                isGlobalPreBotMode ? effectiveSection : null);

            switch (result.Status)
            {
                case FilterStatus.Success:
                    Add($"WOULD RACE on {result.AllowedSites.Count} site(s). See the per-site table below.", "success");
                    break;

                case FilterStatus.InsufficientSites:
                    Add($"{result.Message} See the per-site table below for why the others were blocked.", "warning");
                    break;

                default:
                    Add(result.Message, "warning");
                    break;
            }

            // Announce-stage rejections (no site) stay in the log; everything per site
            // goes into the table below, one row per site with the stage and reason.
            var announceSkips = result.Skips.Where(s => string.IsNullOrEmpty(s.Site)).ToList();
            if (announceSkips.Count > 0)
            {
                Add("", "info");
                foreach (var s in announceSkips)
                    Add($"{Humanize(s.Reason.ToString())}: {s.Detail}", "warning");
            }

            BuildSiteRows(result, fxpBackendSection);
        }
        catch (Exception ex)
        {
            Add($"Test failed: {ex.Message}", "error");
        }
        finally
        {
            _running = false;
        }
    }

    private string ResolveConfigSiteForSection(string section)
    {
        foreach (var name in _siteNames)
        {
            var cfg = Sites.Load(name);
            var hasSection = (cfg.Sections ?? new List<Section>())
                .Any(s => string.Equals(s.IrcName, section, StringComparison.OrdinalIgnoreCase))
                || (cfg.RaceSectionsEnabled ?? new List<string>())
                    .Any(s => string.Equals(s, section, StringComparison.OrdinalIgnoreCase));

            if (hasSection)
                return name;
        }

        return "";
    }

    private static bool IsConfiguredGlobalPreBotMode(string? mode)
    {
        if (string.IsNullOrWhiteSpace(mode))
            return false;

        var match = System.Text.RegularExpressions.Regex.Match(
            mode,
            @"^Global\s+PreBot\s*\(([^)]+)\)\s*$",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return match.Success && !string.IsNullOrWhiteSpace(match.Groups[1].Value);
    }
}
