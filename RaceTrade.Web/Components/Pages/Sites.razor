@page "/sites"
@inject SiteStore Store
@inject SiteConnectionTestService SiteTester
@inject CbftpSiteService CbftpSites

<PageTitle>Sites - RaceTrade</PageTitle>

<div class="page-head">
    <h1><Icon Name="sites" Size="18" />Sites</h1>
    <div class="head-actions">
        <a class="btn primary" href="sites/new"><Icon Name="plus" Size="13" /><span>Add site</span></a>
    </div>
</div>

@if (_error is not null)
{
    <p class="hint err">@_error</p>
}

@if (_siteTestResult is not null)
{
    <div class="site-test-result @(_siteTestResult.Success ? "ok" : "err")">
        <strong>@(_siteTestResult.Success ? "CBFTP site check passed" : "CBFTP site check failed")</strong>
        <span>@_siteTestResult.Message</span>
        @if (_siteTestResult.Details.Count > 0)
        {
            <ul>
                @foreach (var detail in _siteTestResult.Details)
                {
                    <li>@detail</li>
                }
            </ul>
        }
    </div>
}

<div class="panel">
    @if (_rows.Count == 0)
    {
        <div class="empty">No sites yet. Use <strong>+ Add site</strong> to create one.</div>
    }
    else
    {
        <table class="grid sites-table">
            <colgroup>
                <col class="c-site" />
                <col class="c-host" />
                <col class="c-network" />
                <col class="c-small" />
                <col class="c-small" />
                <col class="c-status" />
                <col class="c-actions" />
            </colgroup>
            <thead>
                <tr>
                    <th>SITE</th><th>ZNC HOST</th><th>NETWORK</th>
                    <th>CHANNELS</th><th>SECTIONS</th><th class="site-status">STATUS</th><th class="site-actions-head">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td class="site">@r.Name</td>
                        <td>@r.Host</td>
                        <td>@r.Network</td>
                        <td class="dim">@r.Channels</td>
                        <td class="dim">@r.Sections</td>
                        <td class="site-status">
                            @if (r.Disabled)
                            {
                                <button type="button"
                                        class="pill status-toggle off"
                                        title="Enable this site"
                                        @onclick="() => ToggleDisabled(r.Name)">
                                    disabled
                                </button>
                            }
                            else if (r.DlOnly)
                            {
                                <button type="button"
                                        class="pill status-toggle dl"
                                        title="Disable this site"
                                        @onclick="() => ToggleDisabled(r.Name)">
                                    dl-only
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="pill status-toggle on"
                                        title="Disable this site"
                                        @onclick="() => ToggleDisabled(r.Name)">
                                    enabled
                                </button>
                            }
                        </td>
                        <td class="site-actions">
                            <div class="site-action-row">
                                <button class="btn" title="Check the CBFTP site config" disabled="@IsBusy"
                                        @onclick="() => TestSite(r.Name)">
                                    <Icon Name="test" Size="13" /><span>@ActionText(r.Name, "test", "Test")</span>
                                </button>
                                <button class="btn" title="Test the CBFTP site login with a root listing" disabled="@IsBusy"
                                        @onclick="() => LoginSite(r.Name)">
                                    <Icon Name="play" Size="13" /><span>@ActionText(r.Name, "login", "Login")</span>
                                </button>
                                <button class="btn" title="Duplicate the RaceTrade site config" disabled="@IsBusy"
                                        @onclick="() => OpenDuplicateSite(r.Name)">
                                    <Icon Name="copy" Size="13" /><span>Duplicate</span>
                                </button>
                                <button class="btn" title="Duplicate the CBFTP site config" disabled="@IsBusy"
                                        @onclick="() => OpenDuplicateCbftpSite(r.Name)">
                                    <Icon Name="copy" Size="13" /><span>Copy CBFTP</span>
                                </button>
                                <a class="btn" href="@($"sites/edit/{Uri.EscapeDataString(r.Name)}")"><Icon Name="edit" Size="13" /><span>Edit</span></a>
                                <a class="btn" href="@($"cbftp-site/{Uri.EscapeDataString(r.Name)}")"><Icon Name="servers" Size="13" /><span>Edit CBFTP Site</span></a>
                                <button class="btn danger" disabled="@IsBusy" @onclick="() => Delete(r.Name)"><Icon Name="trash" Size="13" /><span>Delete</span></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (_duplicateSiteSource is not null)
{
    <div class="modal-backdrop" @onclick="CloseDuplicateSite">
        <div class="modal-card duplicate-modal" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2>Duplicate RaceTrade Site</h2>
                <button class="btn icon-only" @onclick="CloseDuplicateSite" aria-label="Close"><Icon Name="close" Size="15" /></button>
            </div>
            <div class="modal-body duplicate-body">
                <div class="selected-block">
                    <span class="label">Source site</span>
                    <strong>@_duplicateSiteSource</strong>
                </div>
                <label>New site name</label>
                <input type="text" @bind="_duplicateSiteName" @bind:event="oninput" placeholder="NEW-SITE" />
                <p class="hint">
                    The RaceTrade site name and CBFTP site name should be the same. If you duplicate both,
                    use this exact name in the CBFTP duplicate popup too.
                </p>
                <div class="modal-actions">
                    <button class="btn" @onclick="CloseDuplicateSite" disabled="@IsBusy">Cancel</button>
                    <button class="btn primary" @onclick="ConfirmDuplicateSite" disabled="@IsBusy">
                        <Icon Name="copy" Size="13" /><span>Duplicate site</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_duplicateCbftpSource is not null)
{
    <div class="modal-backdrop" @onclick="CloseDuplicateCbftpSite">
        <div class="modal-card duplicate-modal" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2>Duplicate CBFTP Site</h2>
                <button class="btn icon-only" @onclick="CloseDuplicateCbftpSite" aria-label="Close"><Icon Name="close" Size="15" /></button>
            </div>
            <div class="modal-body duplicate-body">
                <div class="selected-block">
                    <span class="label">Source CBFTP site</span>
                    <strong>@_duplicateCbftpSource</strong>
                </div>
                <label>CBFTP server</label>
                <select @bind="_duplicateCbftpServerId" disabled="@IsBusy">
                    @foreach (var server in _duplicateCbftpServers)
                    {
                        <option value="@server.Id">@DisplayCbftpServer(server)</option>
                    }
                </select>
                <label>New CBFTP site name</label>
                <input type="text" @bind="_duplicateCbftpName" @bind:event="oninput" placeholder="NEW-SITE" />
                <p class="hint">
                    Keep this identical to the RaceTrade site name. RaceTrade looks up CBFTP site configs by name,
                    so mismatched names make testing, FXP and racing confusing.
                </p>
                <div class="modal-actions">
                    <button class="btn" @onclick="CloseDuplicateCbftpSite" disabled="@IsBusy">Cancel</button>
                    <button class="btn primary" @onclick="ConfirmDuplicateCbftpSite" disabled="@(IsBusy || !_duplicateCbftpServers.Any())">
                        <Icon Name="copy" Size="13" /><span>Duplicate CBFTP site</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private sealed record Row(string Name, string Host, string Network,
                              int Channels, int Sections, bool Disabled, bool DlOnly);

    private List<Row> _rows = new();
    private List<CbftpServer> _duplicateCbftpServers = new();
    private string? _error;
    private SiteConnectionTestResult? _siteTestResult;
    private string? _busySite;
    private string? _busyAction;
    private string? _duplicateSiteSource;
    private string _duplicateSiteName = "";
    private string? _duplicateCbftpSource;
    private string _duplicateCbftpName = "";
    private string _duplicateCbftpServerId = "";
    private bool _duplicating;

    private bool IsBusy => _busySite is not null || _duplicating;

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        try
        {
            _error = null;
            _siteTestResult = null;
            _rows = Store.ListNames().Select(n =>
            {
                var c = Store.Load(n);
                var chans = SiteStore.ReadChannels(c.SiteSettings)
                    .Count(x => !string.IsNullOrWhiteSpace(x.Channel));

                return new Row(
                    n,
                    c.Server?.Host ?? "",
                    c.Server?.Network ?? "",
                    chans,
                    c.Sections?.Count ?? 0,
                    c.SiteSettings?.DisableSite ?? false,
                    c.SiteSettings?.DlOnlySite ?? false);
            }).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void Delete(string name)
    {
        try { Store.Delete(name); Reload(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void OpenDuplicateSite(string name)
    {
        _error = null;
        _siteTestResult = null;
        _duplicateSiteSource = name;
        _duplicateSiteName = SuggestLocalCopyName(name);
    }

    private void CloseDuplicateSite()
    {
        _duplicateSiteSource = null;
        _duplicateSiteName = "";
    }

    private void ConfirmDuplicateSite()
    {
        if (_duplicateSiteSource is null)
            return;

        try
        {
            _duplicating = true;
            _error = null;
            _siteTestResult = null;
            Store.Duplicate(_duplicateSiteSource, _duplicateSiteName);
            Reload();
            _siteTestResult = new SiteConnectionTestResult(
                true,
                $"Duplicated RaceTrade site '{_duplicateSiteSource}' as '{_duplicateSiteName.Trim()}'.",
                new[] { "Use the same name when duplicating the CBFTP site." });
            CloseDuplicateSite();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _duplicating = false;
        }
    }

    private void OpenDuplicateCbftpSite(string name)
    {
        _error = null;
        _siteTestResult = null;
        _duplicateCbftpSource = name;
        _duplicateCbftpName = SuggestCbftpCopyName(name);
        _duplicateCbftpServers = CbftpSites.LoadServers().ToList();
        _duplicateCbftpServerId = _duplicateCbftpServers.FirstOrDefault()?.Id ?? "";
    }

    private void CloseDuplicateCbftpSite()
    {
        _duplicateCbftpSource = null;
        _duplicateCbftpName = "";
        _duplicateCbftpServerId = "";
        _duplicateCbftpServers.Clear();
    }

    private async Task ConfirmDuplicateCbftpSite()
    {
        if (_duplicateCbftpSource is null)
            return;

        var server = _duplicateCbftpServers.FirstOrDefault(s => string.Equals(s.Id, _duplicateCbftpServerId, StringComparison.OrdinalIgnoreCase));
        if (server is null)
        {
            _error = "Select a CBFTP server first.";
            return;
        }

        try
        {
            _duplicating = true;
            _error = null;
            _siteTestResult = null;
            await CbftpSites.DuplicateSiteAsync(server, _duplicateCbftpSource, _duplicateCbftpName);
            _siteTestResult = new SiteConnectionTestResult(
                true,
                $"Duplicated CBFTP site '{_duplicateCbftpSource}' as '{_duplicateCbftpName.Trim()}'.",
                new[] { "Keep the RaceTrade site name and CBFTP site name identical." });
            CloseDuplicateCbftpSite();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _duplicating = false;
        }
    }

    private async Task TestSite(string name)
    {
        try
        {
            _error = null;
            _siteTestResult = null;
            _busySite = name;
            _busyAction = "test";
            _siteTestResult = await SiteTester.ValidateAsync(name);
        }
        catch (Exception ex)
        {
            _siteTestResult = SiteConnectionTestResult.Fail($"Could not test '{name}'.", new[] { ex.Message });
        }
        finally
        {
            _busySite = null;
            _busyAction = null;
        }
    }

    private async Task LoginSite(string name)
    {
        try
        {
            _error = null;
            _siteTestResult = null;
            _busySite = name;
            _busyAction = "login";
            _siteTestResult = await SiteTester.LoginAsync(name);
        }
        catch (Exception ex)
        {
            _siteTestResult = SiteConnectionTestResult.Fail($"Could not test login for '{name}'.", new[] { ex.Message });
        }
        finally
        {
            _busySite = null;
            _busyAction = null;
        }
    }

    private string ActionText(string site, string action, string fallback) =>
        string.Equals(_busySite, site, StringComparison.OrdinalIgnoreCase)
        && string.Equals(_busyAction, action, StringComparison.OrdinalIgnoreCase)
            ? "Testing..."
            : fallback;

    private void ToggleDisabled(string name)
    {
        try
        {
            var cfg = Store.Load(name);
            cfg.SiteSettings.DisableSite = !cfg.SiteSettings.DisableSite;
            Store.Save(cfg, name);
            Reload();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private string SuggestLocalCopyName(string source)
    {
        var names = Store.ListNames();
        return SuggestCopyName(source, candidate => names.Contains(candidate, StringComparer.OrdinalIgnoreCase));
    }

    private static string SuggestCbftpCopyName(string source) => $"{source}-copy";

    private static string SuggestCopyName(string source, Func<string, bool> exists)
    {
        var baseName = $"{source}-copy";
        if (!exists(baseName))
            return baseName;

        for (var i = 2; i < 1000; i++)
        {
            var candidate = $"{baseName}-{i}";
            if (!exists(candidate))
                return candidate;
        }

        return $"{baseName}-{DateTime.Now:HHmmss}";
    }

    private static string DisplayCbftpServer(CbftpServer server) =>
        $"{server.Name ?? server.Id} - {server.Host}:{server.Port}";
}
