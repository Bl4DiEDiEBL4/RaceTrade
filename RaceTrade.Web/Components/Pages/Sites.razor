@page "/sites"
@inject SiteStore Store
@inject SiteConnectionTestService SiteTester
@inject FxpBackendSiteService FxpBackendSites
@inject FxpBackendStore FxpBackendConfigStore
@inject SiteTransferService SiteTransfer

<PageTitle>Sites - RaceTrade</PageTitle>

<div class="page-head">
    <h1>
        <Icon Name="sites" Size="18" />Sites
        @if (_rows.Count > 0)
        {
            <span class="hint site-counts">@ActiveSiteCount active, @InactiveSiteCount inactive</span>
        }
    </h1>
    <div class="head-actions">
        <button class="btn" disabled="@IsBusy" @onclick="OpenImport"><Icon Name="folder" Size="13" /><span>Import</span></button>
        <button class="btn" disabled="@(IsBusy || _rows.Count == 0)" @onclick="() => OpenExport(null)"><Icon Name="download" Size="13" /><span>Export all</span></button>
        <a class="btn primary" href="sites/new"><Icon Name="plus" Size="13" /><span>Add site</span></a>
    </div>
</div>

@if (_error is not null)
{
    <p class="hint err">@_error</p>
}

@if (_siteTestResult is not null)
{
    <div class="site-test-result @(_siteTestResult.Success ? "ok" : "err")">
        <strong>@(_siteTestResult.Success ? "FXP backend site check passed" : "FXP backend site check failed")</strong>
        <span>@_siteTestResult.Message</span>
        @if (_siteTestResult.Details.Count > 0)
        {
            <ul>
                @foreach (var detail in _siteTestResult.Details)
                {
                    <li>@detail</li>
                }
            </ul>
        }
    </div>
}

<div class="panel">
    @if (_rows.Count == 0)
    {
        <div class="empty">No sites yet. Use <strong>+ Add site</strong> to create one.</div>
    }
    else
    {
        <div class="sites-table-wrap">
            <table class="grid sites-table">
                <colgroup>
                    <col class="c-site" />
                    <col class="c-fxp-backend" />
                    <col class="c-host" />
                    <col class="c-network" />
                    <col class="c-small" />
                    <col class="c-small" />
                    <col class="c-status" />
                    <col class="c-actions" />
                </colgroup>
                <thead>
                    <tr>
                        <th>SITE</th><th>FXP backend</th><th>ZNC HOST</th><th>NETWORK</th>
                        <th>CHANNELS</th><th>SECTIONS</th><th class="site-status">STATUS</th><th class="site-actions-head">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _rows)
                    {
                        <tr>
                            <td class="site">@r.Name</td>
                            <td class="dim">@DisplayEmpty(r.FxpBackend)</td>
                            <td>@r.Host</td>
                            <td>@r.Network</td>
                            <td class="dim">@r.Channels</td>
                            <td class="dim">@r.Sections</td>
                            <td class="site-status">
                                <div class="site-status-row">
                                    @if (r.EffectiveDisabled)
                                    {
                                        <button type="button"
                                                class="pill status-toggle off"
                                                title="Enable this site"
                                                @onclick="() => ToggleDisabled(r.Key)">
                                            @if (r.ServerMissing)
                                            {
                                                <text>mapping missing</text>
                                            }
                                            else if (r.LinkedServerDisabled)
                                            {
                                                <text>server disabled</text>
                                            }
                                            else
                                            {
                                                <text>disabled</text>
                                            }
                                        </button>
                                    }
                                    else if (r.DlOnly)
                                    {
                                        <button type="button"
                                                class="pill status-toggle dl"
                                                title="Disable this site"
                                                @onclick="() => ToggleDisabled(r.Key)">
                                            dl-only
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="pill status-toggle on"
                                                title="Disable this site"
                                                @onclick="() => ToggleDisabled(r.Key)">
                                            enabled
                                        </button>
                                    }
                                    <button type="button"
                                            class="pill status-toggle irc-source-pill @(r.IrcSourceEnabled ? "on" : "off")"
                                            title="@(r.IrcSourceEnabled ? "Disable IRC announce source" : "Enable IRC announce source")"
                                            @onclick="() => ToggleIrcSource(r.Key)">
                                        IRC @(r.IrcSourceEnabled ? "on" : "off")
                                    </button>
                                </div>
                            </td>
                            <td class="site-actions">
                                <div class="site-action-row">
                                    <button class="btn" title="Check the RaceTrade to FXP backend site mapping" disabled="@IsBusy"
                                            @onclick="() => TestSite(r.Key)">
                                        <Icon Name="test" Size="13" /><span>@ActionText(r.Key, "test", "Config")</span>
                                    </button>
                                    <button class="btn" title="Test the FXP backend site login with a root listing" disabled="@IsBusy"
                                            @onclick="() => LoginSite(r.Key)">
                                        <Icon Name="play" Size="13" /><span>@ActionText(r.Key, "login", "Login")</span>
                                    </button>
                                    <button class="btn" title="Duplicate the RaceTrade site config" disabled="@IsBusy"
                                            @onclick="() => OpenDuplicateSite(r.Key)">
                                        <Icon Name="copy" Size="13" /><span>Duplicate</span>
                                    </button>
                                    <button class="btn icon-only" title="Export this RaceTrade site" aria-label="@($"Export {r.Name}")" disabled="@IsBusy" @onclick="() => OpenExport(r.Key)">
                                        <Icon Name="download" Size="13" />
                                    </button>
                                    <button class="btn" title="Copy the FXP backend site config to another backend" disabled="@IsBusy"
                                            @onclick="() => OpenDuplicateFxpBackendSite(r.Key)">
                                        <Icon Name="copy" Size="13" /><span>Copy FXP backend</span>
                                    </button>
                                    <a class="btn" href="@($"sites/edit/{Uri.EscapeDataString(r.Key)}")"><Icon Name="edit" Size="13" /><span>Edit</span></a>
                                    <a class="btn" href="@($"fxp-backend-site/{Uri.EscapeDataString(r.Name)}")"><Icon Name="servers" Size="13" /><span>Edit FXP Backend Site</span></a>
                                    <button class="btn danger" disabled="@IsBusy" @onclick="() => AskDelete(r.Key)"><Icon Name="trash" Size="13" /><span>Delete</span></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_deleteSiteName is not null)
{
    <div class="modal-backdrop" @onclick="CancelDelete">
        <div class="modal-card duplicate-modal" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2>Delete site</h2>
                <button class="btn icon-only" @onclick="CancelDelete" aria-label="Close"><Icon Name="close" Size="15" /></button>
            </div>
            <div class="modal-body duplicate-body">
                <p>
                    Are you sure you want to delete <strong>@_deleteSiteName</strong>?
                    This removes the RaceTrade site config from disk and cannot be undone.
                    The site on the FXP backend itself is not touched.
                </p>
                <div class="head-actions">
                    <button class="btn danger" @onclick="ConfirmDelete"><Icon Name="trash" Size="13" /><span>Yes, delete</span></button>
                    <button class="btn" @onclick="CancelDelete"><Icon Name="close" Size="13" /><span>Cancel</span></button>
                </div>
            </div>
        </div>
    </div>
}

@if (_duplicateSiteSource is not null)
{
    <div class="modal-backdrop" @onclick="CloseDuplicateSite">
        <div class="modal-card duplicate-modal" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2>Duplicate RaceTrade Site</h2>
                <button class="btn icon-only" @onclick="CloseDuplicateSite" aria-label="Close"><Icon Name="close" Size="15" /></button>
            </div>
            <div class="modal-body duplicate-body">
                <div class="selected-block">
                    <span class="label">Source site</span>
                    <strong>@_duplicateSiteSource</strong>
                </div>
                <label>New site name</label>
                <input type="text" @bind="_duplicateSiteName" @bind:event="oninput" placeholder="NEW-SITE" />
                <p class="hint">
                    The RaceTrade site name and FXP backend site name should be the same. If you duplicate both,
                    use this exact name in the FXP backend duplicate popup too.
                </p>
                <div class="modal-actions">
                    <button class="btn" @onclick="CloseDuplicateSite" disabled="@IsBusy">Cancel</button>
                    <button class="btn primary" @onclick="ConfirmDuplicateSite" disabled="@IsBusy">
                        <Icon Name="copy" Size="13" /><span>Duplicate site</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_duplicateFxpBackendSource is not null)
{
    <div class="modal-backdrop" @onclick="CloseDuplicateFxpBackendSite">
        <div class="modal-card duplicate-modal" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2>Copy FXP Backend Site</h2>
                <button class="btn icon-only" @onclick="CloseDuplicateFxpBackendSite" aria-label="Close"><Icon Name="close" Size="15" /></button>
            </div>
            <div class="modal-body duplicate-body">
                <div class="selected-block">
                    <span class="label">Source FXP backend site</span>
                    <strong>@_duplicateFxpBackendSource</strong>
                </div>
                <label>From backend</label>
                <select @bind="_duplicateFxpBackendSourceId" disabled="@IsBusy">
                    @foreach (var server in _duplicateFxpBackends)
                    {
                        <option value="@server.Id">@DisplayFxpBackend(server)</option>
                    }
                </select>
                <label>To backend</label>
                <select @bind="_duplicateFxpBackendTargetId" disabled="@IsBusy">
                    @foreach (var server in _duplicateFxpBackends)
                    {
                        <option value="@server.Id">@DisplayFxpBackend(server)</option>
                    }
                </select>
                <label>New FXP backend site name</label>
                <input type="text" @bind="_duplicateFxpBackendName" @bind:event="oninput" placeholder="NEW-SITE" />
                <p class="hint">
                    Duplicate keeps the site on the same backend. Copy FXP backend site lets you copy this backend
                    config from one CBFTP/WeaveFXP server to another. Keep the backend site name identical to the
                    RaceTrade site name unless you also rename the RaceTrade site.
                </p>
                <div class="modal-actions">
                    <button class="btn" @onclick="CloseDuplicateFxpBackendSite" disabled="@IsBusy">Cancel</button>
                    <button class="btn primary" @onclick="ConfirmDuplicateFxpBackendSite" disabled="@(IsBusy || !_duplicateFxpBackends.Any())">
                        <Icon Name="copy" Size="13" /><span>Copy FXP backend site</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showExport)
{
    <div class="modal-backdrop" @onclick="CloseExport">
        <div class="modal-card duplicate-modal" role="dialog" aria-modal="true" aria-labelledby="site-export-title" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2 id="site-export-title">Export @(_exportKey is null ? "all sites" : "site")</h2>
                <button class="btn icon-only" aria-label="Close" @onclick="CloseExport"><Icon Name="close" Size="15" /></button>
            </div>
            <div class="modal-body duplicate-body site-transfer-body">
                <strong>@(_exportKey is null ? $"{_rows.Count} sites" : _rows.FirstOrDefault(r => r.Key == _exportKey)?.Name)</strong>
                <label class="site-transfer-option"><input type="checkbox" @bind="_exportSecrets" />Include IRC login and FiSH keys</label>
                @if (_exportSecrets)
                {
                    <p class="hint err">Warning: passwords and keys will be readable in the downloaded file. Share it only with trusted users.</p>
                }
                else
                {
                    <p class="hint">IRC usernames, passwords and FiSH keys are excluded.</p>
                }
                <p class="hint">RaceTrade settings only. FTP backend logins and server configurations are not included.</p>
                <div class="modal-actions">
                    <button class="btn" @onclick="CloseExport">Cancel</button>
                    <a class="btn primary" href="@ExportUrl" data-enhance-nav="false" download><Icon Name="download" Size="13" /><span>Download JSON</span></a>
                </div>
            </div>
        </div>
    </div>
}

@if (_showImport)
{
    <div class="modal-backdrop" @onclick="CloseImport">
        <div class="modal-card site-import-modal" role="dialog" aria-modal="true" aria-labelledby="site-import-title" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2 id="site-import-title">Import sites</h2>
                <button class="btn icon-only" aria-label="Close" disabled="@_transferring" @onclick="CloseImport"><Icon Name="close" Size="15" /></button>
            </div>
            <div class="modal-body duplicate-body site-transfer-body">
                <label for="site-import-file">JSON file</label>
                <InputFile id="site-import-file" accept=".json,application/json" OnChange="ReadImportFile" disabled="@_transferring" />
                @if (_importError is not null)
                {
                    <p class="hint err" role="alert">@_importError</p>
                }
                @if (_importChoices.Count > 0)
                {
                    <label for="site-import-backend">Destination FXP backend</label>
                    <select id="site-import-backend" @bind="_importBackend" disabled="@_transferring">
                        <option value="">Unassigned (configure later)</option>
                        @foreach (var backend in _importBackends)
                        {
                            <option value="@backend.Id">@DisplayFxpBackend(backend)</option>
                        }
                    </select>
                    <div class="site-import-preview">
                        <table class="grid">
                            <thead><tr><th><input type="checkbox" aria-label="Select all sites" checked="@_importChoices.All(c => c.Selected)" @onchange="ToggleImportSelection" /></th><th>Site name</th><th>Sections</th></tr></thead>
                            <tbody>
                                @foreach (var choice in _importChoices)
                                {
                                    <tr @key="choice">
                                        <td><input type="checkbox" @bind="choice.Selected" aria-label="@($"Import {choice.Config.SiteSettings.Sitename}")" /></td>
                                        <td><input type="text" @bind="choice.Config.SiteSettings.Sitename" aria-label="Imported site name" maxlength="128" /></td>
                                        <td>@choice.Config.Sections.Count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <label class="site-transfer-option"><input type="checkbox" @bind="_importOverwrite" />Replace existing sites on this backend</label>
                    @if (_importOverwrite)
                    {
                        <p class="hint err">Existing rules and settings will be replaced. Credentials omitted from the file are kept.</p>
                    }
                    <label class="site-transfer-option"><input type="checkbox" @bind="_importDisabled" />Import sites disabled</label>
                    <p class="hint">The RaceTrade site name must match the site name on the selected FXP backend. Backend sites are not created by this import.</p>
                }
            </div>
            <div class="modal-actions site-transfer-actions">
                <button class="btn" disabled="@_transferring" @onclick="CloseImport">Cancel</button>
                <button class="btn primary" disabled="@(_transferring || !_importChoices.Any(c => c.Selected))" @onclick="ConfirmImport"><Icon Name="save" Size="13" /><span>@(_transferring ? "Importing..." : "Import selected")</span></button>
            </div>
        </div>
    </div>
}

@code {
    private sealed class ImportChoice(SiteConfig config)
    {
        public SiteConfig Config { get; } = config;
        public bool Selected { get; set; } = true;
    }
    private bool _showExport;
    private string? _exportKey;
    private bool _exportSecrets;
    private bool _showImport;
    private bool _transferring;
    private string? _importError;
    private string _importBackend = "";
    private bool _importOverwrite;
    private bool _importDisabled = true;
    private List<ImportChoice> _importChoices = new();
    private List<FxpBackend> _importBackends = new();
    private string ExportUrl => $"sites/export?includeSecrets={_exportSecrets.ToString().ToLowerInvariant()}" +
        (_exportKey is null ? "" : $"&key={Uri.EscapeDataString(_exportKey)}");

    private void OpenExport(string? key)
    {
        _exportKey = key;
        _exportSecrets = false;
        _showExport = true;
    }
    private void CloseExport() => _showExport = false;
    private void OpenImport()
    {
        _importChoices.Clear();
        _importError = null;
        _importBackend = "";
        _importOverwrite = false;
        _importDisabled = true;
        _importBackends = FxpBackendConfigStore.Load().FxpBackends.ToList();
        _showImport = true;
    }
    private void CloseImport()
    {
        if (_transferring) return;
        _showImport = false;
        _importChoices.Clear();
    }
    private async Task ReadImportFile(InputFileChangeEventArgs args)
    {
        _importChoices.Clear();
        _importError = null;
        try
        {
            _transferring = true;
            await using var stream = args.File.OpenReadStream(SiteTransferService.MaxFileBytes);
            using var reader = new System.IO.StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            _importChoices = SiteTransfer.Parse(json).Select(c => new ImportChoice(c)).ToList();
        }
        catch (Exception)
        {
            _importError = "Could not read this file. Choose a valid RaceTrade site JSON file of 5 MB or smaller.";
        }
        finally { _transferring = false; }
    }
    private void ToggleImportSelection(ChangeEventArgs args)
    {
        foreach (var choice in _importChoices) choice.Selected = args.Value is true;
    }
    private void ConfirmImport()
    {
        try
        {
            _transferring = true;
            _importError = null;
            if (_importBackend.Length > 0 && !_importBackends.Any(b => b.Id == _importBackend))
                throw new InvalidOperationException("Choose an available FXP backend.");
            var result = SiteTransfer.Import(_importChoices.Where(c => c.Selected).Select(c => c.Config),
                _importBackend, _importOverwrite, _importDisabled);
            Reload();
            _siteTestResult = new SiteConnectionTestResult(result.Errors.Count == 0,
                $"{result.Imported} site(s) imported, {result.Skipped} existing site(s) skipped, {result.Errors.Count} failed.",
                result.Errors.Concat(new[] { "Restart the trader after changing site settings." }).ToList());
            _showImport = false;
            _importChoices.Clear();
        }
        catch (Exception ex) { _importError = ex.Message; }
        finally { _transferring = false; }
    }
    private sealed record Row(string Key, string Name, string FxpBackend, string Host, string Network,
                              int Channels, int Sections, bool Disabled, bool DlOnly,
                              bool LinkedServerDisabled, bool ServerMissing, bool EffectiveDisabled,
                              bool IrcSourceEnabled);

    private List<Row> _rows = new();
    private List<FxpBackend> _duplicateFxpBackends = new();
    private string? _error;
    private SiteConnectionTestResult? _siteTestResult;
    private string? _busySite;
    private string? _busyAction;
    private string? _duplicateSiteSource;
    private string _duplicateSiteName = "";
    private string? _duplicateFxpBackendSource;
    private string _duplicateFxpBackendName = "";
    private string _duplicateFxpBackendSourceId = "";
    private string _duplicateFxpBackendTargetId = "";
    private bool _duplicating;

    private bool IsBusy => _busySite is not null || _duplicating || _transferring;

    // "Inactive" is anything that will not race: disabled by the user, its FXP
    // backend disabled, or its backend missing (the same test the Racing/Off badge uses).
    private int ActiveSiteCount => _rows.Count(r => !r.EffectiveDisabled);
    private int InactiveSiteCount => _rows.Count(r => r.EffectiveDisabled);

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        try
        {
            _error = null;
            _siteTestResult = null;
            var fxpBackendServers = FxpBackendConfigStore.Load().FxpBackends;
            _rows = Store.ListNames().Select(n =>
            {
                var c = Store.Load(n);
                var chans = SiteStore.ReadChannels(c.SiteSettings)
                    .Count(x => !string.IsNullOrWhiteSpace(x.Channel));
                var configuredServer = ResolveFxpBackend(fxpBackendServers, c.SiteSettings?.FxpBackendId);
                var linkedServerDisabled = configuredServer is not null && configuredServer.Disabled;
                var serverMissing = !string.IsNullOrWhiteSpace(c.SiteSettings?.FxpBackendId) &&
                                    configuredServer is null;
                var siteDisabled = c.SiteSettings?.DisableSite ?? false;
                var effectiveDisabled = siteDisabled || linkedServerDisabled || serverMissing;

                var displayName = c.SiteSettings?.Sitename?.Trim();
                if (string.IsNullOrWhiteSpace(displayName))
                    displayName = n;

                return new Row(
                    n,
                    displayName,
                    c.SiteSettings?.FxpBackendId ?? "",
                    c.Server?.Host ?? "",
                    c.Server?.Network ?? "",
                    chans,
                    c.Sections?.Count ?? 0,
                    siteDisabled,
                    c.SiteSettings?.DlOnlySite ?? false,
                    linkedServerDisabled,
                    serverMissing,
                    effectiveDisabled,
                    c.SiteSettings?.IrcAnnounceEnabled != false);
            }).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private string? _deleteSiteName;

    private void AskDelete(string name)
    {
        _error = null;
        _deleteSiteName = name;
    }

    private void CancelDelete() => _deleteSiteName = null;

    private void ConfirmDelete()
    {
        var name = _deleteSiteName;
        _deleteSiteName = null;
        if (string.IsNullOrWhiteSpace(name))
            return;

        try { Store.Delete(name); Reload(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void OpenDuplicateSite(string name)
    {
        _error = null;
        _siteTestResult = null;
        _duplicateSiteSource = name;
        _duplicateSiteName = SuggestLocalCopyName(name);
    }

    private void CloseDuplicateSite()
    {
        _duplicateSiteSource = null;
        _duplicateSiteName = "";
    }

    private void ConfirmDuplicateSite()
    {
        if (_duplicateSiteSource is null)
            return;

        try
        {
            _duplicating = true;
            _error = null;
            _siteTestResult = null;
            Store.Duplicate(_duplicateSiteSource, _duplicateSiteName);
            Reload();
            _siteTestResult = new SiteConnectionTestResult(
                true,
                $"Duplicated RaceTrade site '{_duplicateSiteSource}' as '{_duplicateSiteName.Trim()}'.",
                new[] { "Use the same name when duplicating the FXP backend site." });
            CloseDuplicateSite();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _duplicating = false;
        }
    }

    private void OpenDuplicateFxpBackendSite(string name)
    {
        _error = null;
        _siteTestResult = null;
        var cfg = Store.Load(name);
        var remoteName = cfg.SiteSettings?.Sitename?.Trim();
        if (string.IsNullOrWhiteSpace(remoteName))
            remoteName = name;

        _duplicateFxpBackendSource = remoteName;
        _duplicateFxpBackendName = SuggestFxpBackendCopyName(remoteName);
        _duplicateFxpBackends = FxpBackendSites.LoadServers().ToList();
        var configured = cfg.SiteSettings?.FxpBackendId?.Trim();
        _duplicateFxpBackendSourceId = _duplicateFxpBackends.FirstOrDefault(s =>
            string.Equals(s.Id, configured, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(s.Name, configured, StringComparison.OrdinalIgnoreCase))?.Id
            ?? _duplicateFxpBackends.FirstOrDefault()?.Id
            ?? "";
        _duplicateFxpBackendTargetId = _duplicateFxpBackends.FirstOrDefault(s =>
            !string.Equals(s.Id, _duplicateFxpBackendSourceId, StringComparison.OrdinalIgnoreCase))?.Id
            ?? _duplicateFxpBackendSourceId;
    }

    private void CloseDuplicateFxpBackendSite()
    {
        _duplicateFxpBackendSource = null;
        _duplicateFxpBackendName = "";
        _duplicateFxpBackendSourceId = "";
        _duplicateFxpBackendTargetId = "";
        _duplicateFxpBackends.Clear();
    }

    private async Task ConfirmDuplicateFxpBackendSite()
    {
        if (_duplicateFxpBackendSource is null)
            return;

        var sourceServer = _duplicateFxpBackends.FirstOrDefault(s => string.Equals(s.Id, _duplicateFxpBackendSourceId, StringComparison.OrdinalIgnoreCase));
        var targetServer = _duplicateFxpBackends.FirstOrDefault(s => string.Equals(s.Id, _duplicateFxpBackendTargetId, StringComparison.OrdinalIgnoreCase));
        if (sourceServer is null)
        {
            _error = "Select the source FXP backend first.";
            return;
        }
        if (targetServer is null)
        {
            _error = "Select the target FXP backend first.";
            return;
        }

        try
        {
            _duplicating = true;
            _error = null;
            _siteTestResult = null;
            await FxpBackendSites.CopySiteAsync(sourceServer, targetServer, _duplicateFxpBackendSource, _duplicateFxpBackendName);
            _siteTestResult = new SiteConnectionTestResult(
                true,
                $"Copied FXP backend site '{_duplicateFxpBackendSource}' from {DisplayFxpBackend(sourceServer)} to {DisplayFxpBackend(targetServer)} as '{_duplicateFxpBackendName.Trim()}'.",
                new[] { "Keep the RaceTrade site name and FXP backend site name identical, or update the RaceTrade site mapping/name after copying." });
            CloseDuplicateFxpBackendSite();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _duplicating = false;
        }
    }

    private async Task TestSite(string name)
    {
        try
        {
            _error = null;
            _siteTestResult = null;
            _busySite = name;
            _busyAction = "test";
            _siteTestResult = await SiteTester.ValidateAsync(name);
        }
        catch (Exception ex)
        {
            _siteTestResult = SiteConnectionTestResult.Fail($"Could not test '{name}'.", new[] { ex.Message });
        }
        finally
        {
            _busySite = null;
            _busyAction = null;
        }
    }

    private async Task LoginSite(string name)
    {
        try
        {
            _error = null;
            _siteTestResult = null;
            _busySite = name;
            _busyAction = "login";
            _siteTestResult = await SiteTester.LoginAsync(name);
        }
        catch (Exception ex)
        {
            _siteTestResult = SiteConnectionTestResult.Fail($"Could not test login for '{name}'.", new[] { ex.Message });
        }
        finally
        {
            _busySite = null;
            _busyAction = null;
        }
    }

    private string ActionText(string site, string action, string fallback) =>
        string.Equals(_busySite, site, StringComparison.OrdinalIgnoreCase)
        && string.Equals(_busyAction, action, StringComparison.OrdinalIgnoreCase)
            ? "Testing..."
            : fallback;

    private static string DisplayEmpty(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "legacy" : value.Trim();

    private void ToggleDisabled(string name)
    {
        try
        {
            var cfg = Store.Load(name);
            cfg.SiteSettings.DisableSite = !cfg.SiteSettings.DisableSite;
            Store.Save(cfg, name);
            Reload();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void ToggleIrcSource(string name)
    {
        try
        {
            var cfg = Store.Load(name);
            cfg.SiteSettings ??= new SiteSettings();
            var isEnabled = cfg.SiteSettings.IrcAnnounceEnabled != false;
            cfg.SiteSettings.IrcAnnounceEnabled = !isEnabled;
            Store.Save(cfg, name);
            Reload();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private string SuggestLocalCopyName(string source)
    {
        var names = Store.ListNames();
        return SuggestCopyName(source, candidate => names.Contains(candidate, StringComparer.OrdinalIgnoreCase));
    }

    private static string SuggestFxpBackendCopyName(string source) => $"{source}-copy";

    private static string SuggestCopyName(string source, Func<string, bool> exists)
    {
        var baseName = $"{source}-copy";
        if (!exists(baseName))
            return baseName;

        for (var i = 2; i < 1000; i++)
        {
            var candidate = $"{baseName}-{i}";
            if (!exists(candidate))
                return candidate;
        }

        return $"{baseName}-{DateTime.Now:HHmmss}";
    }

    private static string DisplayFxpBackend(FxpBackend server) =>
        $"{server.Name ?? server.Id} - {server.Host}:{server.Port}";

    private static FxpBackend? ResolveFxpBackend(IReadOnlyList<FxpBackend> servers, string? serverId)
    {
        if (string.IsNullOrWhiteSpace(serverId))
            return null;

        var trimmed = serverId.Trim();
        return servers.FirstOrDefault(s =>
            string.Equals(s.Id, trimmed, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(s.Name, trimmed, StringComparison.OrdinalIgnoreCase));
    }
}
