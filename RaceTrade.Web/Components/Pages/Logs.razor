@page "/logs"
@implements IDisposable
@inject UiLogSink Sink

<PageTitle>Logs - RaceTrade</PageTitle>

<div class="page-head">
    <h1><Icon Name="logs" Size="18" />Logs</h1>
</div>

@* The WinForms build had separate docked log windows (App / IRC / Race / Cbftp).
   Here it is one stream with a channel filter, which keeps a single scrollback and
   lets you correlate an announce with the race it triggered. *@
<div class="panel fill-panel">
    <div class="toolbar">
        <select @bind="_channel" @bind:after="FilterChanged">
            <option value="">All channels</option>
            @foreach (var c in Enum.GetValues<LogChannel>())
            {
                <option value="@c">@c</option>
            }
        </select>

        <select @bind="_minLevel" @bind:after="FilterChanged">
            <option value="">All levels</option>
            @foreach (var l in Enum.GetValues<LogLevel>())
            {
                <option value="@l">@l and up</option>
            }
        </select>

        <label class="chk"><input type="checkbox" @bind="_follow" /> Live</label>

        <span class="spacer"></span>
        <select class="page-size" @bind="_pageSize" @bind:after="PageSizeChanged">
            <option value="25">25 lines</option>
            <option value="50">50 lines</option>
            <option value="100">100 lines</option>
            <option value="200">200 lines</option>
        </select>
        <div class="pager">
            <button type="button" class="btn sm" @onclick="NewestPage" disabled="@(_page <= 1)">Newest</button>
            <button type="button" class="btn sm" @onclick="PreviousPage" disabled="@(_page <= 1)">Prev</button>
            <span class="hint">@PageLabel</span>
            <button type="button" class="btn sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            <button type="button" class="btn sm" @onclick="OldestPage" disabled="@(_page >= TotalPages)">Oldest</button>
        </div>
    </div>

    @if (_entries.Count == 0)
    {
        <div class="empty">Nothing logged yet.</div>
    }
    else
    {
        <table class="grid logs log-table">
            <thead>
                <tr>
                    <th class="ts">Time</th>
                    <th class="ch">Type</th>
                    <th class="site">Site</th>
                    <th class="ircchan">Channel</th>
                    <th class="race-status">Status</th>
                    <th class="section">Section</th>
                    <th class="rel">Release</th>
                    <th class="targets">Sites</th>
                    <th class="msg">Message</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in PagedEntries)
                {
                    <tr class="lvl-@e.Level.ToString().ToLowerInvariant()">
                        <td class="ts">@e.Timestamp.ToString("HH:mm:ss")</td>
                        <td class="ch">@e.Channel</td>
                        <td class="site">@((MarkupString)FormatSite(e.Site))</td>
                        <td class="ircchan">@e.Source</td>
                        <td class="race-status @StatusClass(e.Status)">@e.Status</td>
                        <td class="section">@((MarkupString)FormatSection(e.Section))</td>
                        <td class="rel">@((MarkupString)FormatRelease(e.Release))</td>
                        <td class="targets">@((MarkupString)FormatSites(e.TargetSite, e.Reason))</td>
                        <td class="msg">@((MarkupString)FormatMessage(e))</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="table-footer">
            <span class="hint">@PageLabel</span>
            <div class="pager">
                <button type="button" class="btn sm" @onclick="NewestPage" disabled="@(_page <= 1)">Newest</button>
                <button type="button" class="btn sm" @onclick="PreviousPage" disabled="@(_page <= 1)">Prev</button>
                <button type="button" class="btn sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                <button type="button" class="btn sm" @onclick="OldestPage" disabled="@(_page >= TotalPages)">Oldest</button>
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<LogEvent> _entries = Array.Empty<LogEvent>();
    private string _channel = "";
    private string _minLevel = "";
    private bool _follow = true;
    private int _page = 1;
    private int _pageSize = 50;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_entries.Count / (double)_pageSize));
    private IEnumerable<LogEvent> PagedEntries => _entries.Skip((_page - 1) * _pageSize).Take(_pageSize);

    private string PageLabel
    {
        get
        {
            if (_entries.Count == 0) return "0 shown";

            var first = ((_page - 1) * _pageSize) + 1;
            var last = Math.Min(_entries.Count, _page * _pageSize);
            return $"{first}-{last} of {_entries.Count}";
        }
    }

    protected override void OnInitialized()
    {
        Sink.Changed += OnSinkChanged;
        Refresh();
    }

    private void OnSinkChanged()
    {
        if (!_follow) return;

        // Changed fires on the sink's timer thread; hop to the circuit before touching
        // component state.
        InvokeAsync(() => { Refresh(); StateHasChanged(); });
    }

    private void Refresh()
    {
        LogChannel? ch = string.IsNullOrEmpty(_channel) ? null : Enum.Parse<LogChannel>(_channel);
        LogLevel? lvl = string.IsNullOrEmpty(_minLevel) ? null : Enum.Parse<LogLevel>(_minLevel);
        _entries = Sink.Snapshot(1000, ch, lvl);
        ClampPage();
    }

    private void FilterChanged()
    {
        _page = 1;
        Refresh();
    }

    private void PageSizeChanged()
    {
        _page = 1;
        Refresh();
    }

    private void NewestPage()
    {
        _page = 1;
        Refresh();
    }

    private void PreviousPage()
    {
        _follow = false;
        _page = Math.Max(1, _page - 1);
        Refresh();
    }

    private void NextPage()
    {
        _follow = false;
        _page = Math.Min(TotalPages, _page + 1);
        Refresh();
    }

    private void OldestPage()
    {
        _follow = false;
        _page = TotalPages;
        Refresh();
    }

    private void ClampPage()
    {
        if (_page < 1) _page = 1;
        if (_page > TotalPages) _page = TotalPages;
    }

    private static string FormatSite(string? site) =>
        IrcMarkup.ToHtml(LogColors.Magenta(site ?? ""));

    private static string FormatSection(string? section) =>
        IrcMarkup.ToHtml(LogColors.Green(section ?? ""));

    private static string FormatRelease(string? release) =>
        IrcMarkup.ToHtml(LogColors.Orange(release ?? ""));

    private static string FormatSites(string? sites, string? reason)
    {
        var text = IrcMarkup.ToHtml(LogColors.Magenta(sites ?? ""));
        if (!string.IsNullOrWhiteSpace(reason))
            text += $" <span class=\"log-reason\">({IrcMarkup.ToHtml(LogColors.Red(reason))})</span>";

        return text;
    }

    private static string FormatMessage(LogEvent e)
    {
        if (e.Channel == LogChannel.Race)
            return "";

        return IrcMarkup.ToHtml(e.Message);
    }

    private static string StatusClass(string? status) =>
        string.IsNullOrWhiteSpace(status)
            ? ""
            : "race-" + status.ToLowerInvariant();

    public void Dispose() => Sink.Changed -= OnSinkChanged;
}
