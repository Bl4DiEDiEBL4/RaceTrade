@page "/pre"
@using PreCbftpServer = RaceTrade.Web.Services.PreCbftpServer
@using PreSiteConfig = RaceTrade.Web.Services.PreSiteConfig
@inject PreSpreadService PreSpread

<PageTitle>Pre - RaceTrade</PageTitle>

@* Laid out as the job actually runs: pick a source, load its releases, choose where it
   goes, then act. The old two-panel version put configuration and work side by side,
   which hid the fact that it is a sequence. *@
<div class="page-head">
    <h1><Icon Name="flag" Size="18" />Pre</h1>
    <div class="head-actions">
        <button class="btn primary" @onclick="SaveConfig" disabled="@Busy">
            <Icon Name="save" Size="13" /><span>Save config</span>
        </button>
    </div>
</div>

<div class="pre-grid">

    <!-- ======================= 1. SITES ======================= -->
    <section class="panel pre-panel pre-sites-panel">
        <div class="pre-panel-head">
            <span class="step">1</span>
            <h2>PRE SITES</h2>
            <span class="spacer"></span>
            <button class="btn sm" @onclick="ImportServers" disabled="@Busy" title="Copy the cbftp servers from the CBFTP servers page">
                <Icon Name="download" Size="12" /><span>Import servers</span>
            </button>
            <button class="btn sm" @onclick="FetchSites" disabled="@(!_servers.Any() || Busy)" title="Ask each cbftp instance which sites it knows">
                <Icon Name="refresh" Size="12" /><span>Fetch sites</span>
            </button>
        </div>

        @if (_servers.Count == 0)
        {
            <div class="callout warn-callout">
                No cbftp servers yet. Press <strong>Import servers</strong> to copy them
                from the CBFTP servers page.
            </div>
        }
        else
        {
            <div class="pre-servers">
                @foreach (var server in _servers)
                {
                    var count = _sites.Count(s => string.Equals(s.CbftpServerId, server.Id, StringComparison.OrdinalIgnoreCase));

                    <div class="pre-server">
                        <span class="pre-server-name">@server.Name</span>
                        <span class="pre-server-host">@server.Host:@server.Port</span>
                        <span class="pre-server-count">@count site(s)</span>
                        <button class="btn danger sm"
                                title="Remove this server and the Pre sites that use it"
                                @onclick="() => RemoveServer(server)"
                                disabled="@Busy">
                            <Icon Name="trash" Size="12" />
                        </button>
                    </div>
                }
            </div>
        }

        <div class="pre-sites-editor">
            <div class="pre-sites-list-col">
        <div class="pre-site-table">
            @if (_sites.Count == 0)
            {
                <div class="empty compact">No Pre sites. Press <strong>Fetch sites</strong>.</div>
            }
            else
            {
                @foreach (var site in _sites)
                {
                    var broken = ServerFor(site) is null;

                    <div class="pre-site @(_selectedSite == site ? "active" : "") @(broken ? "broken" : "")"
                         @onclick="() => SelectSite(site)">

                        @* The pill IS the switch — that is what it looks like, so it
                           should behave like one. stopPropagation keeps it from also
                           selecting the row. *@
                        <button type="button"
                                class="mini-pill @(site.Enabled ? "on" : "off")"
                                title="@(site.Enabled ? "Click to disable this site" : "Click to enable this site")"
                                @onclick="() => ToggleEnabled(site)"
                                @onclick:stopPropagation="true">
                            @(site.Enabled ? "Enabled" : "Off")
                        </button>

                        <span class="pre-site-name">@site.Name</span>

                        <span class="pre-site-meta">
                            @site.AffilDirectory
                            <em>@site.Section</em>
                        </span>

                        <span class="pre-site-server @(broken ? "err-text" : "")">
                            @(ServerFor(site)?.Name ?? "no server")
                        </span>
                    </div>
                }
            }
        </div>

            </div>

            <div class="pre-sites-form-col">
        @if (_selectedSite is not null)
        {
            <div class="subcard nested pre-editor">
                <div class="card-title">@(_selectedSite.Name ?? "site")</div>

                <div class="form-grid wide">
                    <label>Site name</label>
                    <div>
                        <input type="text" @bind="_selectedSite.Name" @bind:event="oninput" />
                        <div class="fh">Must match the site name inside cbftp exactly.</div>
                    </div>

                    <label>CBFTP server</label>
                    <div>
                        <select @bind="_selectedSite.CbftpServerId">
                            <option value="">- none -</option>
                            @foreach (var server in _servers)
                            {
                                <option value="@server.Id">@server.Name (@server.Host:@server.Port)</option>
                            }
                        </select>
                        <div class="fh">Which cbftp instance reaches this site.</div>
                    </div>

                    <label>Affil directory</label>
                    <div>
                        <input type="text" @bind="_selectedSite.AffilDirectory" @bind:event="oninput" placeholder="/pre" />
                        <div class="fh">Where the group drops releases before the pre, e.g. <code>/pre</code> or <code>/PRE/GROUP</code>.</div>
                    </div>

                    <label>PRE section</label>
                    <div>
                        <input type="text" @bind="_selectedSite.Section" @bind:event="oninput" placeholder="DEFAULT" />
                        <div class="fh">Section passed to <code>SITE PRE &lt;release&gt; &lt;section&gt;</code>.</div>
                    </div>
                </div>

                <div class="form-actions">
                    <button class="btn sm" @onclick="TestSelected" disabled="@Busy">
                        <Icon Name="check" Size="12" /><span>Test connection</span>
                    </button>
                    <button class="btn danger sm" @onclick="RemoveSelected" disabled="@Busy">
                        <Icon Name="trash" Size="12" /><span>Remove</span>
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="empty compact pre-editor-empty">Select a Pre site to edit it.</div>
        }
            </div>
        </div>
    </section>

    <!-- ======================= 2. RELEASE ======================= -->
    <section class="panel pre-panel pre-release-panel">
        <div class="pre-panel-head">
            <span class="step">2</span>
            <h2>PICK A RELEASE</h2>
            <span class="spacer"></span>
            <select class="src-select" @bind="_sourceSiteName" @bind:after="RefreshReleases" disabled="@(!EnabledSites.Any() || Busy)">
                @foreach (var site in EnabledSites)
                {
                    <option value="@site.Name">@site.Name</option>
                }
            </select>
            <button class="btn sm" @onclick="RefreshReleases" disabled="@(string.IsNullOrWhiteSpace(_sourceSiteName) || Busy)">
                <Icon Name="refresh" Size="12" /><span>Load</span>
            </button>
        </div>

        <div class="pre-release-list">
            @if (Busy && _releases.Count == 0)
            {
                <div class="empty compact">Loading...</div>
            }
            else if (_releases.Count == 0)
            {
                <div class="empty compact">
                    No releases loaded. Pick the source site above and press <strong>Load</strong>.
                </div>
            }
            else
            {
                @foreach (var release in _releases)
                {
                    <button type="button"
                            class="pre-release @(_selectedRelease == release ? "active" : "")"
                            @onclick="() => _selectedRelease = release">
                        @release
                    </button>
                }
            }
        </div>
    </section>

    <!-- ======================= 3. DESTINATIONS + ACTIONS ======================= -->
    <section class="panel pre-panel pre-spread-panel">
        <div class="pre-panel-head">
            <span class="step">3</span>
            <h2>SPREAD AND PRE</h2>
            <span class="spacer"></span>
            <button class="btn sm" @onclick="SelectAllDest" disabled="@Busy">All</button>
            <button class="btn sm" @onclick="() => _destSites.Clear()" disabled="@Busy">None</button>
        </div>

        @if (HasRelease)
        {
            <div class="pre-target">
                <span class="fh">Selected release</span>
                <strong>@_selectedRelease</strong>
            </div>
        }
        else
        {
            <div class="callout">Pick a release in step 2 first.</div>
        }

        <div class="check-chip-list pre-dest-list">
            @foreach (var site in EnabledSites)
            {
                var name = site.Name ?? "";
                var isSource = string.Equals(name, _sourceSiteName, StringComparison.OrdinalIgnoreCase);
                var checkedDest = _destSites.Contains(name);

                <label class="check-chip @(checkedDest ? "checked" : "") @(isSource ? "is-source" : "")"
                       title="@(isSource ? "This is the source site - it is skipped when distributing" : "")">
                    <input type="checkbox" checked="@checkedDest" @onchange="e => Toggle(_destSites, name, e.Value)" />
                    <span>@name</span>
                    @if (isSource)
                    {
                        <em>source</em>
                    }
                </label>
            }
        </div>

        <div class="fh">
            Distributing always skips the source site. With nothing ticked, every enabled
            Pre site is used.
        </div>

        <div class="pre-actions">
            <button class="btn primary" @onclick="Distribute" disabled="@(!HasRelease || Busy)">
                <Icon Name="fxp" Size="13" /><span>Distribute</span>
            </button>
            <button class="btn" @onclick="CheckCompletion" disabled="@(!HasRelease || Busy)">
                <Icon Name="check" Size="13" /><span>Check completion</span>
            </button>
            <button class="btn primary" @onclick="SendPre" disabled="@(!HasRelease || Busy)">
                <Icon Name="send" Size="13" /><span>SITE PRE</span>
            </button>
            <span class="spacer"></span>
            <button class="btn danger" @onclick="DeleteRelease" disabled="@(!HasRelease || Busy)">
                <Icon Name="trash" Size="13" /><span>Delete</span>
            </button>
        </div>
    </section>

    <!-- ======================= LOG ======================= -->
    <section class="panel pre-panel pre-log-panel">
        <div class="pre-panel-head">
            <h2>LOG</h2>
            <span class="spacer"></span>
            <button class="btn sm" @onclick="() => _log.Clear()">
                <Icon Name="trash" Size="12" /><span>Clear</span>
            </button>
        </div>
        <div class="log-box">
            @if (_log.Count == 0)
            {
                <div class="dim">No Pre activity yet.</div>
            }
            else
            {
                @foreach (var line in _log)
                {
                    <div>@line</div>
                }
            }
        </div>
    </section>
</div>

@code {
    private List<PreCbftpServer> _servers = new();
    private List<PreSiteConfig> _sites = new();
    private PreSiteConfig? _selectedSite;
    private string _sourceSiteName = "";
    private List<string> _releases = new();
    private string _selectedRelease = "";
    private readonly HashSet<string> _destSites = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<string> _log = new();
    private bool Busy { get; set; }

    private IEnumerable<PreSiteConfig> EnabledSites =>
        _sites.Where(s => s.Enabled && !string.IsNullOrWhiteSpace(s.Name))
            .OrderBy(s => s.Name, StringComparer.OrdinalIgnoreCase);

    private bool HasRelease => !string.IsNullOrWhiteSpace(_selectedRelease);

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        _servers = PreSpread.LoadServers();
        _sites = PreSpread.LoadSites(_servers);
        _selectedSite = _sites.FirstOrDefault();
        _sourceSiteName = EnabledSites.FirstOrDefault()?.Name ?? "";
        ResetDestinations();
    }

    /// <summary>Everything except the source: distributing to yourself is a no-op.</summary>
    private void ResetDestinations()
    {
        _destSites.Clear();

        foreach (var site in EnabledSites)
        {
            if (!string.Equals(site.Name, _sourceSiteName, StringComparison.OrdinalIgnoreCase))
                _destSites.Add(site.Name ?? "");
        }
    }

    private void SelectAllDest()
    {
        _destSites.Clear();
        foreach (var site in EnabledSites)
            _destSites.Add(site.Name ?? "");
    }

    private void SelectSite(PreSiteConfig site) => _selectedSite = site;

    private PreCbftpServer? ServerFor(PreSiteConfig site) =>
        _servers.FirstOrDefault(s => string.Equals(s.Id, site.CbftpServerId, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Flips the pill and persists immediately — a toggle that needs a separate Save is
    /// a toggle people forget to save.
    /// </summary>
    private void ToggleEnabled(PreSiteConfig site)
    {
        site.Enabled = !site.Enabled;
        PreSpread.SaveSites(_sites);

        // The source may have just been switched off.
        if (!EnabledSites.Any(s => string.Equals(s.Name, _sourceSiteName, StringComparison.OrdinalIgnoreCase)))
            _sourceSiteName = EnabledSites.FirstOrDefault()?.Name ?? "";

        AddLog($"{site.Name} {(site.Enabled ? "enabled" : "disabled")}.");
    }

    private void RemoveSelected()
    {
        if (_selectedSite is null) return;

        _sites.Remove(_selectedSite);
        PreSpread.SaveSites(_sites);
        AddLog($"Removed {_selectedSite.Name}.");
        _selectedSite = _sites.FirstOrDefault();
    }

    private async Task TestSelected() => await RunAsync(async () =>
    {
        if (_selectedSite is null) return;

        var result = await PreSpread.TestSiteAsync(_selectedSite, _servers);
        AddLog(result);
    });

    private void ImportServers()
    {
        try
        {
            _servers = PreSpread.ImportServersFromMainConfig(save: true);
            _sites = PreSpread.LoadSites(_servers);

            // LoadSites deserialises fresh objects, so the old reference is no longer in
            // the list. Rebind by identity or the editor edits a detached object and the
            // changes are silently lost on save.
            RebindSelection();

            AddLog($"{_servers.Count} cbftp server(s) available.");
        }
        catch (Exception ex)
        {
            AddLog(ex.Message, isError: true);
        }
    }

    private void RemoveServer(PreCbftpServer server)
    {
        try
        {
            var result = PreSpread.RemoveServer(server.Id ?? "", _servers, _sites);
            AddLog(result);

            RebindSelection();
            _sourceSiteName = EnabledSites.FirstOrDefault()?.Name ?? "";
            ResetDestinations();
        }
        catch (Exception ex)
        {
            AddLog(ex.Message, isError: true);
        }
    }

    /// <summary>
    /// Re-points _selectedSite after _sites has been reloaded. PreSiteConfig is a plain
    /// class with no value equality, so a reference from the previous list can never be
    /// found in the new one — match on (name, server) instead.
    /// </summary>
    private void RebindSelection()
    {
        var name = _selectedSite?.Name;
        var serverId = _selectedSite?.CbftpServerId;

        _selectedSite = _sites.FirstOrDefault(s =>
                            string.Equals(s.Name, name, StringComparison.OrdinalIgnoreCase) &&
                            string.Equals(s.CbftpServerId, serverId, StringComparison.OrdinalIgnoreCase))
                        ?? _sites.FirstOrDefault();
    }

    private async Task FetchSites() => await RunAsync(async () =>
    {
        var result = await PreSpread.FetchAllSitesAsync(_servers, _sites);
        AddLog(result);

        _sites = PreSpread.LoadSites(_servers);
        RebindSelection();
        _sourceSiteName = EnabledSites.FirstOrDefault()?.Name ?? "";
        ResetDestinations();
    });

    private void SaveConfig()
    {
        try
        {
            PreSpread.SaveServers(_servers);
            PreSpread.SaveSites(_sites);
            AddLog("Pre configuration saved.");
        }
        catch (Exception ex)
        {
            AddLog(ex.Message, isError: true);
        }
    }

    private async Task RefreshReleases() => await RunAsync(async () =>
    {
        _releases.Clear();
        _selectedRelease = "";

        var source = SourceSite();
        if (source is null)
        {
            AddLog("Select a source site.", isError: true);
            return;
        }

        var server = ServerFor(source);
        if (server is null)
        {
            AddLog($"'{source.Name}' has no cbftp server bound. Select one under CBFTP server and press Save config.", isError: true);
            return;
        }

        _releases = (await PreSpread.ListReleasesAsync(server, source)).ToList();
        _selectedRelease = _releases.FirstOrDefault() ?? "";
        ResetDestinations();

        AddLog($"{_releases.Count} release(s) in {source.Name}:{source.AffilDirectory}.");
    });

    private async Task Distribute() => await RunAsync(async () =>
    {
        var source = SourceSite();
        if (source is null) return;

        var destinations = SelectedDestinations()
            .Where(s => !string.Equals(s.Name, source.Name, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (destinations.Count == 0)
        {
            AddLog("No destination sites selected.", isError: true);
            return;
        }

        var result = await PreSpread.DistributeAsync(_selectedRelease, source, destinations, _servers);
        AddLog(result);
    });

    private async Task CheckCompletion() => await RunAsync(async () =>
    {
        var source = SourceSite();
        if (source is null) return;

        var result = await PreSpread.CheckCompletionAsync(_selectedRelease, source, SelectedDestinations(), _servers);
        AddLog(result);
    });

    private async Task DeleteRelease() => await RunAsync(async () =>
    {
        // No empty-means-all fallback here. Distribute and Check both skip the source
        // site; Delete did not, so clearing the checkboxes and pressing Delete wiped the
        // release from the site it came from too.
        var targets = EnabledSites
            .Where(s => _destSites.Contains(s.Name ?? ""))
            .Where(s => !string.Equals(s.Name, _sourceSiteName, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (targets.Count == 0)
        {
            AddLog("Tick the sites to delete from. The source site is never included.", isError: true);
            return;
        }

        var result = await PreSpread.DeleteReleaseAsync(_selectedRelease, targets, _servers);
        AddLog(result);
    });

    private async Task SendPre() => await RunAsync(async () =>
    {
        var sites = _destSites.Count == 0 ? EnabledSites.ToList() : SelectedDestinations();
        var result = await PreSpread.SendPreAsync(_selectedRelease, sites, _servers);
        AddLog(result);
    });

    private List<PreSiteConfig> SelectedDestinations()
    {
        var selected = EnabledSites.Where(s => _destSites.Contains(s.Name ?? "")).ToList();
        return selected.Count == 0 ? EnabledSites.ToList() : selected;
    }

    private PreSiteConfig? SourceSite() =>
        EnabledSites.FirstOrDefault(s => string.Equals(s.Name, _sourceSiteName, StringComparison.OrdinalIgnoreCase));

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            Busy = true;
            await action();
        }
        catch (Exception ex)
        {
            AddLog(ex.Message, isError: true);
        }
        finally
        {
            Busy = false;
        }
    }

    private void AddLog(PreActionResult result)
    {
        AddLog(result.Message, isError: !result.Success);
        foreach (var line in result.Logs.Reverse())
            _log.Insert(1, "  " + line);

        if (_log.Count > 200)
            _log.RemoveRange(200, _log.Count - 200);
    }

    private void AddLog(string message, bool isError = false)
    {
        if (string.IsNullOrWhiteSpace(message)) return;

        _log.Insert(0, $"[{DateTime.Now:HH:mm:ss}] {(isError ? "ERROR: " : "")}{message}");

        if (_log.Count > 200)
            _log.RemoveRange(200, _log.Count - 200);
    }

    private static void Toggle(HashSet<string> set, string? value, object? raw)
    {
        if (string.IsNullOrWhiteSpace(value)) return;

        if (raw is bool b && b) set.Add(value);
        else set.Remove(value);
    }
}
