@implements IDisposable
@inject RaceTrade.Web.Services.RacerState Racer

@* Lives in its own component instead of directly in MainLayout: a layout is rendered as
   part of the page and does NOT get an interactive render mode of its own, so an
   @onclick placed there is never wired up and the button silently does nothing. *@
<div class="status-card">
    <div class="status-title">TRADER STATUS</div>

    <div class="status-row">
        <span class="dot @(Racer.IsRunning ? "on" : "")"></span>
        <span class="status-text">
            @(Racer.IsBusy ? "Working..." : Racer.IsRunning ? "Running" : "Stopped")
        </span>
        @if (Racer.IsRunning)
        {
            <span class="run-spinner" aria-label="Trader running"></span>
        }
    </div>

    @if (Racer.IsRunning && Racer.ConnectedSites.Count > 0)
    {
        <div class="status-sites">@ConnectedSourcesLabel</div>
        <div class="status-sites muted">@Racer.EnabledTargetSiteCount racing site(s) enabled</div>
    }

    <button class="btn-run @(Racer.IsRunning ? "stop" : "")"
            disabled="@Racer.IsBusy"
            @onclick="Toggle">
        <Icon Name="@(Racer.IsRunning ? "stop" : "play")" Size="13" />
        <span>@(Racer.IsBusy ? "..." : Racer.IsRunning ? "Stop" : "Start")</span>
    </button>
</div>

@code {
    private CancellationTokenSource? _refreshCts;

    protected override void OnInitialized()
    {
        Racer.Changed += OnChanged;
        _refreshCts = new CancellationTokenSource();
        _ = RefreshWhileRunningAsync(_refreshCts.Token);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private string ConnectedSourcesLabel
    {
        get
        {
            var parts = new List<string>();
            if (Racer.ConnectedPrespamBotCount > 0)
                parts.Add(FormatCount(Racer.ConnectedPrespamBotCount, "Prespam Bot"));
            if (Racer.ConnectedSiteBotCount > 0)
                parts.Add(FormatCount(Racer.ConnectedSiteBotCount, "sitebot"));

            return parts.Count == 0
                ? "No IRC sources connected"
                : $"{string.Join(" + ", parts)} connected";
        }
    }

    private static string FormatCount(int count, string label) =>
        count == 1 ? $"1 {label}" : $"{count} {label}s";

    private async Task RefreshWhileRunningAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), token);
                if (Racer.IsRunning || Racer.IsBusy)
                    await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Normal when the component is disposed.
        }
    }

    private Task Toggle() => Racer.ToggleAsync();

    public void Dispose()
    {
        Racer.Changed -= OnChanged;
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
    }
}
