@inject ThemeService Theme

<!DOCTYPE html>
<html lang="en" data-bs-theme="@Theme.CurrentTheme" data-theme="@Theme.CurrentTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RaceTrade</title>
    <base href="/" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <link rel="icon" type="image/png" sizes="192x192" href="icon-192.png" />
    <link rel="apple-touch-icon" href="icon-192.png" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    @* Global interactivity: every component, including the layout, runs over the
       SignalR circuit. With per-component render modes it is easy to end up with a
       button whose @@onclick is never wired up (a layout, for instance, never gets a
       render mode of its own) and which then silently does nothing. *@
    <Routes @rendermode="InteractiveServer" />
    <script>
        window.raceTradeTheme = {
            set: function (theme) {
                const next = theme === 'light' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                document.documentElement.setAttribute('data-bs-theme', next);
            }
        };

        document.addEventListener('click', function (event) {
            const link = event.target.closest('.sidebar-scroll a.nav-item');
            if (!link) return;

            const toggle = document.getElementById('mobile-menu-toggle');
            if (toggle) toggle.checked = false;
        });
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
