@inject UpdateService Updates
@implements IDisposable

@if (_result?.IsAvailable == true)
{
    <a class="update-notice"
       href="@_result.ReleaseUrl"
       target="_blank"
       rel="noopener noreferrer"
       title="Open the latest RaceTrade release">
        <Icon Name="download" Size="13" />
        <span>Update v@_result.LatestVersion</span>
    </a>
}

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromMinutes(30);

    private UpdateCheckResult? _result;
    private CancellationTokenSource? _pollCts;

    protected override void OnInitialized()
    {
        Updates.Changed += OnChanged;
        _pollCts = new CancellationTokenSource();
        _ = Refresh();
        _ = PollForUpdates(_pollCts.Token);
    }

    private void OnChanged() => _ = Refresh(force: true);

    private async Task PollForUpdates(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(PollInterval, cancellationToken);
                await Refresh(force: true, cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task Refresh(bool force = false, CancellationToken cancellationToken = default)
    {
        var result = await Updates.CheckAsync(force, cancellationToken);
        if (cancellationToken.IsCancellationRequested)
            return;

        await InvokeAsync(() =>
        {
            _result = result;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Updates.Changed -= OnChanged;
        _pollCts?.Cancel();
        _pollCts?.Dispose();
    }
}
